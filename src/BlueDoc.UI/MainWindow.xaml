<Window x:Class="BlueDoc.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:BlueDoc.UI.ViewModels"
        xmlns:views="clr-namespace:BlueDoc.UI.Views"
        mc:Ignorable="d"
        Title="BlueDoc — Hardware Diagnostic &amp; Bluetooth Doctor" 
        Icon="BlueDoc.ico"
        Height="820" Width="1366"
        MinHeight="680" MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        Background="{DynamicResource MainBgBrush}"
        FontFamily="SF Pro Display, SF Pro Text, Segoe UI Variable, Segoe UI, sans-serif"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.InputBindings>
        <KeyBinding Key="D" Modifiers="Control" Command="{Binding QuickDiagnosisCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <!-- Functional Subsystem DataTemplates (All 19 Modules) -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BluetoothMainViewModel}">
            <views:BluetoothMainView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HardwareInspectorViewModel}">
            <views:HardwareInspectorView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DiagnosticCenterViewModel}">
            <views:DiagnosticCenterView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CompatibilityViewModel}">
            <views:CompatibilityView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BluetoothDevicesViewModel}">
            <views:BluetoothDevicesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DeviceScannerViewModel}">
            <views:DeviceScannerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BluetoothEventAnalyzerViewModel}">
            <views:BluetoothEventAnalyzerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DriverAssistantViewModel}">
            <views:DriverAssistantView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SafeRepairCenterViewModel}">
            <views:SafeRepairCenterView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DiagnosticReportViewModel}">
            <views:DiagnosticReportView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ConnectionHistoryViewModel}">
            <views:ConnectionHistoryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SignalMonitorViewModel}">
            <views:SignalMonitorView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BleExplorerViewModel}">
            <views:BleExplorerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TechnicianToolkitViewModel}">
            <views:TechnicianToolkitView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AudioDiagnosticsViewModel}">
            <views:AudioDiagnosticsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SaasFleetDashboardViewModel}">
            <views:SaasFleetDashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FixMyConnectionWizardViewModel}">
            <views:FixMyConnectionWizardView />
        </DataTemplate>
    </Window.Resources>

    <!-- macOS Sonoma 2-Column System Settings Layout -->
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Column 0: macOS Sonoma Sidebar (Fixed Width 260px) -->
            <ColumnDefinition Width="260" />
            <!-- Column 1: Main Content Area -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- =========================================================================
             1. MAC OS SONOMA SIDEBAR (Width="260", Pastel/Graphite Gradient, 11px Headers)
             ========================================================================= -->
        <Border Grid.Column="0"
                Background="{DynamicResource SidebarGradientBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="0,0,1,0"
                SnapsToDevicePixels="True">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Row 0: Search & Brand Header -->
                    <RowDefinition Height="Auto" />
                    <!-- Row 1: Grouped Sidebar Navigation List -->
                    <RowDefinition Height="*" />
                    <!-- Row 2: Sidebar Footer -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Search Box & Brand Header -->
                <Border Grid.Row="0" Margin="14,14,14,8">
                    <StackPanel>
                        <!-- Brand Header -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            
                            <Border Grid.Column="0" 
                                    Width="36" Height="36" 
                                    CornerRadius="10" 
                                    Background="{DynamicResource AccentBrush}" 
                                    Margin="0,0,10,0">
                                <Path Data="{StaticResource IconBlePath}" 
                                      Width="18" Height="18" 
                                      Fill="White" 
                                      Stretch="Uniform" 
                                      HorizontalAlignment="Center" 
                                      VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="BlueDoc" 
                                               FontFamily="SF Pro Display, SF Pro Text, Segoe UI Variable, Segoe UI, sans-serif"
                                               FontSize="16.5" 
                                               FontWeight="SemiBold" 
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <Border Background="{DynamicResource AccentSubtleBrush}" 
                                            CornerRadius="4" 
                                            Padding="4,1" 
                                            Margin="6,0,0,0" 
                                            VerticalAlignment="Center">
                                        <TextBlock Text="v1.0" 
                                                   FontSize="9.5" 
                                                   FontWeight="SemiBold" 
                                                   Foreground="{DynamicResource AccentBrush}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="System Settings" 
                                           FontFamily="SF Pro Display, SF Pro Text, Segoe UI Variable, Segoe UI, sans-serif"
                                           FontSize="11" 
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Grid>

                        <!-- macOS Search Box (CornerRadius=8, 40% Background Opacity) -->
                        <TextBox Style="{StaticResource MacOsSearchTextBox}" />
                    </StackPanel>
                </Border>

                <!-- PRD Section 9 Exact Navigation ListBox -->
                <ListBox x:Name="SidebarNavList"
                         Grid.Row="1"
                         Style="{StaticResource MacOsSidebarListBoxStyle}"
                         SelectionChanged="SidebarNavList_SelectionChanged"
                         SelectionMode="Single"
                         Padding="6,4">

                    <!-- ==========================================
                         OVERVIEW (PRD Section 9)
                         ========================================== -->
                    <ListBoxItem IsEnabled="False" Focusable="False" Cursor="Arrow" Padding="12,10,12,2" Margin="0">
                        <TextBlock Text="OVERVIEW" Style="{StaticResource MacOsGroupHeaderStyle}" Margin="0" />
                    </ListBoxItem>

                    <ListBoxItem Tag="Dashboard"
                                 IsSelected="{Binding ActiveSection, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter='Dashboard'}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Data="{StaticResource IconDashboardPath}" Width="14" Height="14" Fill="{DynamicResource TextSecondaryBrush}" Stretch="Uniform" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Dashboard" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                    </ListBoxItem>

                    <ListBoxItem Tag="Bluetooth Devices"
                                 IsSelected="{Binding ActiveSection, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter='Bluetooth Devices'}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Data="{StaticResource IconDevicesPath}" Width="14" Height="14" Fill="{DynamicResource TextSecondaryBrush}" Stretch="Uniform" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Bluetooth Devices" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                    </ListBoxItem>

                    <ListBoxItem Tag="Device Scanner"
                                 IsSelected="{Binding ActiveSection, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter='Device Scanner'}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Data="{StaticResource IconScannerPath}" Width="14" Height="14" Fill="{DynamicResource TextSecondaryBrush}" Stretch="Uniform" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Device Scanner" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                    </ListBoxItem>

                    <!-- ==========================================
                         DIAGNOSTICS (PRD Section 9)
                         ========================================== -->
                    <ListBoxItem IsEnabled="False" Focusable="False" Cursor="Arrow" Padding="12,14,12,2" Margin="0">
                        <TextBlock Text="DIAGNOSTICS" Style="{StaticResource MacOsGroupHeaderStyle}" Margin="0" />
                    </ListBoxItem>

                    <ListBoxItem Tag="Diagnostics"
                                 IsSelected="{Binding ActiveSection, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter='Diagnostics'}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Data="{StaticResource IconDiagnosticPath}" Width="14" Height="14" Fill="{DynamicResource TextSecondaryBrush}" Stretch="Uniform" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Diagnostics" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                    </ListBoxItem>

                    <ListBoxItem Tag="Driver Assistant"
                                 IsSelected="{Binding ActiveSection, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter='Driver Assistant'}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Data="{StaticResource IconDriverPath}" Width="14" Height="14" Fill="{DynamicResource TextSecondaryBrush}" Stretch="Uniform" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Driver Assistant" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                    </ListBoxItem>

                    <ListBoxItem Tag="Event Analyzer"
                                 IsSelected="{Binding ActiveSection, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter='Event Analyzer'}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Data="{StaticResource IconEventsPath}" Width="14" Height="14" Fill="{DynamicResource TextSecondaryBrush}" Stretch="Uniform" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Event Analyzer" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                    </ListBoxItem>

                    <!-- ==========================================
                         TOOLS (PRD Section 9)
                         ========================================== -->
                    <ListBoxItem IsEnabled="False" Focusable="False" Cursor="Arrow" Padding="12,14,12,2" Margin="0">
                        <TextBlock Text="TOOLS" Style="{StaticResource MacOsGroupHeaderStyle}" Margin="0" />
                    </ListBoxItem>

                    <ListBoxItem Tag="Repair Center"
                                 IsSelected="{Binding ActiveSection, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter='Repair Center'}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Data="{StaticResource IconRepairPath}" Width="14" Height="14" Fill="{DynamicResource TextSecondaryBrush}" Stretch="Uniform" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Repair Center" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                    </ListBoxItem>

                    <ListBoxItem Tag="Connection History"
                                 IsSelected="{Binding ActiveSection, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter='Connection History'}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Data="{StaticResource IconHistoryPath}" Width="14" Height="14" Fill="{DynamicResource TextSecondaryBrush}" Stretch="Uniform" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Connection History" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                    </ListBoxItem>

                    <ListBoxItem Tag="Reports"
                                 IsSelected="{Binding ActiveSection, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter='Reports'}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Data="{StaticResource IconReportPath}" Width="14" Height="14" Fill="{DynamicResource TextSecondaryBrush}" Stretch="Uniform" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Reports" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                    </ListBoxItem>

                    <ListBoxItem Tag="SaaS Fleet Portal"
                                 IsSelected="{Binding ActiveSection, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter='SaaS Fleet Portal'}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Data="{StaticResource IconCloudPath}" Width="14" Height="14" Fill="{DynamicResource TextSecondaryBrush}" Stretch="Uniform" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="SaaS Fleet Portal" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                    </ListBoxItem>

                    <!-- ==========================================
                         SYSTEM (PRD Section 9)
                         ========================================== -->
                    <ListBoxItem IsEnabled="False" Focusable="False" Cursor="Arrow" Padding="12,14,12,2" Margin="0">
                        <TextBlock Text="SYSTEM" Style="{StaticResource MacOsGroupHeaderStyle}" Margin="0" />
                    </ListBoxItem>

                    <ListBoxItem Tag="Settings"
                                 IsSelected="{Binding ActiveSection, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter='Settings'}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Data="{StaticResource IconSettingsPath}" Width="14" Height="14" Fill="{DynamicResource TextSecondaryBrush}" Stretch="Uniform" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Settings" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                    </ListBoxItem>

                </ListBox>

                <!-- Sidebar Footer -->
                <Border Grid.Row="2" 
                        Padding="14,10" 
                        BorderBrush="{DynamicResource CardBorderBrush}" 
                        BorderThickness="0,1,0,0">
                    <StackPanel>
                        <TextBlock Text="BlueDoc • macOS Sonoma Style" 
                                   FontFamily="SF Pro Display, SF Pro Text, Segoe UI Variable, Segoe UI, sans-serif"
                                   FontSize="11" 
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="Universal Hardware Diagnostics" 
                                   FontFamily="SF Pro Display, SF Pro Text, Segoe UI Variable, Segoe UI, sans-serif"
                                   FontSize="10" 
                                   Foreground="{DynamicResource TextMutedBrush}" 
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- =========================================================================
             2. MAIN CONTENT AREA (Column 1)
             ========================================================================= -->
        <Grid Grid.Column="1" Background="{DynamicResource MainBgBrush}">
            <Grid.RowDefinitions>
                <!-- Row 0: macOS Top Bar Area (Height="56") -->
                <RowDefinition Height="56" />
                <!-- Row 1: Main View Canvas (Padding="32") -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top Bar Navigation & Controls -->
            <Border Grid.Row="0" 
                    Background="{DynamicResource HeaderBgBrush}" 
                    BorderBrush="{DynamicResource CardBorderBrush}" 
                    BorderThickness="0,0,0,1" 
                    Padding="24,0"
                    SnapsToDevicePixels="True">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <!-- Left: Breadcrumb / Page Title -->
                        <ColumnDefinition Width="*" />
                        <!-- Right: macOS Toggle Switches & Actions -->
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Breadcrumbs -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ActiveGroup}" 
                                   FontFamily="SF Pro Display, SF Pro Text, Segoe UI Variable, Segoe UI, sans-serif"
                                   FontSize="12" 
                                   FontWeight="SemiBold" 
                                   Foreground="{DynamicResource TextSecondaryBrush}" 
                                   VerticalAlignment="Center" />
                        <TextBlock Text=" / " 
                                   FontSize="12" 
                                   Foreground="{DynamicResource TextMutedBrush}" 
                                   VerticalAlignment="Center" 
                                   Margin="6,0" />
                        <TextBlock Text="{Binding ActiveSection}" 
                                   FontFamily="SF Pro Display, SF Pro Text, Segoe UI Variable, Segoe UI, sans-serif"
                                   FontSize="18" 
                                   FontWeight="SemiBold" 
                                   Foreground="{DynamicResource TextPrimaryBrush}" 
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Right Action Controls -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        
                        <!-- macOS Bluetooth Radio Toggle Switch -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="{Binding RadioStateDisplay}" 
                                       FontFamily="SF Pro Display, SF Pro Text, Segoe UI Variable, Segoe UI, sans-serif"
                                       FontSize="12" 
                                       FontWeight="Medium" 
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0" />
                            <ToggleButton Style="{StaticResource MacOSToggleSwitch}"
                                          IsChecked="{Binding IsRadioOn, Mode=TwoWay}"
                                          Command="{Binding ToggleRadioPowerCommand}"
                                          ToolTip="Toggle Bluetooth Radio Power" />
                        </StackPanel>

                        <!-- macOS Light / Dark Theme Switch -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="Dark Mode" 
                                       FontFamily="SF Pro Display, SF Pro Text, Segoe UI Variable, Segoe UI, sans-serif"
                                       FontSize="12" 
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0" />
                            <ToggleButton Style="{StaticResource MacOSToggleSwitch}"
                                          IsChecked="{Binding IsDarkTheme, Mode=TwoWay}"
                                          ToolTip="Switch between Light and Dark mode" />
                        </StackPanel>

                        <!-- Quick Diagnosis Primary Button -->
                        <Button Content="Quick Diagnosis"
                                Command="{Binding QuickDiagnosisCommand}"
                                Style="{StaticResource MacOsPrimaryButton}"
                                Height="30"
                                Padding="14,6" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Content Canvas (Padding="32", ContentControl Page Navigation) -->
            <Border Grid.Row="1" 
                    Padding="{StaticResource MacOsMainPadding}"
                    Background="{DynamicResource MainBgBrush}"
                    SnapsToDevicePixels="True">
                <ContentControl Content="{Binding CurrentViewModel}" 
                                Focusable="False" />
            </Border>
        </Grid>
    </Grid>
</Window>
