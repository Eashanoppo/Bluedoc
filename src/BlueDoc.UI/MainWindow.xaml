<Window x:Class="BlueDoc.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:BlueDoc.UI.ViewModels"
        xmlns:views="clr-namespace:BlueDoc.UI.Views"
        mc:Ignorable="d"
        Title="BlueDoc — Hardware Diagnostic &amp; Bluetooth Doctor" 
        Icon="BlueDoc.ico"
        Height="820" Width="1366"
        MinHeight="680" MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SurfaceCanvasBrush}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.InputBindings>
        <!-- Keyboard Navigation Shortcuts -->
        <KeyBinding Key="OemOpenBrackets" Modifiers="Control" Command="{Binding ToggleSidebarCommand}" />
        <KeyBinding Key="D" Modifiers="Control" Command="{Binding QuickDiagnosisCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <!-- Navigation View DataTemplates (All 17 Subsystems Cached in MainViewModel) -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BluetoothMainViewModel}">
            <views:BluetoothMainView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HardwareInspectorViewModel}">
            <views:HardwareInspectorView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DiagnosticCenterViewModel}">
            <views:DiagnosticCenterView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CompatibilityViewModel}">
            <views:CompatibilityView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BluetoothDevicesViewModel}">
            <views:BluetoothDevicesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DeviceScannerViewModel}">
            <views:DeviceScannerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BluetoothEventAnalyzerViewModel}">
            <views:BluetoothEventAnalyzerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DriverAssistantViewModel}">
            <views:DriverAssistantView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SafeRepairCenterViewModel}">
            <views:SafeRepairCenterView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DiagnosticReportViewModel}">
            <views:DiagnosticReportView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ConnectionHistoryViewModel}">
            <views:ConnectionHistoryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SignalMonitorViewModel}">
            <views:SignalMonitorView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BleExplorerViewModel}">
            <views:BleExplorerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TechnicianToolkitViewModel}">
            <views:TechnicianToolkitView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AudioDiagnosticsViewModel}">
            <views:AudioDiagnosticsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SaasFleetDashboardViewModel}">
            <views:SaasFleetDashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FixMyConnectionWizardViewModel}">
            <views:FixMyConnectionWizardView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Column 0: Collapsible Sidebar (Width bound to ViewModel) -->
            <ColumnDefinition Width="Auto" />
            <!-- Column 1: Main Application Canvas -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- =========================================================================
             1. COLLAPSIBLE SIDEBAR NAVIGATION COLUMN
             ========================================================================= -->
        <Border Grid.Column="0" 
                Width="{Binding SidebarWidth}"
                Background="{DynamicResource SurfaceSidebarBrush}" 
                BorderBrush="{DynamicResource BorderBrush}" 
                BorderThickness="0,0,1,0"
                SnapsToDevicePixels="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Brand Header & Collapse Toggle Button -->
                <Border Grid.Row="0" 
                        Padding="14,14,14,12" 
                        BorderBrush="{DynamicResource BorderBrush}" 
                        BorderThickness="0,0,0,1">
                    <Grid>
                        <!-- EXPANDED BRAND VIEW -->
                        <Grid Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- BlueDoc Brand Icon Badge -->
                            <Border Grid.Column="0" 
                                    Width="36" Height="36" 
                                    CornerRadius="9" 
                                    Background="{DynamicResource AccentBrush}" 
                                    Margin="0,0,10,0">
                                <Path Data="{StaticResource IconBlePath}" 
                                      Width="18" Height="18" 
                                      Fill="White" 
                                      Stretch="Uniform" 
                                      HorizontalAlignment="Center" 
                                      VerticalAlignment="Center" />
                            </Border>

                            <!-- Brand Identity Text -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="BlueDoc" 
                                               FontSize="17" 
                                               FontWeight="Bold" 
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <Border Background="{DynamicResource AccentSubtleBrush}" 
                                            CornerRadius="4" 
                                            Padding="4,1" 
                                            Margin="6,0,0,0" 
                                            VerticalAlignment="Center">
                                        <TextBlock Text="v1.0" 
                                                   FontSize="9.5" 
                                                   FontWeight="SemiBold" 
                                                   Foreground="{DynamicResource AccentBrush}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="by UNLEFT LLC" 
                                           FontSize="11" 
                                           Foreground="{DynamicResource TextMutedBrush}" />
                            </StackPanel>

                            <!-- Collapse Button (Chevron Left) -->
                            <Button Grid.Column="2" 
                                    Command="{Binding ToggleSidebarCommand}"
                                    ToolTip="{Binding SidebarToggleTooltip}"
                                    Style="{StaticResource IconButton}"
                                    Width="28" Height="28">
                                <Path Data="{StaticResource IconChevronLeftPath}" 
                                      Width="10" Height="10" 
                                      Fill="{DynamicResource TextSecondaryBrush}" 
                                      Stretch="Uniform" />
                            </Button>
                        </Grid>

                        <!-- COLLAPSED BRAND VIEW -->
                        <Grid Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel HorizontalAlignment="Center">
                                <Button Command="{Binding ToggleSidebarCommand}"
                                        ToolTip="Expand sidebar (Ctrl+[)"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand">
                                    <Border Width="36" Height="36" 
                                            CornerRadius="9" 
                                            Background="{DynamicResource AccentBrush}">
                                        <Path Data="{StaticResource IconBlePath}" 
                                              Width="18" Height="18" 
                                              Fill="White" 
                                              Stretch="Uniform" 
                                              HorizontalAlignment="Center" 
                                              VerticalAlignment="Center" />
                                    </Border>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Navigation Groups List (Scrollable, Supports Both Modes) -->
                <ScrollViewer Grid.Row="1" 
                              VerticalScrollBarVisibility="Auto" 
                              HorizontalScrollBarVisibility="Disabled" 
                              Padding="10,10,10,10">
                    <StackPanel>

                        <!-- GROUP 1: GENERAL -->
                        <Border Style="{StaticResource NavGroupContainer}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" 
                                            Margin="6,2,0,6"
                                            Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Path Data="{StaticResource IconDevicesPath}" Width="11" Height="11" Fill="{DynamicResource NavGroupTextBrush}" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="GENERAL" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource NavGroupTextBrush}" VerticalAlignment="Center" />
                                </StackPanel>

                                <RadioButton Tag="{StaticResource IconDashboardPath}" 
                                             Content="Overview" 
                                             Style="{StaticResource NavItemStyle}" 
                                             IsChecked="{Binding ActiveSection, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter='Dashboard', Mode=OneWay}" 
                                             Command="{Binding NavigateCommand}" 
                                             CommandParameter="Dashboard" />
                                <RadioButton Tag="{StaticResource IconBlePath}" 
                                             Content="Bluetooth" 
                                             Style="{StaticResource NavItemStyle}" 
                                             IsChecked="{Binding ActiveSection, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter='Bluetooth', Mode=OneWay}" 
                                             Command="{Binding NavigateCommand}" 
                                             CommandParameter="Bluetooth" />
                                <RadioButton Tag="{StaticResource IconDevicesPath}" 
                                             Content="Bluetooth Devices" 
                                             Style="{StaticResource NavItemStyle}" 
                                             IsChecked="{Binding ActiveSection, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter='Bluetooth Devices', Mode=OneWay}" 
                                             Command="{Binding NavigateCommand}" 
                                             CommandParameter="Bluetooth Devices" />
                                <RadioButton Tag="{StaticResource IconScannerPath}" 
                                             Content="Device Scanner" 
                                             Style="{StaticResource NavItemStyle}" 
                                             IsChecked="{Binding ActiveSection, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter='Device Scanner', Mode=OneWay}" 
                                             Command="{Binding NavigateCommand}" 
                                             CommandParameter="Device Scanner" />
                            </StackPanel>
                        </Border>

                        <!-- GROUP 2: DEVICES & HARDWARE -->
                        <Border Style="{StaticResource NavGroupContainer}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" 
                                            Margin="6,2,0,6"
                                            Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Path Data="{StaticResource IconHardwarePath}" Width="11" Height="11" Fill="{DynamicResource NavGroupTextBrush}" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="DEVICES &amp; HARDWARE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource NavGroupTextBrush}" VerticalAlignment="Center" />
                                </StackPanel>

                                <RadioButton Tag="{StaticResource IconHardwarePath}" 
                                             Content="Hardware Inspector" 
                                             Style="{StaticResource NavItemStyle}" 
                                             IsChecked="{Binding ActiveSection, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter='Advanced Hardware Inspector', Mode=OneWay}" 
                                             Command="{Binding NavigateCommand}" 
                                             CommandParameter="Advanced Hardware Inspector" />
                                <RadioButton Tag="{StaticResource IconDriverPath}" 
                                             Content="Driver Assistant" 
                                             Style="{StaticResource NavItemStyle}" 
                                             IsChecked="{Binding ActiveSection, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter='Driver Assistant', Mode=OneWay}" 
                                             Command="{Binding NavigateCommand}" 
                                             CommandParameter="Driver Assistant" />
                                <RadioButton Tag="{StaticResource IconCompatibilityPath}" 
                                             Content="Compatibility" 
                                             Style="{StaticResource NavItemStyle}" 
                                             IsChecked="{Binding ActiveSection, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter='Compatibility Checker', Mode=OneWay}" 
                                             Command="{Binding NavigateCommand}" 
                                             CommandParameter="Compatibility Checker" />
                            </StackPanel>
                        </Border>

                        <!-- GROUP 3: DIAGNOSTICS -->
                        <Border Style="{StaticResource NavGroupContainer}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" 
                                            Margin="6,2,0,6"
                                            Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Path Data="{StaticResource IconDiagnosticPath}" Width="11" Height="11" Fill="{DynamicResource NavGroupTextBrush}" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="DIAGNOSTICS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource NavGroupTextBrush}" VerticalAlignment="Center" />
                                </StackPanel>

                                <RadioButton Tag="{StaticResource IconDiagnosticPath}" 
                                             Content="Diagnostic Center" 
                                             Style="{StaticResource NavItemStyle}" 
                                             IsChecked="{Binding ActiveSection, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter='Diagnostic Test Center', Mode=OneWay}" 
                                             Command="{Binding NavigateCommand}" 
                                             CommandParameter="Diagnostic Test Center" />
                                <RadioButton Tag="{StaticResource IconAudioPath}" 
                                             Content="Audio Diagnostics" 
                                             Style="{StaticResource NavItemStyle}" 
                                             IsChecked="{Binding ActiveSection, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter='Audio &amp; Packet Diagnostics', Mode=OneWay}" 
                                             Command="{Binding NavigateCommand}" 
                                             CommandParameter="Audio &amp; Packet Diagnostics" />
                                <RadioButton Tag="{StaticResource IconEventsPath}" 
                                             Content="Event Analyzer" 
                                             Style="{StaticResource NavItemStyle}" 
                                             IsChecked="{Binding ActiveSection, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter='Bluetooth Event Analyzer', Mode=OneWay}" 
                                             Command="{Binding NavigateCommand}" 
                                             CommandParameter="Bluetooth Event Analyzer" />
                                <RadioButton Tag="{StaticResource IconSignalPath}" 
                                             Content="Signal Monitor" 
                                             Style="{StaticResource NavItemStyle}" 
                                             IsChecked="{Binding ActiveSection, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter='Signal &amp; Discovery Monitor', Mode=OneWay}" 
                                             Command="{Binding NavigateCommand}" 
                                             CommandParameter="Signal &amp; Discovery Monitor" />
                                <RadioButton Tag="{StaticResource IconHistoryPath}" 
                                             Content="Connection History" 
                                             Style="{StaticResource NavItemStyle}" 
                                             IsChecked="{Binding ActiveSection, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter='Device Connection History', Mode=OneWay}" 
                                             Command="{Binding NavigateCommand}" 
                                             CommandParameter="Device Connection History" />
                            </StackPanel>
                        </Border>

                        <!-- GROUP 4: MAINTENANCE -->
                        <Border Style="{StaticResource NavGroupContainer}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" 
                                            Margin="6,2,0,6"
                                            Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Path Data="{StaticResource IconRepairPath}" Width="11" Height="11" Fill="{DynamicResource NavGroupTextBrush}" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="MAINTENANCE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource NavGroupTextBrush}" VerticalAlignment="Center" />
                                </StackPanel>

                                <RadioButton Tag="{StaticResource IconRepairPath}" 
                                             Content="Fix Connection Doctor" 
                                             Style="{StaticResource NavItemStyle}" 
                                             IsChecked="{Binding ActiveSection, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter='Fix My Bluetooth Connection', Mode=OneWay}" 
                                             Command="{Binding NavigateCommand}" 
                                             CommandParameter="Fix My Bluetooth Connection" />
                                <RadioButton Tag="{StaticResource IconRepairPath}" 
                                             Content="Safe Repair Center" 
                                             Style="{StaticResource NavItemStyle}" 
                                             IsChecked="{Binding ActiveSection, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter='Safe Repair Center', Mode=OneWay}" 
                                             Command="{Binding NavigateCommand}" 
                                             CommandParameter="Safe Repair Center" />
                                <RadioButton Tag="{StaticResource IconReportPath}" 
                                             Content="Diagnostic Reports" 
                                             Style="{StaticResource NavItemStyle}" 
                                             IsChecked="{Binding ActiveSection, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter='Diagnostic Reports', Mode=OneWay}" 
                                             Command="{Binding NavigateCommand}" 
                                             CommandParameter="Diagnostic Reports" />
                            </StackPanel>
                        </Border>

                        <!-- GROUP 5: ADVANCED TOOLS -->
                        <Border Style="{StaticResource NavGroupContainer}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" 
                                            Margin="6,2,0,6"
                                            Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Path Data="{StaticResource IconToolkitPath}" Width="11" Height="11" Fill="{DynamicResource NavGroupTextBrush}" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="ADVANCED TOOLS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource NavGroupTextBrush}" VerticalAlignment="Center" />
                                </StackPanel>

                                <RadioButton Tag="{StaticResource IconBlePath}" 
                                             Content="BLE Explorer" 
                                             Style="{StaticResource NavItemStyle}" 
                                             IsChecked="{Binding ActiveSection, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter='Bluetooth LE Explorer', Mode=OneWay}" 
                                             Command="{Binding NavigateCommand}" 
                                             CommandParameter="Bluetooth LE Explorer" />
                                <RadioButton Tag="{StaticResource IconToolkitPath}" 
                                             Content="Technician Toolkit" 
                                             Style="{StaticResource NavItemStyle}" 
                                             IsChecked="{Binding ActiveSection, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter='Technician Toolkit', Mode=OneWay}" 
                                             Command="{Binding NavigateCommand}" 
                                             CommandParameter="Technician Toolkit" />
                                <RadioButton Tag="{StaticResource IconCloudPath}" 
                                             Content="SaaS Fleet Dashboard" 
                                             Style="{StaticResource NavItemStyle}" 
                                             IsChecked="{Binding ActiveSection, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter='SaaS Fleet Portal', Mode=OneWay}" 
                                             Command="{Binding NavigateCommand}" 
                                             CommandParameter="SaaS Fleet Portal" />
                            </StackPanel>
                        </Border>

                        <!-- GROUP 6: PREFERENCES -->
                        <Border Style="{StaticResource NavGroupContainer}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" 
                                            Margin="6,2,0,6"
                                            Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Path Data="{StaticResource IconSettingsPath}" Width="11" Height="11" Fill="{DynamicResource NavGroupTextBrush}" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="PREFERENCES" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource NavGroupTextBrush}" VerticalAlignment="Center" />
                                </StackPanel>

                                <RadioButton Tag="{StaticResource IconSettingsPath}" 
                                             Content="Settings" 
                                             Style="{StaticResource NavItemStyle}" 
                                             IsChecked="{Binding ActiveSection, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter='Settings', Mode=OneWay}" 
                                             Command="{Binding NavigateCommand}" 
                                             CommandParameter="Settings" />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- Sidebar Footer -->
                <Border Grid.Row="2" 
                        Padding="14,10" 
                        BorderBrush="{DynamicResource BorderBrush}" 
                        BorderThickness="0,1,0,0" 
                        Background="{DynamicResource SurfaceSidebarBrush}">
                    <StackPanel Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="Developer: Golam Morshed Eashan" 
                                   FontSize="11" 
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="BlueDoc v1.0 • .NET 4.8 / Win32" 
                                   FontSize="10" 
                                   Foreground="{DynamicResource TextMutedBrush}" 
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- =========================================================================
             2. TOP HEADER & MAIN APPLICATION CONTENT CANVAS
             ========================================================================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <!-- Row 0: Top Header Navigation Bar (56px) -->
                <RowDefinition Height="56" />
                <!-- Row 1: Active Page Container -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top Header Navigation Bar -->
            <Border Grid.Row="0" 
                    Background="{DynamicResource HeaderBgBrush}" 
                    BorderBrush="{DynamicResource BorderBrush}" 
                    BorderThickness="0,0,0,1" 
                    Padding="16,0"
                    SnapsToDevicePixels="True">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <!-- Left: Breadcrumbs -->
                        <ColumnDefinition Width="*" />
                        <!-- Right: Telemetry Indicators, Theme, Quick Diagnosis, Notifications -->
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Sidebar Toggle Button + Breadcrumbs -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Sidebar Toggle Quick Button -->
                        <Button Command="{Binding ToggleSidebarCommand}"
                                ToolTip="{Binding SidebarToggleTooltip}"
                                Style="{StaticResource GhostButton}"
                                Padding="6,4"
                                Margin="0,0,10,0">
                            <Path Data="{StaticResource IconPanelTogglePath}" 
                                  Width="14" Height="14" 
                                  Fill="{DynamicResource TextSecondaryBrush}" 
                                  Stretch="Uniform" />
                        </Button>

                        <!-- Breadcrumb Path -->
                        <TextBlock Text="BlueDoc" 
                                   FontSize="12" 
                                   Foreground="{DynamicResource TextMutedBrush}" 
                                   VerticalAlignment="Center" />
                        <Path Style="{StaticResource BreadcrumbSeparator}" />
                        <TextBlock Text="{Binding ActiveGroup}" 
                                   FontSize="12" 
                                   Foreground="{DynamicResource TextMutedBrush}" 
                                   VerticalAlignment="Center" />
                        <Path Style="{StaticResource BreadcrumbSeparator}" />
                        <TextBlock Text="{Binding ActiveSection}" 
                                   FontSize="13.5" 
                                   FontWeight="SemiBold" 
                                   Foreground="{DynamicResource TextPrimaryBrush}" 
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Right: Context Controls & Telemetry -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">

                        <!-- C. Primary Bluetooth Adapter Status Pill -->
                        <Border Background="{DynamicResource SurfaceElevatedBrush}" 
                                BorderBrush="{DynamicResource BorderBrush}" 
                                BorderThickness="1" 
                                CornerRadius="12" 
                                Padding="10,4" 
                                Margin="0,0,12,0" 
                                VerticalAlignment="Center" 
                                ToolTip="{Binding PrimaryAdapter.FriendlyName}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding PrimaryAdapter.FriendlyName, FallbackValue='Bluetooth Controller'}" 
                                           FontSize="12" 
                                           FontWeight="Medium" 
                                           Foreground="{DynamicResource TextSecondaryBrush}" 
                                           MaxWidth="180" 
                                           TextTrimming="CharacterEllipsis" 
                                           Margin="0,0,7,0" />
                                <Ellipse Width="7" Height="7" 
                                         Fill="#2EA043" 
                                         VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRadioOn}" Value="False">
                                                    <Setter Property="Fill" Value="#F85149" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                            </StackPanel>
                        </Border>

                        <!-- B. Persistent Appearance Theme Segmented Switcher [ ☀ Light | ☾ Dark ] -->
                        <Border Background="{DynamicResource PillBgBrush}" 
                                BorderBrush="{DynamicResource BorderBrush}" 
                                BorderThickness="1" 
                                CornerRadius="12" 
                                Padding="2" 
                                Margin="0,0,12,0" 
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="☀ Light" 
                                             GroupName="ThemeSwitch"
                                             IsChecked="{Binding IsLightTheme, Mode=TwoWay}"
                                             Command="{Binding SetThemeCommand}"
                                             CommandParameter="Light"
                                             Style="{StaticResource ThemeSegmentButton}" />
                                <RadioButton Content="🌙 Dark" 
                                             GroupName="ThemeSwitch"
                                             IsChecked="{Binding IsDarkTheme, Mode=TwoWay}"
                                             Command="{Binding SetThemeCommand}"
                                             CommandParameter="Dark"
                                             Style="{StaticResource ThemeSegmentButton}" />
                            </StackPanel>
                        </Border>

                        <!-- A. Native-Style Hardware Bluetooth Radio Power Switch -->
                        <Button Command="{Binding ToggleRadioPowerCommand}"
                                Cursor="Hand"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="0"
                                Margin="0,0,10,0"
                                ToolTip="Toggle Hardware Bluetooth Radio Power (ON/OFF)">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{DynamicResource SurfaceElevatedBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="14"
                                            Padding="10,4">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Bluetooth Icon -->
                                            <Path Data="{StaticResource IconBlePath}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Setter Property="Fill" Value="{DynamicResource TextMutedBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsRadioOn}" Value="True">
                                                                <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>

                                            <!-- State Text -->
                                            <TextBlock FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="Bluetooth: OFF" />
                                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsRadioOn}" Value="True">
                                                                <Setter Property="Text" Value="Bluetooth: ON" />
                                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <!-- Native Track and Sliding Thumb -->
                                            <Border Width="34" Height="18" CornerRadius="9" SnapsToDevicePixels="True" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource BorderStrongBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsRadioOn}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Ellipse Width="12" Height="12" Fill="White" VerticalAlignment="Center">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="HorizontalAlignment" Value="Left" />
                                                            <Setter Property="Margin" Value="3,0,0,0" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsRadioOn}" Value="True">
                                                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                                                    <Setter Property="Margin" Value="0,0,3,0" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Notification Center Bell Toggle Button -->
                        <Grid>
                            <Button Command="{Binding Notifications.ToggleNotificationCenterCommand}"
                                    Style="{StaticResource IconButton}"
                                    Width="30" Height="30"
                                    ToolTip="Notification Center">
                                <Path Data="{StaticResource IconBellPath}" 
                                      Width="13" Height="13" 
                                      Fill="{DynamicResource TextSecondaryBrush}" 
                                      Stretch="Uniform" />
                            </Button>

                            <!-- Unread Notification Badge Dot -->
                            <Border Width="8" Height="8" 
                                    CornerRadius="4" 
                                    Background="{DynamicResource DangerBrush}" 
                                    HorizontalAlignment="Right" 
                                    VerticalAlignment="Top" 
                                    Margin="0,2,2,0"
                                    IsHitTestVisible="False"
                                    Visibility="{Binding Notifications.HasUnread, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>

                    </StackPanel>
                </Grid>
            </Border>

            <!-- =========================================================================
                 3. PAGE CONTAINER (With Lightweight Fade Transition)
                 ========================================================================= -->
            <Border Grid.Row="1" Background="{DynamicResource SurfaceCanvasBrush}">
                <ContentControl Content="{Binding CurrentViewModel}">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Style.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="0.3" To="1.0"
                                                             Duration="0:0:0.16" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
            </Border>

            <!-- =========================================================================
                 4. NOTIFICATION CENTER POPUP / DRAWER
                 ========================================================================= -->
            <Border Grid.Row="1" 
                    Width="380" 
                    HorizontalAlignment="Right" 
                    VerticalAlignment="Top" 
                    Margin="0,8,16,0"
                    Background="{DynamicResource SurfaceElevatedBrush}"
                    BorderBrush="{DynamicResource BorderStrongBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16"
                    Panel.ZIndex="1200"
                    Visibility="{Binding Notifications.IsNotificationCenterOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
                    SnapsToDevicePixels="True">
                <Grid MaxHeight="450">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="Notification Center" 
                                   FontSize="14" 
                                   FontWeight="SemiBold" 
                                   Foreground="{DynamicResource TextPrimaryBrush}" 
                                   VerticalAlignment="Center" />
                        <Button Content="Clear All" 
                                Command="{Binding Notifications.ClearHistoryCommand}"
                                Style="{StaticResource GhostButton}"
                                HorizontalAlignment="Right"
                                Padding="6,2"
                                FontSize="11" />
                    </Grid>

                    <!-- Notifications List -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Empty State if no history -->
                            <TextBlock Text="No notifications yet." 
                                       FontSize="12" 
                                       Foreground="{DynamicResource TextMutedBrush}" 
                                       HorizontalAlignment="Center" 
                                       Margin="0,24"
                                       Visibility="{Binding Notifications.History.Count, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter='Inverse'}" />

                            <!-- List of Notifications -->
                            <ItemsControl ItemsSource="{Binding Notifications.History}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource CardBgBrush}" 
                                                BorderBrush="{DynamicResource BorderBrush}" 
                                                BorderThickness="1" 
                                                CornerRadius="6" 
                                                Padding="10,8" 
                                                Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="22" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Status Icon -->
                                                <Path Grid.Column="0" 
                                                      Data="{Binding Type, Converter={StaticResource NotificationTypeToGeometryConverter}}"
                                                      Fill="{Binding Type, Converter={StaticResource NotificationTypeToBrushConverter}}"
                                                      Width="14" Height="14" 
                                                      Stretch="Uniform" 
                                                      VerticalAlignment="Top" 
                                                      Margin="0,2,0,0" />

                                                <!-- Content -->
                                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                    <Grid>
                                                        <TextBlock Text="{Binding Title}" 
                                                                   FontSize="12" 
                                                                   FontWeight="SemiBold" 
                                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                                        <TextBlock Text="{Binding TimeDisplay}" 
                                                                   FontSize="10" 
                                                                   Foreground="{DynamicResource TextMutedBrush}" 
                                                                   HorizontalAlignment="Right" />
                                                    </Grid>
                                                    <TextBlock Text="{Binding Message}" 
                                                               FontSize="11.5" 
                                                               Foreground="{DynamicResource TextSecondaryBrush}" 
                                                               TextWrapping="Wrap" 
                                                               Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- =========================================================================
                 5. REUSABLE FLOATING TOAST NOTIFICATIONS (Bottom-Right Overlay)
                 ========================================================================= -->
            <ItemsControl Grid.Row="1" 
                          ItemsSource="{Binding Notifications.ActiveToasts}" 
                          HorizontalAlignment="Right" 
                          VerticalAlignment="Bottom" 
                          Margin="0,0,20,20" 
                          Panel.ZIndex="1100"
                          Width="360"
                          IsHitTestVisible="True">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource SurfaceElevatedBrush}" 
                                BorderBrush="{DynamicResource BorderStrongBrush}" 
                                BorderThickness="1" 
                                CornerRadius="8" 
                                Padding="12,10" 
                                Margin="0,6,0,0"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Status / Type Icon -->
                                <Path Grid.Column="0" 
                                      Data="{Binding Type, Converter={StaticResource NotificationTypeToGeometryConverter}}"
                                      Fill="{Binding Type, Converter={StaticResource NotificationTypeToBrushConverter}}"
                                      Width="16" Height="16" 
                                      Stretch="Uniform" 
                                      VerticalAlignment="Top" 
                                      Margin="0,2,0,0" />

                                <!-- Title, Message & Progress -->
                                <StackPanel Grid.Column="1" Margin="8,0,8,0">
                                    <TextBlock Text="{Binding Title}" 
                                               FontSize="12.5" 
                                               FontWeight="SemiBold" 
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding Message}" 
                                               FontSize="11.5" 
                                               Foreground="{DynamicResource TextSecondaryBrush}" 
                                               TextWrapping="Wrap" 
                                               Margin="0,2,0,4" />
                                    <!-- Long-running Indeterminate Progress Bar -->
                                    <ProgressBar Height="4" 
                                                 IsIndeterminate="True" 
                                                 Margin="0,4,0,0"
                                                 Visibility="{Binding IsIndeterminate, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>

                                <!-- Dismiss Button -->
                                <Button Grid.Column="2" 
                                        Command="{Binding DismissCommand}"
                                        Style="{StaticResource GhostButton}"
                                        Padding="4"
                                        Width="20" Height="20"
                                        VerticalAlignment="Top"
                                        Cursor="Hand">
                                    <Path Data="{StaticResource IconClosePath}" 
                                          Width="9" Height="9" 
                                          Fill="{DynamicResource TextMutedBrush}" 
                                          Stretch="Uniform" />
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </Grid>
    </Grid>
</Window>
