<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- =========================================================================
         BlueDoc - macOS Sonoma System Settings Design System (Dark Theme)
         Typography: SF Pro Display / SF Pro Text / Segoe UI Variable
         Palette: Deep graphite gradient (#2C2C2E -> #1C1C1E), dark card surfaces (#2C2C2E)
         Target: Windows 7 SP1+ (Native WPF, no transparency hacks, no drop shadows)
         ========================================================================= -->

    <!-- ==========================================
         1. COLOR DEFINITIONS (DARK THEME)
         ========================================== -->
    <Color x:Key="MacOsDarkSidebarStartColor">#2C2C2E</Color>
    <Color x:Key="MacOsDarkSidebarEndColor">#1C1C1E</Color>

    <Color x:Key="MacOsDarkMainBgColor">#1E1E1E</Color>
    <Color x:Key="MacOsDarkCardBgColor">#2C2C2E</Color>
    <Color x:Key="MacOsDarkCardBorderColor">#3A3A3C</Color>
    <Color x:Key="MacOsDarkBorderColor">#3A3A3C</Color>

    <Color x:Key="MacOsDarkTextPrimaryColor">#F5F5F7</Color>
    <Color x:Key="MacOsDarkTextSecondaryColor">#86868B</Color>
    <Color x:Key="MacOsDarkTextMutedColor">#636366</Color>

    <Color x:Key="MacOsDarkAccentColor">#0A84FF</Color>
    <Color x:Key="MacOsDarkAccentHoverColor">#409CFF</Color>
    <Color x:Key="MacOsDarkAccentSubtleColor">#19324D</Color>
    <Color x:Key="MacOsDarkSuccessColor">#34C759</Color>
    <Color x:Key="MacOsDarkWarningColor">#FF9F0A</Color>
    <Color x:Key="MacOsDarkDangerColor">#FF453A</Color>

    <!-- Translucent Overlay Colors for Sidebar States -->
    <Color x:Key="MacOsDarkNavHoverColor">#1AFFFFFF</Color>     <!-- 10% White overlay -->
    <Color x:Key="MacOsDarkNavSelectedColor">#33FFFFFF</Color>  <!-- 20% White overlay -->

    <!-- ==========================================
         2. SEMANTIC BRUSHES
         ========================================== -->
    <!-- Sidebar Graphite Gradient -->
    <LinearGradientBrush x:Key="SidebarGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource MacOsDarkSidebarStartColor}" Offset="0.0" />
        <GradientStop Color="{StaticResource MacOsDarkSidebarEndColor}" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Canvas & Surfaces -->
    <SolidColorBrush x:Key="MainBgBrush" Color="{StaticResource MacOsDarkMainBgColor}" />
    <SolidColorBrush x:Key="CardBgBrush" Color="{StaticResource MacOsDarkCardBgColor}" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource MacOsDarkCardBorderColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource MacOsDarkBorderColor}" />
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#323234" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#48484A" />

    <!-- Application Compatibility Brushes -->
    <SolidColorBrush x:Key="BgDarkBrush" Color="{StaticResource MacOsDarkMainBgColor}" />
    <SolidColorBrush x:Key="DarkBgBrush" Color="{StaticResource MacOsDarkMainBgColor}" />
    <SolidColorBrush x:Key="SurfaceCanvasBrush" Color="{StaticResource MacOsDarkMainBgColor}" />
    <SolidColorBrush x:Key="SidebarBgBrush" Color="{StaticResource MacOsDarkSidebarStartColor}" />
    <SolidColorBrush x:Key="SurfaceSidebarBrush" Color="{StaticResource MacOsDarkSidebarStartColor}" />
    <SolidColorBrush x:Key="SurfaceCardBrush" Color="{StaticResource MacOsDarkCardBgColor}" />
    <SolidColorBrush x:Key="SurfaceCardHoverBrush" Color="#353538" />
    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="#323235" />
    <SolidColorBrush x:Key="SurfaceSunkenBrush" Color="#161618" />
    <SolidColorBrush x:Key="HeaderBgBrush" Color="{StaticResource MacOsDarkMainBgColor}" />

    <!-- Typography Brushes -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource MacOsDarkTextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource MacOsDarkTextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource MacOsDarkTextMutedColor}" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#48484A" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF" />

    <!-- Accent & Feedback Brushes -->
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource MacOsDarkAccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource MacOsDarkAccentHoverColor}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#0066D6" />
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="{StaticResource MacOsDarkAccentSubtleColor}" />

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource MacOsDarkSuccessColor}" />
    <SolidColorBrush x:Key="SuccessSubtleBrush" Color="#13331D" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource MacOsDarkWarningColor}" />
    <SolidColorBrush x:Key="WarningSubtleBrush" Color="#332205" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource MacOsDarkDangerColor}" />
    <SolidColorBrush x:Key="DangerSubtleBrush" Color="#361514" />
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource MacOsDarkAccentColor}" />
    <SolidColorBrush x:Key="InfoSubtleBrush" Color="{StaticResource MacOsDarkAccentSubtleColor}" />

    <!-- Navigation & Pill Brushes -->
    <SolidColorBrush x:Key="NavActiveBgBrush" Color="{StaticResource MacOsDarkAccentColor}" />
    <SolidColorBrush x:Key="NavActiveTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="NavHoverBgBrush" Color="#323236" />
    <SolidColorBrush x:Key="NavGroupTextBrush" Color="{StaticResource MacOsDarkTextSecondaryColor}" />
    <SolidColorBrush x:Key="NavGroupBgBrush" Color="Transparent" />
    <SolidColorBrush x:Key="PillBgBrush" Color="#323236" />
    <SolidColorBrush x:Key="PillActiveBgBrush" Color="#48484A" />
    <SolidColorBrush x:Key="PillActiveTextBrush" Color="{StaticResource MacOsDarkTextPrimaryColor}" />
    <SolidColorBrush x:Key="PillInactiveTextBrush" Color="{StaticResource MacOsDarkTextSecondaryColor}" />

    <!-- macOS Specific Interactive Brushes -->
    <SolidColorBrush x:Key="MacOSSearchBgBrush" Color="#000000" Opacity="0.30" />
    <SolidColorBrush x:Key="MacOSNavHoverBrush" Color="#FFFFFF" Opacity="0.10" />
    <SolidColorBrush x:Key="MacOSNavSelectedBrush" Color="#FFFFFF" Opacity="0.20" />
    <SolidColorBrush x:Key="FocusRingBrush" Color="{StaticResource MacOsDarkAccentColor}" />
    <SolidColorBrush x:Key="OverlayBrush" Color="#80000000" />
    <SolidColorBrush x:Key="SkeletonBaseBrush" Color="#2C2C2E" />
    <SolidColorBrush x:Key="SkeletonShimmerBrush" Color="#3A3A3C" />

    <!-- ==========================================
         3. TYPOGRAPHY & SPACING TOKENS
         ========================================== -->
    <FontFamily x:Key="MacOsFontFamily">SF Pro Display, SF Pro Text, Segoe UI Variable, Segoe UI, sans-serif</FontFamily>
    <Thickness x:Key="MacOsMainPadding">32</Thickness>
    <Thickness x:Key="MacOsCardPadding">16</Thickness>
    <CornerRadius x:Key="MacOsCardCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="MacOsButtonCornerRadius">8</CornerRadius>

    <!-- Heading 28px SemiBold -->
    <Style x:Key="MacOsHeadingStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource MacOsFontFamily}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="LineHeight" Value="34" />
    </Style>

    <!-- Subheading 18px SemiBold -->
    <Style x:Key="MacOsSubheadingStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource MacOsFontFamily}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <!-- Body 13px Regular -->
    <Style x:Key="MacOsBodyStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource MacOsFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Regular" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <!-- Secondary Text 12px Regular -->
    <Style x:Key="MacOsSecondaryTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource MacOsFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Regular" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>

    <!-- Group Header 11px Bold Uppercase -->
    <Style x:Key="MacOsGroupHeaderStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource MacOsFontFamily}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Opacity" Value="0.85" />
        <Setter Property="Margin" Value="12,14,12,4" />
    </Style>

    <!-- ==========================================
         4. COMPONENT CONTROLTEMPLATES & STYLES
         ========================================== -->

    <!-- macOS Toggle Switch (Custom ControlTemplate - Dark Mode) -->
    <Style x:Key="MacOSToggleSwitch" TargetType="{x:Type ToggleButton}">
        <Setter Property="Width" Value="42" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border x:Name="Track" 
                            Width="42" Height="24" 
                            CornerRadius="12"
                            Background="#3A3A3C"
                            SnapsToDevicePixels="True">
                        <Ellipse x:Name="Thumb" 
                                 Width="20" Height="20" 
                                 Fill="#FFFFFF" 
                                 Margin="2" 
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Center">
                            <Ellipse.RenderTransform>
                                <TranslateTransform x:Name="ThumbTransform" X="0" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Track"
                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                        To="#34C759" Duration="0:0:0.2">
                                            <ColorAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </ColorAnimation.EasingFunction>
                                        </ColorAnimation>
                                        <DoubleAnimation Storyboard.TargetName="ThumbTransform"
                                                         Storyboard.TargetProperty="X"
                                                         To="18" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Track"
                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                        To="#3A3A3C" Duration="0:0:0.2">
                                            <ColorAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </ColorAnimation.EasingFunction>
                                        </ColorAnimation>
                                        <DoubleAnimation Storyboard.TargetName="ThumbTransform"
                                                         Storyboard.TargetProperty="X"
                                                         To="0" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Track" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- macOS Primary Button (Dark Mode) -->
    <Style x:Key="MacOsPrimaryButton" TargetType="{x:Type Button}">
        <Setter Property="FontFamily" Value="{StaticResource MacOsFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="border"
                            Background="{DynamicResource AccentBrush}"
                            BorderThickness="0"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" 
                                          VerticalAlignment="Center" 
                                          TextElement.Foreground="#FFFFFF" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource AccentHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#0058C6" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- macOS Secondary Button (Dark Mode) -->
    <Style x:Key="MacOsSecondaryButton" TargetType="{x:Type Button}">
        <Setter Property="FontFamily" Value="{StaticResource MacOsFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="border"
                            Background="Transparent"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" 
                                          VerticalAlignment="Center" 
                                          TextElement.Foreground="{DynamicResource TextPrimaryBrush}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#3A3A3E" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#48484C" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- macOS Search Box (Dark Mode) -->
    <Style x:Key="MacOsSearchTextBox" TargetType="{x:Type TextBox}">
        <Setter Property="FontFamily" Value="{StaticResource MacOsFontFamily}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Border x:Name="border"
                            Background="{DynamicResource MacOSSearchBgBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- Search Glyph -->
                            <Path Grid.Column="0" 
                                  Data="M 9.5 3 C 5.91 3 3 5.91 3 9.5 C 3 13.09 5.91 16 9.5 16 C 11.02 16 12.42 15.48 13.53 14.6 L 17.47 18.54 C 17.76 18.83 18.24 18.83 18.53 18.54 C 18.82 18.25 18.82 17.77 18.53 17.47 L 14.6 13.53 C 15.48 12.42 16 11.02 16 9.5 C 16 5.91 13.09 3 9.5 3 Z M 9.5 4.5 C 12.26 4.5 14.5 6.74 14.5 9.5 C 14.5 12.26 12.26 14.5 9.5 14.5 C 6.74 14.5 4.5 12.26 4.5 9.5 C 4.5 6.74 6.74 4.5 9.5 4.5 Z" 
                                  Fill="{DynamicResource TextSecondaryBrush}" 
                                  Width="12" Height="12" 
                                  Stretch="Uniform" 
                                  VerticalAlignment="Center" 
                                  Margin="2,0,6,0" 
                                  Opacity="0.7" />
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Grid.Column="1"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"
                                          VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="border" Property="Background" Value="#252528" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- macOS Sidebar ListBox Item Style (Dark Mode - 10% hover, 20% selected) -->
    <Style x:Key="MacOsSidebarItemStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="FontFamily" Value="{StaticResource MacOsFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Margin" Value="8,2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Border x:Name="ItemBorder"
                            CornerRadius="8"
                            Background="#00FFFFFF"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter x:Name="ContentPresenter"
                                          VerticalAlignment="Center" 
                                          RecognizesAccessKey="False" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Hover: ColorAnimation to #FFFFFF (Opacity 0.10 in Dark: #1AFFFFFF) over 0.15s -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="ItemBorder"
                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                        To="#1AFFFFFF"
                                                        Duration="0:0:0.15">
                                            <ColorAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </ColorAnimation.EasingFunction>
                                        </ColorAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="ItemBorder"
                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                        To="#00FFFFFF"
                                                        Duration="0:0:0.15">
                                            <ColorAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </ColorAnimation.EasingFunction>
                                        </ColorAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <!-- Selected: ColorAnimation to #FFFFFF (Opacity 0.20 in Dark: #33FFFFFF) over 0.2s -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="ItemBorder"
                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                        To="#33FFFFFF"
                                                        Duration="0:0:0.2">
                                            <ColorAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </ColorAnimation.EasingFunction>
                                        </ColorAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="ItemBorder"
                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                        To="#00FFFFFF"
                                                        Duration="0:0:0.2">
                                            <ColorAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </ColorAnimation.EasingFunction>
                                        </ColorAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- macOS Sidebar ListBox Style -->
    <Style x:Key="MacOsSidebarListBoxStyle" TargetType="{x:Type ListBox}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource MacOsSidebarItemStyle}" />
    </Style>

    <!-- macOS Flat Card Container Style -->
    <Style x:Key="MacOsCardContainer" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource CardBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource MacOsCardCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource MacOsCardPadding}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

</ResourceDictionary>

