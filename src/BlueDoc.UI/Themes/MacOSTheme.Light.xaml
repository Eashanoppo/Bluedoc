<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- =========================================================================
         BlueDoc - macOS Sonoma System Settings Design System (Light Theme)
         Typography: SF Pro Display / SF Pro Text / Segoe UI Variable
         Palette: Subtle pastel sidebar gradient with crisp #FFFFFF card surfaces
         Target: Windows 7 SP1+ (Native WPF, no transparency hacks, no drop shadows)
         ========================================================================= -->

    <!-- ==========================================
         1. COLOR DEFINITIONS (LIGHT THEME)
         ========================================== -->
    <Color x:Key="MacOsLightSidebarStartColor">#F7D6C4</Color>
    <Color x:Key="MacOsLightSidebarMidColor">#E8D5F5</Color>
    <Color x:Key="MacOsLightSidebarEndColor">#D4C5F0</Color>

    <Color x:Key="MacOsLightMainBgColor">#FFFFFF</Color>
    <Color x:Key="MacOsLightCardBgColor">#FFFFFF</Color>
    <Color x:Key="MacOsLightCardBorderColor">#E5E5E7</Color>
    <Color x:Key="MacOsLightBorderColor">#E5E5E7</Color>

    <Color x:Key="MacOsLightTextPrimaryColor">#1D1D1F</Color>
    <Color x:Key="MacOsLightTextSecondaryColor">#6E6E73</Color>
    <Color x:Key="MacOsLightTextMutedColor">#86868B</Color>

    <Color x:Key="MacOsLightAccentColor">#007AFF</Color>
    <Color x:Key="MacOsLightAccentHoverColor">#0062CC</Color>
    <Color x:Key="MacOsLightAccentSubtleColor">#E5F1FF</Color>
    <Color x:Key="MacOsLightSuccessColor">#34C759</Color>
    <Color x:Key="MacOsLightWarningColor">#FF9500</Color>
    <Color x:Key="MacOsLightDangerColor">#FF3B30</Color>

    <!-- Translucent Overlay Colors for Sidebar States -->
    <Color x:Key="MacOsNavHoverColor">#26FFFFFF</Color>      <!-- 15% White overlay -->
    <Color x:Key="MacOsNavSelectedColor">#40FFFFFF</Color>   <!-- 25% White overlay -->

    <!-- ==========================================
         2. SEMANTIC BRUSHES
         ========================================== -->
    <!-- Sidebar Pastel Gradient -->
    <LinearGradientBrush x:Key="SidebarGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource MacOsLightSidebarStartColor}" Offset="0.0" />
        <GradientStop Color="{StaticResource MacOsLightSidebarMidColor}" Offset="0.5" />
        <GradientStop Color="{StaticResource MacOsLightSidebarEndColor}" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Canvas & Surfaces -->
    <SolidColorBrush x:Key="MainBgBrush" Color="{StaticResource MacOsLightMainBgColor}" />
    <SolidColorBrush x:Key="CardBgBrush" Color="{StaticResource MacOsLightCardBgColor}" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource MacOsLightCardBorderColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource MacOsLightBorderColor}" />
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#ECECEE" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#D1D1D6" />

    <!-- Application Compatibility Brushes -->
    <SolidColorBrush x:Key="BgDarkBrush" Color="{StaticResource MacOsLightMainBgColor}" />
    <SolidColorBrush x:Key="DarkBgBrush" Color="{StaticResource MacOsLightMainBgColor}" />
    <SolidColorBrush x:Key="SurfaceCanvasBrush" Color="{StaticResource MacOsLightMainBgColor}" />
    <SolidColorBrush x:Key="SidebarBgBrush" Color="#F5F2F9" />
    <SolidColorBrush x:Key="SurfaceSidebarBrush" Color="#F5F2F9" />
    <SolidColorBrush x:Key="SurfaceCardBrush" Color="{StaticResource MacOsLightCardBgColor}" />
    <SolidColorBrush x:Key="SurfaceCardHoverBrush" Color="#F9F9FB" />
    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceSunkenBrush" Color="#F2F2F7" />
    <SolidColorBrush x:Key="HeaderBgBrush" Color="{StaticResource MacOsLightMainBgColor}" />

    <!-- Typography Brushes -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource MacOsLightTextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource MacOsLightTextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource MacOsLightTextMutedColor}" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#C7C7CC" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF" />

    <!-- Accent & Feedback Brushes -->
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource MacOsLightAccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource MacOsLightAccentHoverColor}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#004FB3" />
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="{StaticResource MacOsLightAccentSubtleColor}" />

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource MacOsLightSuccessColor}" />
    <SolidColorBrush x:Key="SuccessSubtleBrush" Color="#E8F8ED" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource MacOsLightWarningColor}" />
    <SolidColorBrush x:Key="WarningSubtleBrush" Color="#FFF4E5" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource MacOsLightDangerColor}" />
    <SolidColorBrush x:Key="DangerSubtleBrush" Color="#FDECEC" />
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource MacOsLightAccentColor}" />
    <SolidColorBrush x:Key="InfoSubtleBrush" Color="{StaticResource MacOsLightAccentSubtleColor}" />

    <!-- Navigation & Pill Brushes -->
    <SolidColorBrush x:Key="NavActiveBgBrush" Color="{StaticResource MacOsLightAccentColor}" />
    <SolidColorBrush x:Key="NavActiveTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="NavHoverBgBrush" Color="#E5E5EA" />
    <SolidColorBrush x:Key="NavGroupTextBrush" Color="{StaticResource MacOsLightTextSecondaryColor}" />
    <SolidColorBrush x:Key="NavGroupBgBrush" Color="Transparent" />
    <SolidColorBrush x:Key="PillBgBrush" Color="#E5E5EA" />
    <SolidColorBrush x:Key="PillActiveBgBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PillActiveTextBrush" Color="{StaticResource MacOsLightTextPrimaryColor}" />
    <SolidColorBrush x:Key="PillInactiveTextBrush" Color="{StaticResource MacOsLightTextSecondaryColor}" />

    <!-- macOS Specific Interactive Brushes -->
    <SolidColorBrush x:Key="MacOSSearchBgBrush" Color="#FFFFFF" Opacity="0.45" />
    <SolidColorBrush x:Key="MacOSNavHoverBrush" Color="#FFFFFF" Opacity="0.15" />
    <SolidColorBrush x:Key="MacOSNavSelectedBrush" Color="#FFFFFF" Opacity="0.25" />
    <SolidColorBrush x:Key="FocusRingBrush" Color="{StaticResource MacOsLightAccentColor}" />
    <SolidColorBrush x:Key="OverlayBrush" Color="#40000000" />
    <SolidColorBrush x:Key="SkeletonBaseBrush" Color="#E5E5EA" />
    <SolidColorBrush x:Key="SkeletonShimmerBrush" Color="#F2F2F7" />

    <!-- ==========================================
         3. TYPOGRAPHY & SPACING TOKENS
         ========================================== -->
    <FontFamily x:Key="MacOsFontFamily">SF Pro Display, SF Pro Text, Segoe UI Variable, Segoe UI, sans-serif</FontFamily>
    <Thickness x:Key="MacOsMainPadding">32</Thickness>
    <Thickness x:Key="MacOsCardPadding">16</Thickness>
    <CornerRadius x:Key="MacOsCardCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="MacOsButtonCornerRadius">8</CornerRadius>

    <!-- Heading 28px SemiBold -->
    <Style x:Key="MacOsHeadingStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource MacOsFontFamily}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="LineHeight" Value="34" />
    </Style>

    <!-- Subheading 18px SemiBold -->
    <Style x:Key="MacOsSubheadingStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource MacOsFontFamily}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <!-- Body 13px Regular -->
    <Style x:Key="MacOsBodyStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource MacOsFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Regular" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <!-- Secondary Text 12px Regular -->
    <Style x:Key="MacOsSecondaryTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource MacOsFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Regular" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>

    <!-- Group Header 11px Bold Uppercase -->
    <Style x:Key="MacOsGroupHeaderStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource MacOsFontFamily}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Opacity" Value="0.85" />
        <Setter Property="Margin" Value="12,14,12,4" />
    </Style>

    <!-- ==========================================
         4. COMPONENT CONTROLTEMPLATES & STYLES
         ========================================== -->

    <!-- macOS Toggle Switch (Custom ControlTemplate) -->
    <Style x:Key="MacOSToggleSwitch" TargetType="{x:Type ToggleButton}">
        <Setter Property="Width" Value="42" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border x:Name="Track" 
                            Width="42" Height="24" 
                            CornerRadius="12"
                            SnapsToDevicePixels="True">
                        <Border.Background>
                            <SolidColorBrush x:Name="TrackBrush" Color="#E5E5E7" />
                        </Border.Background>
                        <Ellipse x:Name="Thumb" 
                                 Width="20" Height="20" 
                                 Fill="#FFFFFF" 
                                 Margin="2" 
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Center">
                            <Ellipse.RenderTransform>
                                <TranslateTransform x:Name="ThumbTransform" X="0" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="TrackBrush"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#34C759" Duration="0:0:0.2">
                                            <ColorAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </ColorAnimation.EasingFunction>
                                        </ColorAnimation>
                                        <DoubleAnimation Storyboard.TargetName="ThumbTransform"
                                                         Storyboard.TargetProperty="X"
                                                         To="18" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="TrackBrush"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#E5E5E7" Duration="0:0:0.2">
                                            <ColorAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </ColorAnimation.EasingFunction>
                                        </ColorAnimation>
                                        <DoubleAnimation Storyboard.TargetName="ThumbTransform"
                                                         Storyboard.TargetProperty="X"
                                                         To="0" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Track" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- macOS Primary Button (CornerRadius=8, Padding=12,6, Accent Color) -->
    <Style x:Key="MacOsPrimaryButton" TargetType="{x:Type Button}">
        <Setter Property="FontFamily" Value="{StaticResource MacOsFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="border"
                            Background="{DynamicResource AccentBrush}"
                            BorderThickness="0"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" 
                                          VerticalAlignment="Center" 
                                          TextElement.Foreground="#FFFFFF" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource AccentHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource AccentPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- macOS Secondary Button (Border-only, Transparent Background) -->
    <Style x:Key="MacOsSecondaryButton" TargetType="{x:Type Button}">
        <Setter Property="FontFamily" Value="{StaticResource MacOsFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="border"
                            Background="Transparent"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" 
                                          VerticalAlignment="Center" 
                                          TextElement.Foreground="{DynamicResource TextPrimaryBrush}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#F2F2F7" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#E5E5EA" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- macOS Search Box (CornerRadius=8, Border=CardBorder, 40% Opacity Background) -->
    <Style x:Key="MacOsSearchTextBox" TargetType="{x:Type TextBox}">
        <Setter Property="FontFamily" Value="{StaticResource MacOsFontFamily}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Border x:Name="border"
                            Background="{DynamicResource MacOSSearchBgBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- Minimal Search Glyph -->
                            <Path Grid.Column="0" 
                                  Data="M 9.5 3 C 5.91 3 3 5.91 3 9.5 C 3 13.09 5.91 16 9.5 16 C 11.02 16 12.42 15.48 13.53 14.6 L 17.47 18.54 C 17.76 18.83 18.24 18.83 18.53 18.54 C 18.82 18.25 18.82 17.77 18.53 17.47 L 14.6 13.53 C 15.48 12.42 16 11.02 16 9.5 C 16 5.91 13.09 3 9.5 3 Z M 9.5 4.5 C 12.26 4.5 14.5 6.74 14.5 9.5 C 14.5 12.26 12.26 14.5 9.5 14.5 C 6.74 14.5 4.5 12.26 4.5 9.5 C 4.5 6.74 6.74 4.5 9.5 4.5 Z" 
                                  Fill="{DynamicResource TextSecondaryBrush}" 
                                  Width="12" Height="12" 
                                  Stretch="Uniform" 
                                  VerticalAlignment="Center" 
                                  Margin="2,0,6,0" 
                                  Opacity="0.7" />
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Grid.Column="1"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"
                                          VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="border" Property="Background" Value="#FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- macOS Sidebar ListBox Item Style (Lightweight Storyboards, 0.15s hover, 0.2s select) -->
    <Style x:Key="MacOsSidebarItemStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="FontFamily" Value="{StaticResource MacOsFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Margin" Value="8,2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Border x:Name="ItemBorder"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <Border.Background>
                            <SolidColorBrush x:Name="ItemBg" Color="#00FFFFFF" />
                        </Border.Background>
                        <ContentPresenter x:Name="ContentPresenter"
                                          VerticalAlignment="Center" 
                                          RecognizesAccessKey="False" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Hover: ColorAnimation to #FFFFFF (Opacity 0.15 in Light: #26FFFFFF) over 0.15s -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="ItemBg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#26FFFFFF"
                                                        Duration="0:0:0.15">
                                            <ColorAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </ColorAnimation.EasingFunction>
                                        </ColorAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="ItemBg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#00FFFFFF"
                                                        Duration="0:0:0.15">
                                            <ColorAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </ColorAnimation.EasingFunction>
                                        </ColorAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <!-- Selected: ColorAnimation to #FFFFFF (Opacity 0.25 in Light: #40FFFFFF) over 0.2s -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="ItemBg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#40FFFFFF"
                                                        Duration="0:0:0.2">
                                            <ColorAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </ColorAnimation.EasingFunction>
                                        </ColorAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="ItemBg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#00FFFFFF"
                                                        Duration="0:0:0.2">
                                            <ColorAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </ColorAnimation.EasingFunction>
                                        </ColorAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- macOS Sidebar ListBox Style -->
    <Style x:Key="MacOsSidebarListBoxStyle" TargetType="{x:Type ListBox}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource MacOsSidebarItemStyle}" />
    </Style>

    <!-- macOS Flat Card Container Style -->
    <Style x:Key="MacOsCardContainer" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource CardBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource MacOsCardCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource MacOsCardPadding}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

</ResourceDictionary>

