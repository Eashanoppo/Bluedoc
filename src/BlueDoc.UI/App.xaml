<Application x:Class="BlueDoc.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:common="clr-namespace:BlueDoc.UI.Common">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/Colors.xaml" />
                <ResourceDictionary Source="Styles/Styles.xaml" />
                <ResourceDictionary Source="Themes/MacOSTheme.Light.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <common:StatusToBrushConverter x:Key="StatusToBrushConverter" />
            <common:StatusToTextConverter x:Key="StatusToTextConverter" />
            <common:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <common:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
            <common:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />
            <common:BoolToSuccessConverter x:Key="BoolToSuccessConverter" />
            <common:NotificationTypeToBrushConverter x:Key="NotificationTypeToBrushConverter" />
            <common:NotificationTypeToGeometryConverter x:Key="NotificationTypeToGeometryConverter" />
            <common:EqualityToBooleanConverter x:Key="EqualityToBooleanConverter" />
            <common:NonZeroToVisibilityConverter x:Key="NonZeroToVisibilityConverter" />
            <common:InverseBooleanConverter x:Key="InverseBooleanConverter" />
            <common:BoolToStringConverter x:Key="BoolToStringConverter" />
            <common:NonZeroToBoolConverter x:Key="NonZeroToBoolConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
