<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- =========================================================================
         BlueDoc Design System - Palette & Semantic Color Tokens
         Brand: BlueDoc (UNLEFT LLC)
         Visual Identity: Precision Hardware Diagnostic Tool (Linear / Win11 / Apple)
         WCAG AA Accessible Contrast in both Dark and Light modes
         ========================================================================= -->

    <!-- ==========================================
         DARK THEME TOKENS (Deep Charcoal Minimalist Identity)
         ========================================== -->

    <!-- Surfaces & Backgrounds -->
    <Color x:Key="BgDarkColor">#0E1116</Color>
    <Color x:Key="SidebarBgColor">#0A0D11</Color>
    <Color x:Key="CardBgColor">#161B22</Color>
    <Color x:Key="CardBgHoverColor">#1C2128</Color>
    <Color x:Key="CardBgPressedColor">#14181E</Color>
    <Color x:Key="SurfaceElevatedColor">#21262D</Color>
    <Color x:Key="SurfaceSunkenColor">#0A0C10</Color>

    <!-- Borders -->
    <Color x:Key="BorderColor">#30363D</Color>
    <Color x:Key="BorderSubtleColor">#21262D</Color>
    <Color x:Key="BorderStrongColor">#3D444D</Color>
    <Color x:Key="BorderFocusColor">#388BFD</Color>

    <!-- Typography & Text -->
    <Color x:Key="TextPrimaryColor">#F0F3F6</Color>
    <Color x:Key="TextSecondaryColor">#8B949E</Color>
    <Color x:Key="TextMutedColor">#6E7681</Color>
    <Color x:Key="TextDisabledColor">#484F58</Color>
    <Color x:Key="TextOnAccentColor">#FFFFFF</Color>

    <!-- Brand / Accent (BlueDoc Refined Blue) -->
    <Color x:Key="AccentColor">#2F81F7</Color>
    <Color x:Key="AccentHoverColor">#58A6FF</Color>
    <Color x:Key="AccentPressedColor">#1F6FEB</Color>
    <Color x:Key="AccentSubtleColor">#162438</Color>

    <!-- Status & Feedback Semantics -->
    <Color x:Key="SuccessColor">#2EA043</Color>
    <Color x:Key="SuccessSubtleColor">#0D2818</Color>
    <Color x:Key="WarningColor">#D29922</Color>
    <Color x:Key="WarningSubtleColor">#2E2005</Color>
    <Color x:Key="DangerColor">#F85149</Color>
    <Color x:Key="DangerSubtleColor">#341212</Color>
    <Color x:Key="InfoColor">#388BFD</Color>
    <Color x:Key="InfoSubtleColor">#0C2D6B</Color>

    <!-- Navigation & UI Tokens -->
    <Color x:Key="NavActiveBgColor">#1F242C</Color>
    <Color x:Key="NavActiveTextColor">#58A6FF</Color>
    <Color x:Key="NavHoverBgColor">#161A20</Color>
    <Color x:Key="HeaderBgColor">#0E1116</Color>
    <Color x:Key="NavGroupTextColor">#6E7681</Color>
    <Color x:Key="NavGroupBgColor">#0E1116</Color>
    <Color x:Key="ArrowColor">#6E7681</Color>
    <Color x:Key="ArrowActiveColor">#58A6FF</Color>

    <!-- Segmented Switch Tokens -->
    <Color x:Key="PillBgColor">#161B22</Color>
    <Color x:Key="PillActiveBgColor">#2F81F7</Color>
    <Color x:Key="PillActiveTextColor">#FFFFFF</Color>
    <Color x:Key="PillInactiveTextColor">#8B949E</Color>

    <!-- Loading / Shimmer / Overlay -->
    <Color x:Key="SkeletonBaseColor">#161B22</Color>
    <Color x:Key="SkeletonShimmerColor">#21262D</Color>
    <Color x:Key="OverlayColor">#CC080B0F</Color>

    <!-- ==========================================
         SEMANTIC BRUSHES (Default Dark Theme)
         ========================================== -->

    <!-- Core Canvas & Surfaces -->
    <SolidColorBrush x:Key="BgDarkBrush" Color="{StaticResource BgDarkColor}" />
    <SolidColorBrush x:Key="DarkBgBrush" Color="{StaticResource BgDarkColor}" />
    <SolidColorBrush x:Key="SidebarBgBrush" Color="{StaticResource SidebarBgColor}" />
    <SolidColorBrush x:Key="CardBgBrush" Color="{StaticResource CardBgColor}" />
    <SolidColorBrush x:Key="CardBgHoverBrush" Color="{StaticResource CardBgHoverColor}" />
    <SolidColorBrush x:Key="CardBgPressedBrush" Color="{StaticResource CardBgPressedColor}" />
    <SolidColorBrush x:Key="SurfaceCanvasBrush" Color="{StaticResource BgDarkColor}" />
    <SolidColorBrush x:Key="SurfaceSidebarBrush" Color="{StaticResource SidebarBgColor}" />
    <SolidColorBrush x:Key="SurfaceCardBrush" Color="{StaticResource CardBgColor}" />
    <SolidColorBrush x:Key="SurfaceCardHoverBrush" Color="{StaticResource CardBgHoverColor}" />
    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="{StaticResource SurfaceElevatedColor}" />
    <SolidColorBrush x:Key="SurfaceSunkenBrush" Color="{StaticResource SurfaceSunkenColor}" />

    <!-- Borders -->
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtleColor}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />
    <SolidColorBrush x:Key="BorderFocusBrush" Color="{StaticResource BorderFocusColor}" />
    <SolidColorBrush x:Key="FocusRingBrush" Color="{StaticResource BorderFocusColor}" />

    <!-- Text & Content -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabledColor}" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="{StaticResource TextOnAccentColor}" />

    <!-- Brand / Accent -->
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="{StaticResource AccentSubtleColor}" />

    <!-- Semantics -->
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="SuccessSubtleBrush" Color="{StaticResource SuccessSubtleColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="WarningSubtleBrush" Color="{StaticResource WarningSubtleColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerSubtleBrush" Color="{StaticResource DangerSubtleColor}" />
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}" />
    <SolidColorBrush x:Key="InfoSubtleBrush" Color="{StaticResource InfoSubtleColor}" />

    <!-- Navigation -->
    <SolidColorBrush x:Key="NavActiveBgBrush" Color="{StaticResource NavActiveBgColor}" />
    <SolidColorBrush x:Key="NavActiveTextBrush" Color="{StaticResource NavActiveTextColor}" />
    <SolidColorBrush x:Key="NavHoverBgBrush" Color="{StaticResource NavHoverBgColor}" />
    <SolidColorBrush x:Key="HeaderBgBrush" Color="{StaticResource HeaderBgColor}" />
    <SolidColorBrush x:Key="NavGroupTextBrush" Color="{StaticResource NavGroupTextColor}" />
    <SolidColorBrush x:Key="NavGroupBgBrush" Color="{StaticResource NavGroupBgColor}" />
    <SolidColorBrush x:Key="ArrowBrush" Color="{StaticResource ArrowColor}" />
    <SolidColorBrush x:Key="ArrowActiveBrush" Color="{StaticResource ArrowActiveColor}" />

    <!-- Segmented Switch -->
    <SolidColorBrush x:Key="PillBgBrush" Color="{StaticResource PillBgColor}" />
    <SolidColorBrush x:Key="PillActiveBgBrush" Color="{StaticResource PillActiveBgColor}" />
    <SolidColorBrush x:Key="PillActiveTextBrush" Color="{StaticResource PillActiveTextColor}" />
    <SolidColorBrush x:Key="PillInactiveTextBrush" Color="{StaticResource PillInactiveTextColor}" />

    <!-- Shimmer & Modals -->
    <SolidColorBrush x:Key="SkeletonBaseBrush" Color="{StaticResource SkeletonBaseColor}" />
    <SolidColorBrush x:Key="SkeletonShimmerBrush" Color="{StaticResource SkeletonShimmerColor}" />
    <SolidColorBrush x:Key="OverlayBrush" Color="{StaticResource OverlayColor}" />

</ResourceDictionary>
