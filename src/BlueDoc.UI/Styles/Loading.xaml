            </Grid.ColumnDefinitions>
            <!-- Left Tree Skeleton -->
            <Border Grid.Column="0" Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                <StackPanel>
                    <Border Width="120" Height="12" HorizontalAlignment="Left" Style="{StaticResource SkeletonTextLine}" Margin="0,0,0,12" />
                    <Border Height="34" CornerRadius="6" Style="{StaticResource SkeletonBox}" Margin="0,0,0,6" />
                    <Border Height="34" CornerRadius="6" Style="{StaticResource SkeletonBox}" Margin="16,0,0,6" />
                    <Border Height="34" CornerRadius="6" Style="{StaticResource SkeletonBox}" Margin="16,0,0,6" />
                    <Border Height="34" CornerRadius="6" Style="{StaticResource SkeletonBox}" Margin="0,0,0,6" />
                </StackPanel>
            </Border>
            <!-- Right Panel Skeleton -->
            <Border Grid.Column="2" Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18">
                <StackPanel>
                    <Border Width="200" Height="16" HorizontalAlignment="Left" Style="{StaticResource SkeletonTextLine}" Margin="0,0,0,14" />
                    <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Width="90" Height="12" HorizontalAlignment="Left" Style="{StaticResource SkeletonTextLine}" Margin="0" /><Border Grid.Column="1" Width="180" Height="12" HorizontalAlignment="Left" Style="{StaticResource SkeletonTextLine}" Margin="0" /></Grid>
                    <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Width="100" Height="12" HorizontalAlignment="Left" Style="{StaticResource SkeletonTextLine}" Margin="0" /><Border Grid.Column="1" Width="150" Height="12" HorizontalAlignment="Left" Style="{StaticResource SkeletonTextLine}" Margin="0" /></Grid>
                    <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Width="80" Height="12" HorizontalAlignment="Left" Style="{StaticResource SkeletonTextLine}" Margin="0" /><Border Grid.Column="1" Width="220" Height="12" HorizontalAlignment="Left" Style="{StaticResource SkeletonTextLine}" Margin="0" /></Grid>
                    <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Width="110" Height="12" HorizontalAlignment="Left" Style="{StaticResource SkeletonTextLine}" Margin="0" /><Border Grid.Column="1" Width="130" Height="12" HorizontalAlignment="Left" Style="{StaticResource SkeletonTextLine}" Margin="0" /></Grid>
                </StackPanel>
            </Border>
        </Grid>
    </ControlTemplate>

    <!-- ==========================================
         EMPTY STATE COMPONENTS
         ========================================== -->
    <Style x:Key="EmptyStateContainer" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="36,44" />
        <Setter Property="Margin" Value="0,0,0,16" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="EmptyStateTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI, sans-serif" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,12,0,4" />
    </Style>

    <Style x:Key="EmptyStateDescription" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, sans-serif" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="MaxWidth" Value="420" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>

    <!-- ==========================================
         ERROR STATE COMPONENTS
         ========================================== -->
    <Style x:Key="ErrorStateContainer" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource DangerSubtleBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Margin" Value="0,0,0,16" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="ErrorStateTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI, sans-serif" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="ErrorStateDescription" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, sans-serif" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

</ResourceDictionary>
