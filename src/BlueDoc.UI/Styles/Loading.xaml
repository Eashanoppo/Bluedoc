        <StackPanel>
            <!-- Health Banner Placeholder -->
            <Border Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18,14" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="12" Height="12" CornerRadius="6" Style="{StaticResource SkeletonBox}" />
                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <Border Width="180" Height="14" HorizontalAlignment="Left" Style="{StaticResource SkeletonTextLine}" Margin="0,0,0,4" />
                        <Border Width="120" Height="11" HorizontalAlignment="Left" Style="{StaticResource SkeletonTextLine}" Margin="0" />
                    </StackPanel>
                    <Border Grid.Column="2" Width="100" Height="14" HorizontalAlignment="Right" Style="{StaticResource SkeletonTextLine}" Margin="0" />
                </Grid>
            </Border>

            <!-- 3-Metrics Grid Placeholders -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16,14">
                    <StackPanel>
                        <Border Width="32" Height="32" CornerRadius="8" Style="{StaticResource SkeletonBox}" Margin="0,0,0,10" HorizontalAlignment="Left" />
                        <Border Width="60" Height="22" Style="{StaticResource SkeletonBox}" Margin="0,0,0,6" HorizontalAlignment="Left" />
                        <Border Width="100" Height="11" Style="{StaticResource SkeletonTextLine}" HorizontalAlignment="Left" Margin="0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16,14">
                    <StackPanel>
                        <Border Width="32" Height="32" CornerRadius="8" Style="{StaticResource SkeletonBox}" Margin="0,0,0,10" HorizontalAlignment="Left" />
                        <Border Width="60" Height="22" Style="{StaticResource SkeletonBox}" Margin="0,0,0,6" HorizontalAlignment="Left" />
                        <Border Width="100" Height="11" Style="{StaticResource SkeletonTextLine}" HorizontalAlignment="Left" Margin="0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16,14">
                    <StackPanel>
                        <Border Width="32" Height="32" CornerRadius="8" Style="{StaticResource SkeletonBox}" Margin="0,0,0,10" HorizontalAlignment="Left" />
                        <Border Width="60" Height="22" Style="{StaticResource SkeletonBox}" Margin="0,0,0,6" HorizontalAlignment="Left" />
                        <Border Width="100" Height="11" Style="{StaticResource SkeletonTextLine}" HorizontalAlignment="Left" Margin="0" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ControlTemplate>

    <!-- 4. ADAPTER INFO SKELETON (Chip details, MAC, driver version, problem status) -->
