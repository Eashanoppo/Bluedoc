                    <Border Grid.Column="1" Width="250" Height="14" HorizontalAlignment="Left" Style="{StaticResource SkeletonTextLine}" Margin="8,0,0,0" />
                    <Border Grid.Column="2" Width="70" Height="14" Style="{StaticResource SkeletonTextLine}" Margin="0" />
                    <Border Grid.Column="3" Width="60" Height="20" CornerRadius="4" Style="{StaticResource SkeletonBox}" HorizontalAlignment="Right" />
                </Grid>
            </Border>
            <Border Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /><ColumnDefinition Width="80" /><ColumnDefinition Width="70" /></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="16" Height="16" CornerRadius="8" Style="{StaticResource SkeletonBox}" />
                    <Border Grid.Column="1" Width="200" Height="14" HorizontalAlignment="Left" Style="{StaticResource SkeletonTextLine}" Margin="8,0,0,0" />
                    <Border Grid.Column="2" Width="70" Height="14" Style="{StaticResource SkeletonTextLine}" Margin="0" />
                    <Border Grid.Column="3" Width="60" Height="20" CornerRadius="4" Style="{StaticResource SkeletonBox}" HorizontalAlignment="Right" />
                </Grid>
            </Border>
            <Border Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /><ColumnDefinition Width="80" /><ColumnDefinition Width="70" /></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="16" Height="16" CornerRadius="8" Style="{StaticResource SkeletonBox}" />
                    <Border Grid.Column="1" Width="230" Height="14" HorizontalAlignment="Left" Style="{StaticResource SkeletonTextLine}" Margin="8,0,0,0" />
                    <Border Grid.Column="2" Width="70" Height="14" Style="{StaticResource SkeletonTextLine}" Margin="0" />
                    <Border Grid.Column="3" Width="60" Height="20" CornerRadius="4" Style="{StaticResource SkeletonBox}" HorizontalAlignment="Right" />
                </Grid>
            </Border>
        </StackPanel>
    </ControlTemplate>

    <!-- 6. EVENT LOG TABLE SKELETON (Table Header + 4 Row Records) -->
    <ControlTemplate x:Key="EventLogTableSkeletonTemplate">
        <Border Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
            <StackPanel>
                <!-- Header -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition Width="90" /><ColumnDefinition Width="60" /><ColumnDefinition Width="60" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="70" Height="12" HorizontalAlignment="Left" Style="{StaticResource SkeletonTextLine}" Margin="0" />
                    <Border Grid.Column="1" Width="60" Height="12" HorizontalAlignment="Left" Style="{StaticResource SkeletonTextLine}" Margin="0" />
                    <Border Grid.Column="2" Width="40" Height="12" HorizontalAlignment="Left" Style="{StaticResource SkeletonTextLine}" Margin="0" />
                    <Border Grid.Column="3" Width="40" Height="12" HorizontalAlignment="Left" Style="{StaticResource SkeletonTextLine}" Margin="0" />
                    <Border Grid.Column="4" Width="120" Height="12" HorizontalAlignment="Left" Style="{StaticResource SkeletonTextLine}" Margin="0" />
                </Grid>
                <!-- Row 1 -->
                <Border Height="36" Style="{StaticResource SkeletonBox}" Margin="0,0,0,6" CornerRadius="4" />
                <!-- Row 2 -->
                <Border Height="36" Style="{StaticResource SkeletonBox}" Margin="0,0,0,6" CornerRadius="4" />
                <!-- Row 3 -->
                <Border Height="36" Style="{StaticResource SkeletonBox}" Margin="0,0,0,6" CornerRadius="4" />
                <!-- Row 4 -->
                <Border Height="36" Style="{StaticResource SkeletonBox}" CornerRadius="4" />
            </StackPanel>
        </Border>
