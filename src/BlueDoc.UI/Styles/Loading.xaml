        <Border Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,16">
            <StackPanel>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="38" Height="38" CornerRadius="8" Style="{StaticResource SkeletonBox}" />
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <Border Width="180" Height="15" HorizontalAlignment="Left" Style="{StaticResource SkeletonTextLine}" Margin="0,0,0,4" />
                        <Border Width="130" Height="11" HorizontalAlignment="Left" Style="{StaticResource SkeletonTextLine}" Margin="0" />
                    </StackPanel>
                    <Border Grid.Column="2" Width="80" Height="22" CornerRadius="4" Style="{StaticResource SkeletonBox}" VerticalAlignment="Center" />
                </Grid>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Width="100" Height="12" HorizontalAlignment="Left" Style="{StaticResource SkeletonTextLine}" Margin="0" />
                    <Border Grid.Column="1" Width="160" Height="12" HorizontalAlignment="Left" Style="{StaticResource SkeletonTextLine}" Margin="0" />
                </Grid>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Width="90" Height="12" HorizontalAlignment="Left" Style="{StaticResource SkeletonTextLine}" Margin="0" />
                    <Border Grid.Column="1" Width="200" Height="12" HorizontalAlignment="Left" Style="{StaticResource SkeletonTextLine}" Margin="0" />
                </Grid>
            </StackPanel>
        </Border>
    </ControlTemplate>

