                </Grid>
            </Border>
            <Border Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /><ColumnDefinition Width="80" /></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="100" Height="12" HorizontalAlignment="Left" Style="{StaticResource SkeletonTextLine}" Margin="0" />
                    <StackPanel Grid.Column="1" Margin="10,0,10,0">
                        <Border Width="180" Height="14" HorizontalAlignment="Left" Style="{StaticResource SkeletonTextLine}" Margin="0,0,0,4" />
                        <Border Width="130" Height="10" HorizontalAlignment="Left" Style="{StaticResource SkeletonTextLine}" Margin="0" />
                    </StackPanel>
                    <Border Grid.Column="2" Width="60" Height="20" CornerRadius="4" Style="{StaticResource SkeletonBox}" HorizontalAlignment="Right" />
