<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- =========================================================================
         BlueDoc Design System - Loading, Skeleton, Empty & Error States
         Components: ProgressBar, Skeleton Controls, EmptyState, and ErrorState
         Smooth, restrained animations compatible with software-rendering
         ========================================================================= -->

    <!-- ==========================================
         MODERN PROGRESS BAR (Linear / Win11 Style)
         ========================================== -->
    <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="6" />
        <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border x:Name="Track"
                            Background="{TemplateBinding Background}"
                            CornerRadius="3"
                            ClipToBounds="True"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <!-- Determinate Indicator -->
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="3" />
                            <!-- Indeterminate Sliding Glow Indicator -->
                            <Border x:Name="IndeterminateGlow"
                                    Width="120"
                                    HorizontalAlignment="Left"
                                    Background="{DynamicResource AccentHoverBrush}"
                                    CornerRadius="3"
                                    Opacity="0" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Indeterminate Mode Animation -->
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="IndeterminateGlow" Property="Opacity" Value="0.9" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <ThicknessAnimation Storyboard.TargetName="IndeterminateGlow"
                                                            Storyboard.TargetProperty="Margin"
                                                            From="-120,0,0,0" To="400,0,0,0"
                                                            Duration="0:0:1.3" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==========================================
         SKELETON BASE PRIMITIVES
         ========================================== -->

    <!-- Base Pulsing Box with Clean Storyboard Lifetime -->
    <Style x:Key="SkeletonBox" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SkeletonBaseBrush}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Opacity" Value="0.5" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Style.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                         From="0.35" To="0.80"
                                         Duration="0:0:0.75" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Style.Triggers>
    </Style>

    <!-- Skeleton Simulated Text Line -->
    <Style x:Key="SkeletonTextLine" TargetType="Border" BasedOn="{StaticResource SkeletonBox}">
        <Setter Property="Height" Value="14" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <!-- Skeleton Simulated Avatar / Circle Icon -->
    <Style x:Key="SkeletonCircle" TargetType="Border" BasedOn="{StaticResource SkeletonBox}">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="CornerRadius" Value="18" />
    </Style>

    <!-- =========================================================================
         DEDICATED REUSABLE SKELETON CONTROLS (MATCHING EXACT COMPONENT DIMENSIONS)
         ========================================================================= -->

    <!-- 1. DEVICE CARD SKELETON (Matches Device Card: height 68px, avatar, lines, badge) -->
    <ControlTemplate x:Key="DeviceCardSkeletonTemplate">
        <Border Background="{DynamicResource SurfaceCardBrush}" 
                BorderBrush="{DynamicResource BorderBrush}" 
                BorderThickness="1" 
                CornerRadius="8" 
                Padding="12,10" 
                Margin="0,0,0,8" 
                SnapsToDevicePixels="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="38" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="80" />
                </Grid.ColumnDefinitions>

                <!-- Left stripe -->
                <Border Grid.Column="0" Width="4" CornerRadius="2" Style="{StaticResource SkeletonBox}" />
                <!-- Avatar placeholder -->
                <Border Grid.Column="2" Width="38" Height="38" CornerRadius="8" Style="{StaticResource SkeletonBox}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <!-- Text lines -->
                <StackPanel Grid.Column="3" Margin="10,0,10,0" VerticalAlignment="Center">
                    <Border Width="160" Height="14" HorizontalAlignment="Left" Style="{StaticResource SkeletonTextLine}" Margin="0,0,0,6" />
                    <Border Width="220" Height="11" HorizontalAlignment="Left" Style="{StaticResource SkeletonTextLine}" Margin="0" />
                </StackPanel>
                <!-- Status pill -->
                <Border Grid.Column="4" Width="70" Height="22" CornerRadius="4" Style="{StaticResource SkeletonBox}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </ControlTemplate>

    <!-- Multi-Item Device Cards Skeleton Stack -->
    <ControlTemplate x:Key="DeviceCardListSkeletonTemplate">
        <StackPanel>
            <Control Template="{StaticResource DeviceCardSkeletonTemplate}" />
            <Control Template="{StaticResource DeviceCardSkeletonTemplate}" />
            <Control Template="{StaticResource DeviceCardSkeletonTemplate}" />
            <Control Template="{StaticResource DeviceCardSkeletonTemplate}" />
        </StackPanel>
    </ControlTemplate>

    <!-- 2. DEVICE DETAIL PANEL SKELETON (Matches Inspector sheet: Header + 5 Telemetry Rows + Actions) -->
    <ControlTemplate x:Key="DeviceDetailSkeletonTemplate">
        <StackPanel Margin="4">
            <!-- Header Banner -->
            <Border Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="80" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10" Style="{StaticResource SkeletonBox}" />
                    <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                        <Border Width="160" Height="15" HorizontalAlignment="Left" Style="{StaticResource SkeletonTextLine}" Margin="0,0,0,6" />
                        <Border Width="100" Height="11" HorizontalAlignment="Left" Style="{StaticResource SkeletonTextLine}" Margin="0" />
                    </StackPanel>
                    <Border Grid.Column="2" Width="70" Height="24" CornerRadius="6" Style="{StaticResource SkeletonBox}" VerticalAlignment="Top" />
                </Grid>
            </Border>

            <!-- Telemetry Row Placeholders -->
            <Border Width="120" Height="12" HorizontalAlignment="Left" Style="{StaticResource SkeletonTextLine}" Margin="0,0,0,12" />
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Width="90" Height="12" HorizontalAlignment="Left" Style="{StaticResource SkeletonTextLine}" Margin="0" />
                <Border Grid.Column="1" Width="140" Height="12" HorizontalAlignment="Left" Style="{StaticResource SkeletonTextLine}" Margin="0" />
            </Grid>
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Width="80" Height="12" HorizontalAlignment="Left" Style="{StaticResource SkeletonTextLine}" Margin="0" />
                <Border Grid.Column="1" Width="120" Height="12" HorizontalAlignment="Left" Style="{StaticResource SkeletonTextLine}" Margin="0" />
            </Grid>
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Width="100" Height="12" HorizontalAlignment="Left" Style="{StaticResource SkeletonTextLine}" Margin="0" />
                <Border Grid.Column="1" Width="80" Height="12" HorizontalAlignment="Left" Style="{StaticResource SkeletonTextLine}" Margin="0" />
            </Grid>
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Width="70" Height="12" HorizontalAlignment="Left" Style="{StaticResource SkeletonTextLine}" Margin="0" />
                <Border Grid.Column="1" Width="200" Height="12" HorizontalAlignment="Left" Style="{StaticResource SkeletonTextLine}" Margin="0" />
            </Grid>

            <!-- Action Buttons Row -->
            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,6,0,16" />
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Height="34" CornerRadius="6" Style="{StaticResource SkeletonBox}" />
                <Border Grid.Column="2" Height="34" CornerRadius="6" Style="{StaticResource SkeletonBox}" />
            </Grid>
        </StackPanel>
    </ControlTemplate>

    <!-- 3. DASHBOARD STATISTICS SKELETON (Banner + 3 Metrics Grid) -->
