                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Height="60" CornerRadius="6" Style="{StaticResource SkeletonBox}" Margin="0,0,8,0" />
                        <Border Grid.Column="1" Height="60" CornerRadius="6" Style="{StaticResource SkeletonBox}" Margin="4,0,4,0" />
