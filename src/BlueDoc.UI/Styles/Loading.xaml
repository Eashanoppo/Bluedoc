                    <Border Grid.Column="2" Width="70" Height="14" Style="{StaticResource SkeletonTextLine}" Margin="0" />
                    <Border Grid.Column="3" Width="60" Height="20" CornerRadius="4" Style="{StaticResource SkeletonBox}" HorizontalAlignment="Right" />
                </Grid>
            </Border>
            <Border Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,6">
