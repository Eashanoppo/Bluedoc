<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- =========================================================================
         BlueDoc Design System - Card Component Library
         Components: CardPanel, InteractiveCard, DiagnosticCard, DeviceCard,
                     MetricCard, DialogCard, and Status Callout Banners
         ========================================================================= -->

    <!-- ==========================================
         BASE CARD PANEL (Compatible with all existing views)
         ========================================== -->
    <Style x:Key="CardPanel" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Margin" Value="0,0,0,16" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="CardBorderStyle" TargetType="Border" BasedOn="{StaticResource CardPanel}" />

    <!-- Compact / Dense Card Panel (for sidebars or dense telemetry grids) -->
    <Style x:Key="CardPanelDense" TargetType="Border" BasedOn="{StaticResource CardPanel}">
        <Setter Property="Padding" Value="12" />
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <!-- Spacious Card Panel (for major diagnostic lab sections) -->
    <Style x:Key="CardPanelSpacious" TargetType="Border" BasedOn="{StaticResource CardPanel}">
        <Setter Property="Padding" Value="20" />
        <Setter Property="Margin" Value="0,0,0,20" />
        <Setter Property="CornerRadius" Value="12" />
    </Style>

    <!-- ==========================================
         INTERACTIVE CARD (Hover Affirmation)
         ========================================== -->
    <Style x:Key="InteractiveCard" TargetType="Border" BasedOn="{StaticResource CardPanel}">
        <Setter Property="Cursor" Value="Hand" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource CardBgHoverBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ==========================================
         DIAGNOSTIC TEST / RESULT CARD
         ========================================== -->
    <Style x:Key="DiagnosticCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
                <Setter Property="Background" Value="{DynamicResource CardBgHoverBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ==========================================
         DEVICE CARD (List Item / Grid Card)
         ========================================== -->
    <Style x:Key="DeviceCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource CardBgHoverBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ==========================================
         METRIC SUMMARY CARD (Dashboard Stat Tile)
         ========================================== -->
    <Style x:Key="MetricCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="16,14" />
        <Setter Property="Margin" Value="0,0,12,0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ==========================================
         MODAL DIALOG CARD
         ========================================== -->
    <Style x:Key="DialogCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="24" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="MaxWidth" Value="560" />
    </Style>

    <!-- ==========================================
         STATUS CALLOUT BANNERS (Alerts / Notices)
         ========================================== -->
    <Style x:Key="StatusBannerBase" TargetType="Border">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="Margin" Value="0,0,0,14" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="StatusBannerInfo" TargetType="Border" BasedOn="{StaticResource StatusBannerBase}">
        <Setter Property="Background" Value="{DynamicResource InfoSubtleBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InfoBrush}" />
    </Style>

    <Style x:Key="StatusBannerSuccess" TargetType="Border" BasedOn="{StaticResource StatusBannerBase}">
        <Setter Property="Background" Value="{DynamicResource SuccessSubtleBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
    </Style>

    <Style x:Key="StatusBannerWarning" TargetType="Border" BasedOn="{StaticResource StatusBannerBase}">
        <Setter Property="Background" Value="{DynamicResource WarningSubtleBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
    </Style>

    <Style x:Key="StatusBannerDanger" TargetType="Border" BasedOn="{StaticResource StatusBannerBase}">
        <Setter Property="Background" Value="{DynamicResource DangerSubtleBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
    </Style>

    <!-- ==========================================
         GROUPED CARD CONTAINERS & DEVICE ROWS (macOS Settings / Linear Style)
         ========================================== -->
    <!-- Grouped Outer Card Container: clean white or dark surface, rounded corners, subtle border -->
    <Style x:Key="GroupedCardContainer" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Margin" Value="0,0,0,20" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Grouped Row Item (for Audio Devices, Peripherals, and Nearby Lists) -->
    <Style x:Key="GroupedDeviceRow" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="16,11" />
        <Setter Property="MinHeight" Value="52" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource CardBgHoverBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Grouped Section Header Label (e.g. "Audio Devices", "Peripherals", "Nearby Devices") -->
    <Style x:Key="GroupedSectionHeader" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI, sans-serif" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Margin" Value="4,0,0,8" />
    </Style>

</ResourceDictionary>

