<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:common="clr-namespace:BlueDoc.UI.Common">

    <common:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

    <!-- =========================================================================
         BlueDoc Design System - Navigation Components
         Styles: NavItemStyle (Expanded & Collapsed Sidebar), NavGroupContainer,
                 Breadcrumb Navigation, and Header Controls
         ========================================================================= -->

    <!-- ==========================================
         PRIMARY SIDEBAR NAVIGATION ITEM
         (Supports both Expanded & Collapsed Sidebar)
         ========================================== -->
    <Style x:Key="NavItemStyle" TargetType="RadioButton">
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, sans-serif" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Margin" Value="0,1.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=Content}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="7"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Vector Icon Tag (Centered) -->
                            <Path x:Name="navIcon"
                                  Grid.Column="0"
                                  Data="{TemplateBinding Tag}"
                                  Width="15" Height="15"
                                  Fill="{DynamicResource TextSecondaryBrush}"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />

                            <!-- Section Title Text (Hidden in Collapsed Mode) -->
                            <TextBlock x:Name="navText"
                                       Grid.Column="1"
                                       Text="{TemplateBinding Content}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       Margin="10,0,4,0"
                                       FontSize="12"
                                       TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}" />

                            <!-- Forward Chevron Indicator (Hidden in Collapsed Mode) -->
                            <Path x:Name="navArrow"
                                  Grid.Column="2"
                                  Data="{DynamicResource IconChevronRightPath}"
                                  Width="9" Height="9"
                                  Fill="{DynamicResource ArrowBrush}"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Right"
                                  Margin="2,0,2,0"
                                  Visibility="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Hover State -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource NavHoverBgBrush}" />
                            <Setter TargetName="navText" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            <Setter TargetName="navIcon" Property="Fill" Value="{DynamicResource AccentHoverBrush}" />
                            <Setter TargetName="navArrow" Property="Fill" Value="{DynamicResource TextPrimaryBrush}" />
                        </Trigger>
                        <!-- Active / Selected Section State -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource NavActiveBgBrush}" />
                            <Setter TargetName="navText" Property="Foreground" Value="{DynamicResource NavActiveTextBrush}" />
                            <Setter TargetName="navText" Property="FontWeight" Value="SemiBold" />
                            <Setter TargetName="navIcon" Property="Fill" Value="{DynamicResource NavActiveTextBrush}" />
                            <Setter TargetName="navArrow" Property="Fill" Value="{DynamicResource ArrowActiveBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==========================================
         SIDEBAR GROUP CONTAINER
         ========================================== -->
    <Style x:Key="NavGroupContainer" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource NavGroupBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="6,8" />
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Breadcrumb Separator Chevron -->
    <Style x:Key="BreadcrumbSeparator" TargetType="Path">
        <Setter Property="Data" Value="{DynamicResource IconChevronRightPath}" />
        <Setter Property="Width" Value="9" />
        <Setter Property="Height" Value="9" />
        <Setter Property="Fill" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="8,0" />
    </Style>

</ResourceDictionary>
