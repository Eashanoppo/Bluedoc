<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- =========================================================================
         BlueDoc Design System - Animation & Motion Tokens
         Restrained, professional motion for hardware diagnostic experience
         Zero GPU blur/heavy compute dependencies; 100% software-rendering safe
         ========================================================================= -->

    <!-- Reusable Easing Functions -->
    <QuadraticEase x:Key="EaseOutQuad" EasingMode="EaseOut" />
    <QuadraticEase x:Key="EaseInOutQuad" EasingMode="EaseInOut" />
    <CubicEase x:Key="EaseOutCubic" EasingMode="EaseOut" />

    <!-- 1. Page Fade In Animation (180ms) -->
    <Storyboard x:Key="PageFadeInStoryboard">
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         From="0.0" To="1.0"
                         Duration="0:0:0.180"
                         EasingFunction="{StaticResource EaseOutQuad}" />
    </Storyboard>

    <!-- 2. Content Slide and Fade Transition (180ms, 6px translateY) -->
    <Storyboard x:Key="ContentEnterStoryboard">
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         From="0.2" To="1.0"
                         Duration="0:0:0.180"
                         EasingFunction="{StaticResource EaseOutQuad}" />
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                         From="6.0" To="0.0"
                         Duration="0:0:0.180"
                         EasingFunction="{StaticResource EaseOutQuad}" />
    </Storyboard>

    <!-- 3. Sidebar Collapse & Expansion (180ms Width Transition) -->
    <Storyboard x:Key="SidebarExpandStoryboard">
        <DoubleAnimation Storyboard.TargetProperty="Width"
                         From="68.0" To="270.0"
                         Duration="0:0:0.180"
                         EasingFunction="{StaticResource EaseOutCubic}" />
    </Storyboard>
    <Storyboard x:Key="SidebarCollapseStoryboard">
        <DoubleAnimation Storyboard.TargetProperty="Width"
                         From="270.0" To="68.0"
                         Duration="0:0:0.180"
                         EasingFunction="{StaticResource EaseOutCubic}" />
    </Storyboard>

    <!-- 4. Device Card Selection & Highlight Transition (140ms) -->
    <Storyboard x:Key="CardSelectionStoryboard">
        <ColorAnimation Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                        Duration="0:0:0.140"
                        EasingFunction="{StaticResource EaseOutQuad}" />
    </Storyboard>

    <!-- 5. New Device Card Appearance (160ms scale & fade) -->
    <Storyboard x:Key="DeviceEntranceStoryboard">
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         From="0.0" To="1.0"
                         Duration="0:0:0.160"
                         EasingFunction="{StaticResource EaseOutQuad}" />
    </Storyboard>

    <!-- 6. Button Hover and Press Micro-Interactions (120ms) -->
    <Storyboard x:Key="ButtonHoverStoryboard">
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         To="0.92"
                         Duration="0:0:0.120" />
    </Storyboard>
    <Storyboard x:Key="ButtonPressedStoryboard">
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         To="0.80"
                         Duration="0:0:0.080" />
    </Storyboard>

    <!-- 7. Toast Notification Slide In & Out -->
    <Storyboard x:Key="ToastEnterStoryboard">
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         From="0.0" To="1.0"
                         Duration="0:0:0.160"
                         EasingFunction="{StaticResource EaseOutQuad}" />
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                         From="16.0" To="0.0"
                         Duration="0:0:0.160"
                         EasingFunction="{StaticResource EaseOutQuad}" />
    </Storyboard>
    <Storyboard x:Key="ToastExitStoryboard">
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         From="1.0" To="0.0"
                         Duration="0:0:0.140"
                         EasingFunction="{StaticResource EaseOutQuad}" />
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                         From="0.0" To="12.0"
                         Duration="0:0:0.140"
                         EasingFunction="{StaticResource EaseOutQuad}" />
    </Storyboard>

    <!-- 8. Success Feedback Pulse (220ms emerald highlight) -->
    <Storyboard x:Key="SuccessPulseStoryboard">
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         From="0.6" To="1.0"
                         Duration="0:0:0.220"
                         EasingFunction="{StaticResource EaseOutQuad}" />
    </Storyboard>

    <!-- 9. Error Shake / Alert Transition (200ms) -->
    <Storyboard x:Key="ErrorAlertStoryboard">
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         From="0.4" To="1.0"
                         Duration="0:0:0.200"
                         EasingFunction="{StaticResource EaseOutQuad}" />
    </Storyboard>

    <!-- 10. Indeterminate Spinner Loop -->
    <Storyboard x:Key="SpinnerRotateStoryboard" RepeatBehavior="Forever">
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                         From="0" To="360"
                         Duration="0:0:1.000" />
    </Storyboard>

</ResourceDictionary>
