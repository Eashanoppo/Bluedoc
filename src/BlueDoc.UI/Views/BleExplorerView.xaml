<UserControl x:Class="BlueDoc.UI.Views.BleExplorerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="950">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24,28,32">
            <!-- Header -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Bluetooth LE Explorer" Style="{StaticResource PageTitleText}" />
                    <TextBlock Text="Explore Bluetooth Low Energy peripherals, advertisement data, and GATT service structures." Style="{StaticResource PageSubtitleText}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Content="Scan for BLE Devices" Command="{Binding ScanBleDevicesCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" />
                    <Button Content="Export Profile" Command="{Binding ExportGattProfileCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" />
                    <Button Content="Refresh Paired BLE" Command="{Binding RefreshPairedBleCommand}" Style="{StaticResource SecondaryButton}" />
                </StackPanel>
            </Grid>

            <!-- Platform Capability Alert Banner -->
            <Border Background="#1C273C" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="ℹ️" FontSize="20" VerticalAlignment="Center" Margin="0,0,14,0" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="PLATFORM BLE CAPABILITY NOTICE" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text="{Binding PlatformNotice}" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- BLE Explorer Grid -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Column: BLE Device List -->
                <Border Grid.Column="0" Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="DETECTED BLE PERIPHERALS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,12" />

                        <ListBox ItemsSource="{Binding BleDevices}" SelectedItem="{Binding SelectedBleDevice}" Background="Transparent" BorderThickness="0" MaxHeight="480" ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1C273C" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding BluetoothAddress}" FontSize="11" FontFamily="Consolas" Foreground="{StaticResource AccentBrush}" Margin="0,2,0,4" />
                                            <Grid>
                                                <TextBlock Text="{Binding StatusDisplay}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                                <TextBlock Text="{Binding SignalStrengthDisplay}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Right Column: BLE Device & GATT Inspection -->
                <Border Grid.Column="2" Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="GATT SERVICE DEFINITIONS &amp; CHARACTERISTICS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,16" />

                        <StackPanel Visibility="{Binding SelectedBleDevice, Converter={StaticResource NullToVisibilityConverter}}">
                            <!-- Device Header Info -->
                            <Grid Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="{Binding SelectedBleDevice.DisplayName}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding SelectedBleDevice.BluetoothAddress, StringFormat='MAC: {0}'}" FontSize="12" FontFamily="Consolas" Foreground="{StaticResource AccentBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                                <Border Background="#1C273C" CornerRadius="4" Padding="10,4" HorizontalAlignment="Right" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding SelectedBleDevice.StatusDisplay}" FontSize="11" FontWeight="Bold" Foreground="#10B981" />
                                </Border>
                            </Grid>

                            <!-- GATT Service Tree / List -->
                            <TextBlock Text="EXPOSED GATT SERVICES" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8" Margin="0,0,0,8" />

                            <ItemsControl ItemsSource="{Binding GattServices}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#1C273C" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14,12" Margin="0,0,0,12">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,6">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" />
                                                    <TextBlock Text="{Binding Uuid}" FontSize="10" FontFamily="Consolas" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" />
                                                </Grid>
                                                <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10" />

                                                <!-- Characteristics Table inside Service -->
                                                <DataGrid ItemsSource="{Binding Characteristics}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" Background="#121A28" BorderThickness="0" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource BorderBrush}">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Characteristic" Binding="{Binding Name}" Width="150" />
                                                        <DataGridTextColumn Header="UUID" Binding="{Binding Uuid}" Width="75" />
                                                        <DataGridTextColumn Header="Properties" Binding="{Binding Properties}" Width="90" />
                                                        <DataGridTextColumn Header="Value / Status" Binding="{Binding ValueDisplay}" Width="*" />
                                                        
                                                        <!-- Actions Column: Read, Write, Notify -->
                                                        <DataGridTemplateColumn Header="Actions" Width="170">
                                                            <DataGridTemplateColumn.CellTemplate>
                                                                <DataTemplate>
                                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                        <Button Content="Read" Command="{Binding DataContext.ReadCharacteristicCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButton}" Padding="6,2" Margin="0,0,4,0" Visibility="{Binding CanRead, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                        <Button Content="Write" Command="{Binding DataContext.SafeWriteCharacteristicCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButton}" Padding="6,2" Margin="0,0,4,0" Visibility="{Binding CanWrite, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                        <Button Content="{Binding NotifyButtonText}" Command="{Binding DataContext.ToggleNotifyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButton}" Padding="6,2" Visibility="{Binding CanNotify, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </DataGridTemplateColumn.CellTemplate>
                                                        </DataGridTemplateColumn>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Background="#0F172A" CornerRadius="6" Padding="12" Margin="0,4,0,0">
                                <TextBlock Text="Safe GATT Operation Rule: Writing data to BLE characteristics is gated by permission checks and explicit user confirmation. BlueDoc strictly adheres to Section 15 safety policies." FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
