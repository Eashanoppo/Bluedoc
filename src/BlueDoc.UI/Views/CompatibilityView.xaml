<UserControl x:Class="BlueDoc.UI.Views.CompatibilityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="950">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24,28,32">
            <!-- Header -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Platform Compatibility Checker" Style="{StaticResource PageTitleText}" />
                    <TextBlock Text="Evaluates operating system version, hardware stack, and Bluetooth subsystem capabilities." Style="{StaticResource PageSubtitleText}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Content="Copy Summary" Command="{Binding CopyReportCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" />
                    <Button Content="Export Report" Command="{Binding ExportReportCommand}" Style="{StaticResource PrimaryButton}" />
                </StackPanel>
            </Grid>

            <!-- Overall Verdict Banner -->
            <Border Background="#1C273C" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18,14" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="COMPATIBILITY EVALUATION VERDICT" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Text="{Binding OverallVerdict}" FontSize="16" FontWeight="Bold" Foreground="{Binding VerdictColor}" Margin="0,4,0,4" />
                        <TextBlock Text="{Binding GuidanceNotes}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- OS Info Card -->
            <Border Style="{StaticResource CardPanel}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="OPERATING SYSTEM PROFILE" Style="{StaticResource CardHeaderTitle}" Margin="0,0,0,4" />
                    <TextBlock Text="Actual runtime OS version retrieved via low-level kernel query (ntdll!RtlGetVersion)." Style="{StaticResource CardSubtitle}" Margin="0,0,0,16" />

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Operating System" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding OsVersion.OperatingSystemName}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Build Number" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding OsVersion.BuildNumber}" FontFamily="Consolas, Courier New" Foreground="{StaticResource TextPrimaryBrush}" />
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="System Architecture" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding OsVersion.ArchitectureDisplay}" Foreground="{StaticResource TextPrimaryBrush}" />
                    </Grid>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Primary Adapter" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding PrimaryAdapter.FriendlyName, FallbackValue='Realtek Bluetooth Adapter'}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- API Support Checklist -->
            <Border Style="{StaticResource CardPanel}">
                <StackPanel>
                    <TextBlock Text="SUBSYSTEM &amp; API READINESS MATRIX" Style="{StaticResource CardHeaderTitle}" Margin="0,0,0,4" />
                    <TextBlock Text="Verification of supported low-level subsystems, driver stacks, and Windows APIs." Style="{StaticResource CardSubtitle}" Margin="0,0,0,16" />

                    <ItemsControl ItemsSource="{Binding Subsystems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1C273C" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14,12" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" />
                                            <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,2" />
                                            <TextBlock Text="{Binding Details}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="{Binding StatusColor}" CornerRadius="4" Padding="10,4" VerticalAlignment="Center" Margin="12,0,0,0">
                                            <TextBlock Text="{Binding StatusDisplay}" FontSize="10" FontWeight="Bold" Foreground="White" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
