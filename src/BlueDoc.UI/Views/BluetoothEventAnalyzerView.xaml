<UserControl x:Class="BlueDoc.UI.Views.BluetoothEventAnalyzerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1050">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24,28,32">
            <!-- Header -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Bluetooth Event Analyzer" Style="{StaticResource PageTitleText}" />
                    <TextBlock Text="Retrieves and interprets Windows System Event logs (BTHUSB, bthserv, BLE) with root-cause correlation." Style="{StaticResource PageSubtitleText}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Content="Export Audit Log" Command="{Binding ExportAuditLogCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" />
                    <Button Content="Refresh Logs" Command="{Binding RefreshCommand}" Style="{StaticResource PrimaryButton}" />
                </StackPanel>
            </Grid>

            <!-- SKELETON LOADING STATE -->
            <Control Template="{StaticResource EventLogTableSkeletonTemplate}" 
                     Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" 
                     Margin="0,0,0,20" />

            <!-- LIVE EVENT ANALYZER CONTENT -->
            <StackPanel Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter='Inverse'}">
                
                <!-- Diagnostic Correlation Banner -->
                <Border Background="{DynamicResource AccentSubtleBrush}" 
                        BorderBrush="{DynamicResource AccentBrush}" 
                        BorderThickness="1" 
                        CornerRadius="8" 
                        Padding="16,14" 
                        Margin="0,0,0,20" 
                        Visibility="{Binding CorrelationResult, Converter={StaticResource NullToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource AccentBrush}" Width="36" Height="36" CornerRadius="18" Margin="0,0,16,0" VerticalAlignment="Center">
                            <TextBlock Text="🔍" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CorrelationResult.Title}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding CorrelationResult.Summary}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,4" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding CorrelationResult.RecommendedNextStep, StringFormat='Recommended Step: {0}'}" FontSize="12" Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Metric Summary Cards -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18,14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                                <Border Background="{DynamicResource DangerSubtleBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                    <TextBlock Text="CRITICAL / ERRORS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding ErrorCount}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18,14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                                <Border Background="{DynamicResource WarningSubtleBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                    <TextBlock Text="WARNINGS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding WarningCount}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18,14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                                <Border Background="{DynamicResource AccentSubtleBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                    <TextBlock Text="OPERATIONAL / INFO" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding InfoCount}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Search and Filter Bar -->
                <Border Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding SearchFilter, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource FilterTextBox}" 
                                 Height="36" 
                                 VerticalContentAlignment="Center" 
                                 Padding="10,0" />
                        <ComboBox Grid.Column="2" 
                                  SelectedValue="{Binding SelectedSeverity}" 
                                  SelectedValuePath="Content" 
                                  Height="36" 
                                  VerticalContentAlignment="Center">
                            <ComboBoxItem Content="All" IsSelected="True" />
                            <ComboBoxItem Content="Error" />
                            <ComboBoxItem Content="Warning" />
                            <ComboBoxItem Content="Information" />
                        </ComboBox>
                    </Grid>
                </Border>

                <!-- Events List and Detail View -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="440" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left Column: Filtered Events List -->
                    <Border Grid.Column="0" Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="EVENT LOG ENTRIES" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding FilteredEvents.Count, StringFormat='{}{0} events'}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>

                            <!-- Empty state if 0 events -->
                            <Border Background="{DynamicResource SurfaceSunkenBrush}" CornerRadius="6" Padding="20" Margin="0,4,0,0"
                                    Visibility="{Binding FilteredEvents.Count, Converter={StaticResource CountToVisibilityConverter}, ConverterParameter='Inverse'}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="✓" FontSize="24" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Center" Margin="0,0,0,8" />
                                    <TextBlock Text="No matching Bluetooth events found" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="Windows has recorded no matching driver or service events for this filter." FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <ListBox ItemsSource="{Binding FilteredEvents}" 
                                     SelectedItem="{Binding SelectedEvent}" 
                                     Background="Transparent" 
                                     BorderThickness="0" 
                                     MaxHeight="480" 
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource SurfaceElevatedBrush}" 
                                                BorderBrush="{DynamicResource BorderSubtleBrush}" 
                                                BorderThickness="1" 
                                                CornerRadius="6" 
                                                Padding="12,10" 
                                                Margin="0,0,0,8">
                                            <StackPanel>
                                                <Grid>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding SeverityIcon}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding ProviderName}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                        <TextBlock Text="{Binding EventId, StringFormat=' (ID {0})'}" Foreground="{DynamicResource TextMutedBrush}" />
                                                    </StackPanel>
                                                    <Border Background="{DynamicResource AccentSubtleBrush}" CornerRadius="10" Padding="8,2" HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding OccurrenceCount, StringFormat='x{0}'}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AccentBrush}" />
                                                    </Border>
                                                </Grid>
                                                <TextBlock Text="{Binding HumanAnalysis}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,2" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding LocalTimeDisplay}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>

                    <!-- Right Column: Detail Inspector -->
                    <Border Grid.Column="2" Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <TextBlock Text="EVENT TECHNICAL INTERPRETATION" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                <Button Content="Copy Details" Command="{Binding CopyEventDetailsCommand}" Style="{StaticResource SecondaryButton}" Padding="10,4" HorizontalAlignment="Right" />
                            </Grid>

                            <!-- Placeholder when no event selected -->
                            <Border Background="{DynamicResource SurfaceSunkenBrush}" CornerRadius="6" Padding="24"
                                    Visibility="{Binding SelectedEvent, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter='Inverse'}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="Select an event from the list to view detailed technical interpretation and root-cause analysis." FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <StackPanel Visibility="{Binding SelectedEvent, Converter={StaticResource NullToVisibilityConverter}}">
                                <TextBlock Text="{Binding SelectedEvent.HumanAnalysis}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,14" />

                                <Border Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1,0,0,0" CornerRadius="0,6,6,0" Padding="14" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="POSSIBLE CAUSE" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}" Margin="0,0,0,4" />
                                        <TextBlock Text="{Binding SelectedEvent.PossibleCause}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <Border Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource SuccessBrush}" BorderThickness="1,0,0,0" CornerRadius="0,6,6,0" Padding="14" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="RECOMMENDED TROUBLESHOOTING" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,0,4" />
                                        <TextBlock Text="{Binding SelectedEvent.RecommendedTroubleshooting}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="RAW SYSTEM MESSAGE" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6" />
                                <TextBox Text="{Binding SelectedEvent.RawMessage, Mode=OneWay}" 
                                         Background="{DynamicResource SurfaceSunkenBrush}" 
                                         Foreground="{DynamicResource TextSecondaryBrush}" 
                                         BorderBrush="{DynamicResource BorderSubtleBrush}"
                                         FontFamily="Consolas" 
                                         FontSize="11" 
                                         Padding="10" 
                                         IsReadOnly="True" 
                                         TextWrapping="Wrap" 
                                         Height="100" 
                                         VerticalScrollBarVisibility="Auto" />

                                <Border Background="{DynamicResource SurfaceSunkenBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,14,0,0">
                                    <TextBlock Text="Section 15 Policy: Windows event logs record driver telemetry and bus timeouts. Never interpret an event record as conclusive proof of physical hardware damage." FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
