<UserControl x:Class="BlueDoc.UI.Views.DeviceScannerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="950">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24,28,32">
            <!-- Header Row -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Bluetooth Device Scanner" Style="{StaticResource PageTitleText}" />
                    <TextBlock Text="Active Classic radio inquiry and Plug-and-Play device discovery across supported Windows stacks." Style="{StaticResource PageSubtitleText}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Content="Clear" Command="{Binding ClearCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" />
                    <Button Content="{Binding ScanButtonText}" Command="{Binding ToggleScanCommand}" Style="{StaticResource PrimaryButton}" />
                </StackPanel>
            </Grid>

            <!-- Scanner Control & Status Bar -->
            <Border Background="#121A28" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Scanning Indicator -->
                    <Border Width="10" Height="10" CornerRadius="5" Background="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,12,0"
                            Visibility="{Binding IsScanning, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusMessage}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding ElapsedDisplay}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"
                                   Visibility="{Binding IsScanning, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>

                    <Border Grid.Column="2" Background="#1C273C" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="10,4" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DiscoveredDevices.Count, StringFormat='{}{0} Device(s) Discovered'}" FontSize="11" FontWeight="SemiBold" Foreground="#60A5FA" />
                    </Border>
                </Grid>
            </Border>

            <!-- Filter Buttons Bar -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Button Content="All Devices" Command="{Binding FilterCommand}" CommandParameter="All" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Padding="12,5" FontSize="12" />
                <Button Content="Audio / Headphones" Command="{Binding FilterCommand}" CommandParameter="Audio" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Padding="12,5" FontSize="12" />
                <Button Content="Peripherals (Mouse/Keyboard)" Command="{Binding FilterCommand}" CommandParameter="Peripherals" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Padding="12,5" FontSize="12" />
                <Button Content="Phones &amp; PCs" Command="{Binding FilterCommand}" CommandParameter="Phones/PCs" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Padding="12,5" FontSize="12" />
                <Button Content="Paired Only" Command="{Binding FilterCommand}" CommandParameter="Paired" Style="{StaticResource SecondaryButton}" Padding="12,5" FontSize="12" />
            </StackPanel>

            <!-- Main Discovered Devices & Detail Grid -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="420" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Column: Devices List -->
                <Border Grid.Column="0" Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="DISCOVERED BLUETOOTH DEVICES" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,12" />

                        <ListBox ItemsSource="{Binding FilteredDevices}" SelectedItem="{Binding SelectedDevice}" Background="Transparent" BorderThickness="0" MaxHeight="480">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1C273C" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="38" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Category Icon Pill -->
                                            <Border Grid.Column="0" Width="30" Height="30" CornerRadius="6" Background="#101726" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding CategoryIcon}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>

                                            <!-- Name & Address -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,8,0">
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding BluetoothAddress}" FontFamily="Consolas, Courier New" FontSize="11" Foreground="#60A5FA" Margin="0,2,0,0" />
                                                <TextBlock Text="{Binding CategoryName}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                            </StackPanel>

                                            <!-- Status & Type Badge -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Right" Margin="0,0,0,4">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#334155" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource SuccessBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsPaired}" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding StatusDisplay}" FontSize="10" FontWeight="Bold" Foreground="White" />
                                                </Border>
                                                <TextBlock Text="{Binding DeviceType}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Text="Select any discovered device to inspect technical Bluetooth properties." FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Right Column: Selected Device Property Sheet -->
                <Border Grid.Column="2" Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="DEVICE TECHNICAL INSPECTOR" Style="{StaticResource CardHeaderTitle}" Margin="0,0,0,4" />
                        <TextBlock Text="Hardware MAC address, Class of Device (CoD), and Windows pairing status." Style="{StaticResource CardSubtitle}" Margin="0,0,0,16" />

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Device Name" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding SelectedDevice.DisplayName, FallbackValue='Select a device'}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Bluetooth Address (MAC)" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding SelectedDevice.BluetoothAddress, FallbackValue='None'}" FontFamily="Consolas, Courier New" Foreground="#60A5FA" />
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Category" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding SelectedDevice.CategoryName, FallbackValue='Unknown'}" Foreground="{StaticResource TextPrimaryBrush}" />
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Device Type" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding SelectedDevice.DeviceType, FallbackValue='Unknown'}" Foreground="{StaticResource TextPrimaryBrush}" />
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Pairing Status" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding SelectedDevice.IsPaired, StringFormat='Paired: {0}', FallbackValue='No'}" Foreground="{StaticResource TextSecondaryBrush}" />
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Connection State" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding SelectedDevice.StatusDisplay, FallbackValue='Offline'}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Class of Device (CoD)" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding SelectedDevice.DeviceClass, StringFormat='0x{0:X6}', FallbackValue='0x000000'}" FontFamily="Consolas, Courier New" Foreground="{StaticResource TextSecondaryBrush}" />
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Signal Strength (RSSI)" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding SelectedDevice.SignalStrengthDisplay, FallbackValue='Signal not exposed'}" Foreground="{StaticResource TextSecondaryBrush}" />
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="PnP Instance ID" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding SelectedDevice.InstanceId, FallbackValue='N/A (Discovered via Inquiry)'}" FontFamily="Consolas, Courier New" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
                        </Grid>

                        <Separator Background="{StaticResource BorderBrush}" Margin="0,10,0,16" />

                        <!-- Quick Actions -->
                        <TextBlock Text="DEVICE ACTIONS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,10" />
                        <Button Content="Pair / Manage in Windows" Command="{Binding PairWithDeviceCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>

