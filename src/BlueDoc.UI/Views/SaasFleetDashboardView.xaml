<UserControl x:Class="BlueDoc.UI.Views.SaasFleetDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="1100">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24,28,32">
            <!-- Header -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Enterprise SaaS Fleet Portal" Style="{StaticResource PageTitleText}" />
                    <TextBlock Text="Distinguish local machine diagnostics from centralized enterprise cloud fleet telemetry and tenant policies." 
                               Style="{StaticResource PageSubtitleText}" Margin="0,4,0,0" />
                </StackPanel>

                <!-- Status Badge -->
                <Border Grid.Column="1" Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,6" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="Enterprise Cloud Fleet Engine" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="12" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- SECTION A: LOCAL MACHINE DIAGNOSTICS vs CLOUD TENANT SPLIT CARDS -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Card 1: Local Machine Diagnostics Summary -->
                <Border Grid.Column="0" Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Background="{DynamicResource AccentSubtleBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                <TextBlock Text="LOCAL MACHINE DIAGNOSTICS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                            </Border>
                            <TextBlock Text="{Binding LocalMachineHostname}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Text="Diagnostics and repairs run strictly in local user-space with zero external telemetry by default." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,14" />

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="PENDING TELEMETRY" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Text="{Binding PendingTelemetryCount, StringFormat='{}{0} packets'}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="LOCAL AGENT STATUS" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Text="Active &amp; Ready" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>

                        <Button Content="Push Local Telemetry to Fleet" Command="{Binding IngestLocalMachineTelemetryCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Padding="18,6" />
                    </StackPanel>
                </Border>

                <!-- Card 2: Cloud Fleet Tenant Connection -->
                <Border Grid.Column="2" Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Background="{DynamicResource SurfaceElevatedBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                <TextBlock Text="CLOUD FLEET TENANT" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                            </Border>
                            <TextBlock Text="{Binding TenantId}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Text="{Binding GatewayStatusDisplay}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,14" />

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="API ENDPOINT" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Text="{Binding CloudEndpointUrl}" FontSize="11" FontFamily="Consolas" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="API STATUS" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Text="Verified Live" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="Refresh Fleet" Command="{Binding RefreshFleetCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Padding="14,6" />
                            <Button Content="Toggle Enterprise Gateway" Command="{Binding ToggleGatewayCommand}" Style="{StaticResource SecondaryButton}" Padding="14,6" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- SECTION B: TOP FLEET METRICS BANNER (6 Cards) -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Card 1: Total Endpoints -->
                <Border Grid.Column="0" Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="MANAGED ENDPOINTS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBlock Text="{Binding Metrics.TotalEndpoints}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,0" />
                        <TextBlock Text="Active in Cloud" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Card 2: Healthy -->
                <Border Grid.Column="1" Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="HEALTHY ENDPOINTS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" />
                        <TextBlock Text="{Binding Metrics.HealthyCount}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" Margin="0,4,0,0" />
                        <TextBlock Text="100% Tests Passing" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Card 3: Warning -->
                <Border Grid.Column="2" Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="WARNING NOTICES" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" />
                        <TextBlock Text="{Binding Metrics.WarningCount}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" Margin="0,4,0,0" />
                        <TextBlock Text="Non-Fatal Issues" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Card 4: Critical -->
                <Border Grid.Column="3" Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="CRITICAL OUTAGES" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" />
                        <TextBlock Text="{Binding Metrics.CriticalCount}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" Margin="0,4,0,0" />
                        <TextBlock Text="Hardware / Service Halt" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Card 5: Fleet Avg Score -->
                <Border Grid.Column="4" Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="FLEET BENCHMARK" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Text="{Binding Metrics.FleetAverageScore, StringFormat={}{0:F1}}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,4,0,0" />
                        <TextBlock Text="Avg Score / 100" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Card 6: Compliance Rate -->
                <Border Grid.Column="5" Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                    <StackPanel>
                        <TextBlock Text="FLEET COMPLIANCE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Text="{Binding Metrics.CompliancePercentage, StringFormat={}{0:F1}%}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,4,0,0" />
                        <TextBlock Text="Policy Compliant" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- SECTION C: FLEET MACHINE AUDIT TABLE -->
            <Border Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18">
                <StackPanel>
                    <!-- Search & Filter Controls -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Search -->
                        <TextBox Grid.Column="0" Text="{Binding SearchFilter, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource FilterTextBox}" Height="36" VerticalContentAlignment="Center" Padding="10,0" />

                        <!-- Status Filter Chips -->
                        <ItemsControl Grid.Column="1" ItemsSource="{Binding StatusFilters}" Margin="14,0,0,0" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding}" Command="{Binding DataContext.SelectStatusCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" Margin="0,0,6,0" Padding="12,4" 
                                            Style="{StaticResource SecondaryButton}" FontSize="11" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <!-- Fleet Machines Table -->
                    <DataGrid ItemsSource="{Binding FilteredMachines}" SelectedItem="{Binding SelectedMachine}" 
                              AutoGenerateColumns="False" IsReadOnly="True"
                              Background="Transparent" BorderThickness="0" 
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource BorderSubtleBrush}" 
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                              MaxHeight="400" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="HOSTNAME" Binding="{Binding Hostname}" Width="140" />
                            <DataGridTextColumn Header="DEPARTMENT" Binding="{Binding Department}" Width="100" />
                            <DataGridTextColumn Header="OPERATING SYSTEM" Binding="{Binding OperatingSystem}" Width="120" />
                            <DataGridTextColumn Header="ADAPTER NAME" Binding="{Binding PrimaryAdapter}" Width="*" />
                            <DataGridTextColumn Header="MANUFACTURER" Binding="{Binding ChipsetManufacturer}" Width="110" />
                            <DataGridTextColumn Header="SCORE" Binding="{Binding BenchmarkScore, StringFormat={}{0:F1}}" Width="70" />
                            <DataGridTextColumn Header="STATUS" Binding="{Binding HealthStatus}" Width="90" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
