<UserControl x:Class="BlueDoc.UI.Views.SaasFleetDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="950" d:DesignWidth="1100">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24,28,32">

            <!-- ══ HEADER ══════════════════════════════════════════════════════ -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Fleet Management Portal" Style="{StaticResource PageTitleText}" />
                    <TextBlock Text="Centralized enterprise Bluetooth fleet telemetry, health monitoring, and active alert triage."
                               Style="{StaticResource PageSubtitleText}" Margin="0,4,0,0" />
                </StackPanel>

                <!-- Cloud Connection Status Badge -->
                <Border Grid.Column="1" Background="{DynamicResource SurfaceElevatedBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="14,8" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="10" Height="10" CornerRadius="5" VerticalAlignment="Center" Margin="0,0,8,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConfigured}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                        <TextBlock Text="{Binding StatusMessage}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" MaxWidth="400"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ══ PENDING OFFLINE QUEUE NOTICE ════════════════════════════════ -->
            <Border Background="{DynamicResource WarningSubtleBrush}" CornerRadius="8" Padding="14,10"
                    Margin="0,0,0,16"
                    Visibility="{Binding PendingQueueCount, Converter={StaticResource NonZeroToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Foreground="{DynamicResource WarningBrush}" FontSize="13" VerticalAlignment="Center">
                        <Run Text="⚠ " FontWeight="Bold" />
                        <Run Text="{Binding PendingQueueCount}" FontWeight="Bold" />
                        <Run Text=" diagnostic payloads are safely preserved in the local SQLite offline queue and will be uploaded automatically when cloud connectivity is established." />
                    </TextBlock>
                    <Button Grid.Column="1" Command="{Binding SyncNowCommand}" Style="{StaticResource SecondaryButton}" Padding="12,4" Margin="10,0,0,0">
                        <TextBlock Text="Retry Sync Now" />
                    </Button>
                </Grid>
            </Border>

            <!-- ══ FLEET METRICS (4 KPI Cards) ════════════════════════════════ -->
            <UniformGrid Rows="1" Columns="4" Margin="0,0,0,20">
                <Border Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="{Binding Metrics.TotalEndpoints}" FontSize="32" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Text="TOTAL ENDPOINTS" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
                        <TextBlock Text="Enrolled Windows Machines" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="{Binding Metrics.HealthyCount}" FontSize="32" FontWeight="Bold"
                                   Foreground="{DynamicResource SuccessBrush}" />
                        <TextBlock Text="HEALTHY" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
                        <TextBlock Text="All Diagnostics Passing" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="{Binding Metrics.WarningCount}" FontSize="32" FontWeight="Bold"
                                   Foreground="{DynamicResource WarningBrush}" />
                        <TextBlock Text="WARNING" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
                        <TextBlock Text="Subsystem Degradation" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="18">
                    <StackPanel>
                        <TextBlock Text="{Binding Metrics.CriticalCount}" FontSize="32" FontWeight="Bold"
                                   Foreground="{DynamicResource DangerBrush}" />
                        <TextBlock Text="CRITICAL" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
                        <TextBlock Text="Hardware or Radio Failure" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- ══ FILTER & ACTION TOOLBAR ═════════════════════════════════════ -->
            <Border Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" Text="{Binding SearchFilter, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,10,0" Padding="10,6" VerticalContentAlignment="Center"
                             Background="{DynamicResource SurfaceElevatedBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{DynamicResource BorderBrush}" />

                    <ComboBox Grid.Column="1" ItemsSource="{Binding Departments}"
                              SelectedItem="{Binding SelectedDepartment}" Margin="0,0,10,0"
                              VerticalContentAlignment="Center" />

                    <ComboBox Grid.Column="2" ItemsSource="{Binding StatusFilters}"
                              SelectedItem="{Binding SelectedStatusFilter}" Margin="0,0,10,0"
                              VerticalContentAlignment="Center" />

                    <Button Grid.Column="3" Command="{Binding RefreshFleetCommand}"
                            Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Padding="14,6">
                        <TextBlock Text="↻ Refresh Fleet" />
                    </Button>

                    <Button Grid.Column="4" Command="{Binding SyncNowCommand}"
                            Style="{StaticResource PrimaryButton}" Padding="16,6">
                        <TextBlock Text="{Binding IsSyncing,
                            Converter={StaticResource BoolToStringConverter},
                            ConverterParameter='Diagnosing &amp; Syncing…|⬆ Transmit Telemetry'}" />
                    </Button>
                </Grid>
            </Border>

            <!-- ══ MACHINE DATA GRID ═══════════════════════════════════════════ -->
            <Border Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="0" Margin="0,0,0,20">
                <DataGrid ItemsSource="{Binding FilteredMachines}"
                          SelectedItem="{Binding SelectedMachine}"
                          AutoGenerateColumns="False" CanUserAddRows="False"
                          GridLinesVisibility="Horizontal" RowHeight="42"
                          HeadersVisibility="Column" IsReadOnly="True"
                          Background="Transparent" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Hostname" Binding="{Binding Hostname}" Width="150" />
                        <DataGridTextColumn Header="Department" Binding="{Binding Department}" Width="110" />
                        <DataGridTextColumn Header="OS" Binding="{Binding OperatingSystem}" Width="140" />
                        <DataGridTextColumn Header="Primary Adapter" Binding="{Binding PrimaryAdapter}" Width="*" />
                        <DataGridTextColumn Header="Driver Version" Binding="{Binding DriverVersion}" Width="120" />
                        <DataGridTextColumn Header="Score" Binding="{Binding BenchmarkScore, StringFormat='{}{0:F1}'}" Width="70" />
                        <DataGridTemplateColumn Header="Health Status" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="4" Padding="8,3" HorizontalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource SuccessSubtleBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HealthStatus}" Value="Warning">
                                                        <Setter Property="Background" Value="{DynamicResource WarningSubtleBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding HealthStatus}" Value="Critical">
                                                        <Setter Property="Background" Value="{DynamicResource DangerSubtleBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding HealthStatus}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Last Heartbeat" Binding="{Binding LocalHeartbeatDisplay}" Width="150" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- ══ ACTIVE ALERTS PANEL ═════════════════════════════════════════ -->
            <Expander Header="{Binding Alerts.UnacknowledgedCount, StringFormat='⚠ Active Fleet Alerts ({0})'}"
                      IsExpanded="{Binding Alerts.UnacknowledgedCount, Converter={StaticResource NonZeroToBoolConverter}}"
                      Margin="0,0,0,20">
                <ItemsControl ItemsSource="{Binding Alerts.Alerts}" Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource SurfaceCardBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="6" CornerRadius="3" Margin="0,0,12,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Severity}" Value="Critical">
                                                        <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Hostname, StringFormat='[{0}] '}" FontWeight="Bold"
                                                       Foreground="{DynamicResource AccentBrush}" FontSize="13" />
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Detail}" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="Acknowledge"
                                            Command="{Binding DataContext.AcknowledgeAlertCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding AlertId}"
                                            Style="{StaticResource SecondaryButton}" Margin="12,0,0,0" Padding="10,4" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Expander>

            <!-- ══ CREDENTIAL CONFIGURATION & TENANT ONBOARDING ════════════════ -->
            <Expander Header="⚙ Cloud Connection &amp; Enterprise Tenant Setup"
                      IsExpanded="{Binding IsConfigured, Mode=OneWay, Converter={StaticResource InverseBooleanConverter}}">
                <Border Background="{DynamicResource SurfaceCardBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,8,0,0">
                    <StackPanel>

                        <!-- Existing Tenant Setup -->
                        <TextBlock Text="Connect this Machine to BlueDoc Cloud" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16" />
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Cloud Endpoint URL"
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding EndpointUrl, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8,5" Background="{DynamicResource SurfaceElevatedBrush}"
                                     Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Tenant ID (UUID/Slug)"
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding TenantId, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8,5" Background="{DynamicResource SurfaceElevatedBrush}"
                                     Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="API Key (Bearer Token)"
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8,5" Background="{DynamicResource SurfaceElevatedBrush}"
                                     Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}" />

                            <CheckBox Grid.Row="6" Grid.Column="1" IsChecked="{Binding AutoSyncEnabled}"
                                      Content="Enable automatic periodic background telemetry sync"
                                      Foreground="{DynamicResource TextPrimaryBrush}" />

                            <StackPanel Grid.Row="8" Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="Sync telemetry every " Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
                                <TextBox Text="{Binding SyncIntervalMinutes}" Width="50" Margin="6,0" Padding="4,2"
                                         Background="{DynamicResource SurfaceElevatedBrush}" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="minutes" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <Button Command="{Binding SaveCredentialsCommand}" Style="{StaticResource PrimaryButton}"
                                Margin="0,10,0,20" HorizontalAlignment="Left" Padding="18,6">
                            <TextBlock Text="💾  Save &amp; Test Cloud Connection" />
                        </Button>

                        <!-- New Tenant Registration -->
                        <Separator Margin="0,0,0,16" Background="{DynamicResource BorderBrush}" />
                        <TextBlock Text="New to BlueDoc Cloud? Register Your Organization"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12" />

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Organization Name"
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding RegOrgName, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8,5" Background="{DynamicResource SurfaceElevatedBrush}"
                                     Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Admin Email"
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding RegAdminEmail, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8,5" Background="{DynamicResource SurfaceElevatedBrush}"
                                     Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Service Tier / Plan"
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="4" Grid.Column="1" SelectedValue="{Binding RegPlan}"
                                      SelectedValuePath="Content" HorizontalAlignment="Left" Width="180">
                                <ComboBoxItem Content="free" IsSelected="True" />
                                <ComboBoxItem Content="pro" />
                                <ComboBoxItem Content="enterprise" />
                            </ComboBox>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Command="{Binding RegisterTenantCommand}" Style="{StaticResource PrimaryButton}"
                                    HorizontalAlignment="Left" Padding="18,6">
                                <TextBlock Text="🌐  Register Organization" />
                            </Button>
                            <TextBlock Text="{Binding RegStatus}" Margin="16,0,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                                       VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="500" />
                        </StackPanel>

                    </StackPanel>
                </Border>
            </Expander>

        </StackPanel>
    </ScrollViewer>
</UserControl>
