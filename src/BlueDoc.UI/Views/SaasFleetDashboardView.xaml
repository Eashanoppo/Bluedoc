<UserControl x:Class="BlueDoc.UI.Views.SaasFleetDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1100">

    <Grid Background="{DynamicResource BgDarkBrush}" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Enterprise SaaS Fleet Cloud Portal" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="Centralized fleet diagnostics, live endpoint telemetry ingestion, cloud compliance enforcement, and automated health synchronization." 
                               FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
                </StackPanel>

                <!-- Status Badge -->
                <Border Grid.Column="1" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,6" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="8" Height="8" CornerRadius="4" Background="#10B981" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="Production SaaS Fleet Engine" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="12" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Top Metrics Banner (6 Cards) -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Card 1: Total Endpoints -->
            <Border Grid.Column="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="MANAGED ENDPOINTS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBlock Text="{Binding Metrics.TotalEndpoints}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,0" />
                    <TextBlock Text="Active in Cloud" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
            </Border>

            <!-- Card 2: Healthy -->
            <Border Grid.Column="1" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="HEALTHY ENDPOINTS" FontSize="10" FontWeight="Bold" Foreground="#10B981" />
                    <TextBlock Text="{Binding Metrics.HealthyCount}" FontSize="24" FontWeight="Bold" Foreground="#10B981" Margin="0,4,0,0" />
                    <TextBlock Text="100% Tests Passing" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
            </Border>

            <!-- Card 3: Warning -->
            <Border Grid.Column="2" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="WARNING NOTICES" FontSize="10" FontWeight="Bold" Foreground="#F59E0B" />
                    <TextBlock Text="{Binding Metrics.WarningCount}" FontSize="24" FontWeight="Bold" Foreground="#F59E0B" Margin="0,4,0,0" />
                    <TextBlock Text="Non-Fatal Issues" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
            </Border>

            <!-- Card 4: Critical -->
            <Border Grid.Column="3" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="CRITICAL OUTAGES" FontSize="10" FontWeight="Bold" Foreground="#EF4444" />
                    <TextBlock Text="{Binding Metrics.CriticalCount}" FontSize="24" FontWeight="Bold" Foreground="#EF4444" Margin="0,4,0,0" />
                    <TextBlock Text="Hardware / Service Halt" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
            </Border>

            <!-- Card 5: Fleet Avg Score -->
            <Border Grid.Column="4" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="FLEET BENCHMARK" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock Text="{Binding Metrics.FleetAverageScore, StringFormat={}{0:F1}}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,4,0,0" />
                    <TextBlock Text="Avg Score / 100" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
            </Border>

            <!-- Card 6: Compliance Rate -->
            <Border Grid.Column="5" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
                <StackPanel>
                    <TextBlock Text="FLEET COMPLIANCE" FontSize="10" FontWeight="Bold" Foreground="#8B5CF6" />
                    <TextBlock Text="{Binding Metrics.CompliancePercentage, StringFormat={}{0:F1}%}" FontSize="24" FontWeight="Bold" Foreground="#8B5CF6" Margin="0,4,0,0" />
                    <TextBlock Text="Policy Compliant" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Cloud Sync & Gateway Control Strip -->
        <Border Grid.Row="2" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Top Row: Status & Actions -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconCloudPath}" Width="16" Height="16" Fill="{DynamicResource AccentBrush}" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Enterprise Cloud Telemetry Engine" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding GatewayStatusDisplay}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Sync Live Hardware Telemetry" Command="{Binding IngestLocalMachineTelemetryCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" Padding="16,7" />
                        <Button Content="Refresh Fleet" Command="{Binding RefreshFleetCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Padding="14,7" />
                        <Button Content="Toggle Local Gateway" Command="{Binding ToggleGatewayCommand}" Style="{StaticResource SecondaryButton}" Padding="14,7" />
                    </StackPanel>
                </Grid>

                <!-- Bottom Row: Cloud API Settings -->
                <Grid Grid.Row="1" Background="{DynamicResource NavGroupBgBrush}" Margin="-4,0,-4,0">
                    <Border CornerRadius="8" Padding="12,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Cloud Endpoint -->
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="CLOUD API ENDPOINT URL" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding CloudEndpointUrl, UpdateSourceTrigger=PropertyChanged}" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}" Padding="8,5" FontSize="12" />
                            </StackPanel>

                            <!-- Tenant ID -->
                            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                <TextBlock Text="ORGANIZATION / TENANT ID" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding TenantId, UpdateSourceTrigger=PropertyChanged}" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}" Padding="8,5" FontSize="12" />
                            </StackPanel>

                            <!-- API Key -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="ACCESS TOKEN / BEARER KEY" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}" Padding="8,5" FontSize="12" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- Main Content Area: Split Table + Machine Detail -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <!-- Left: Fleet DataGrid Card -->
            <Border Grid.Column="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,14,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Search & Filter Controls -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Search -->
                        <TextBox Grid.Column="0" Text="{Binding SearchFilter, UpdateSourceTrigger=PropertyChanged}" 
                                 Background="{DynamicResource NavGroupBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" 
                                 BorderBrush="{DynamicResource BorderBrush}" Padding="8,6" FontSize="12" VerticalContentAlignment="Center" />

                        <!-- Status Filter Chips -->
                        <ItemsControl Grid.Column="1" ItemsSource="{Binding StatusFilters}" Margin="12,0,0,0" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding}" Command="{Binding DataContext.SelectStatusCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" Margin="0,0,6,0" Padding="12,4" 
                                            Background="{DynamicResource NavGroupBgBrush}" Foreground="{DynamicResource TextSecondaryBrush}" 
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" FontSize="11" Cursor="Hand" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <!-- Fleet Machines Table -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding FilteredMachines}" SelectedItem="{Binding SelectedMachine}" 
                              AutoGenerateColumns="False" IsReadOnly="True"
                              Background="Transparent" BorderThickness="0" 
                              RowBackground="{DynamicResource CardBgBrush}" AlternatingRowBackground="{DynamicResource NavGroupBgBrush}"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource BorderBrush}" 
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{DynamicResource NavGroupBgBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="FontSize" Value="11" />
                                <Setter Property="Padding" Value="10,8" />
                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="HOSTNAME" Binding="{Binding Hostname}" Width="140" />
                            <DataGridTextColumn Header="DEPARTMENT" Binding="{Binding Department}" Width="100" />
                            <DataGridTextColumn Header="OPERATING SYSTEM" Binding="{Binding OperatingSystem}" Width="120" />
                            <DataGridTextColumn Header="ADAPTER NAME" Binding="{Binding PrimaryAdapter}" Width="*" />
                            <DataGridTextColumn Header="MANUFACTURER" Binding="{Binding ChipsetManufacturer}" Width="110" />
                            <DataGridTextColumn Header="SCORE" Binding="{Binding BenchmarkScore, StringFormat={}{0:F1}}" Width="60" />
                            <DataGridTemplateColumn Header="STATUS" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HealthStatus}" Value="Healthy">
                                                            <Setter Property="Background" Value="#064E3B" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding HealthStatus}" Value="Warning">
                                                            <Setter Property="Background" Value="#78350F" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding HealthStatus}" Value="Critical">
                                                            <Setter Property="Background" Value="#7F1D1D" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding HealthStatus}" FontSize="11" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HealthStatus}" Value="Healthy">
                                                                <Setter Property="Foreground" Value="#10B981" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding HealthStatus}" Value="Warning">
                                                                <Setter Property="Foreground" Value="#F59E0B" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding HealthStatus}" Value="Critical">
                                                                <Setter Property="Foreground" Value="#EF4444" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Right: Machine Detail Inspection Drawer -->
            <Border Grid.Column="1" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="ENDPOINT COMPLIANCE DRAWER" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,12" />

                        <TextBlock Text="{Binding SelectedMachine.Hostname, FallbackValue='Select a machine from the fleet'}" 
                                   FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding SelectedMachine.Department, FallbackValue='Department'}" 
                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,16" />

                        <!-- Detail Fields -->
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="Hardware Identifier" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock Text="{Binding SelectedMachine.HardwareId, FallbackValue='-'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="Installed Driver Version" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock Text="{Binding SelectedMachine.DriverVersion, FallbackValue='-'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        </StackPanel>

                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="Operating System &amp; Build" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock Text="{Binding SelectedMachine.OperatingSystem, FallbackValue='-'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        </StackPanel>

                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="Last Telemetry Sync" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock Text="{Binding SelectedMachine.LastHeartbeatUtc, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss UTC}', FallbackValue='-'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        </StackPanel>

                        <!-- Issue Summary -->
                        <Border Background="{DynamicResource NavGroupBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="FLEET COMPLIANCE STATUS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding SelectedMachine.IssueSummary, FallbackValue='No issues detected on this endpoint.'}" 
                                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
