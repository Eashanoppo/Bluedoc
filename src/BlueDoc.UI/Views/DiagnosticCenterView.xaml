<UserControl x:Class="BlueDoc.UI.Views.DiagnosticCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="900">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24,28,32">
            <!-- Header -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Diagnostic Test Center" Style="{StaticResource PageTitleText}" />
                    <TextBlock Text="Deterministic, 12-stage rule-based diagnostic engine for identifying Bluetooth failures and root causes." Style="{StaticResource PageSubtitleText}" />
                </StackPanel>
                <Button Grid.Column="1" Content="Run Full Diagnosis" Command="{Binding RunFullDiagnosticsCommand}" Style="{StaticResource PrimaryButton}" VerticalAlignment="Top" />
            </Grid>

            <!-- Test Score Metric Cards -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="PASSED TESTS" FontSize="11" FontWeight="SemiBold" Foreground="#4ADE80" />
                        <TextBlock Text="{Binding PassedCount}" FontSize="26" FontWeight="Bold" Foreground="#4ADE80" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="WARNINGS" FontSize="11" FontWeight="SemiBold" Foreground="#FACC15" />
                        <TextBlock Text="{Binding WarningCount}" FontSize="26" FontWeight="Bold" Foreground="#FACC15" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="FAILURES" FontSize="11" FontWeight="SemiBold" Foreground="#F87171" />
                        <TextBlock Text="{Binding FailedCount}" FontSize="26" FontWeight="Bold" Foreground="#F87171" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="6" Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="OVERALL STATUS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Text="{Binding CurrentSession.OverallStatus, FallbackValue='Pending'}" FontSize="20" FontWeight="Bold" Foreground="{Binding CurrentSession.OverallStatus, Converter={StaticResource StatusToBrushConverter}}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Progress Bar Card -->
            <Border Background="#121A28" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,20">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding ProgressPercentage, StringFormat='{}{0}%'}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right" />
                    </Grid>
                    <ProgressBar Height="6" Value="{Binding ProgressPercentage}" Minimum="0" Maximum="100" Background="#1E2838" Foreground="{StaticResource AccentBrush}" BorderThickness="0" />
                </StackPanel>
            </Border>

            <!-- Two-Column Diagnostic Results Layout -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="420" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Column: Test Results List with Individual Execution -->
                <Border Grid.Column="0" Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="DIAGNOSTIC TEST CATALOG (12 TESTS)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,12" />

                        <ListBox ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult}" Background="Transparent" BorderThickness="0" MaxHeight="520" ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1C273C" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TestName}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                                <TextBlock Text="{Binding Category}" FontSize="10" Foreground="{StaticResource AccentBrush}" Margin="0,2,0,0" />
                                                <TextBlock Text="{Binding Summary}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <!-- Status Pill -->
                                            <Border Grid.Column="1" CornerRadius="4" Padding="6,3" Background="{Binding Status, Converter={StaticResource StatusToBrushConverter}}" VerticalAlignment="Center" Margin="8,0,8,0">
                                                <TextBlock Text="{Binding Status, Converter={StaticResource StatusToTextConverter}}" FontSize="10" FontWeight="Bold" Foreground="White" />
                                            </Border>

                                            <!-- Run Individual Test Button -->
                                            <Button Grid.Column="2" Content="▶" Command="{Binding DataContext.RunSingleTestCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButton}" Padding="8,4" VerticalAlignment="Center" ToolTip="Run this test individually" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Text="Click any test above to review detailed evidence or run individual tests with the ▶ button." FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Right Column: Evidence & Action Report -->
                <Border Grid.Column="2" Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="TEST FINDINGS &amp; EVIDENCE" Style="{StaticResource CardHeaderTitle}" Margin="0,0,0,4" />
                        <TextBlock Text="Evidence-based analysis. Distinguishes confirmed facts from possible hypotheses." Style="{StaticResource CardSubtitle}" Margin="0,0,0,16" />

                        <StackPanel Visibility="{Binding SelectedResult, Converter={StaticResource NullToVisibilityConverter}}">
                            <Grid Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="{Binding SelectedResult.TestName}" FontWeight="Bold" FontSize="18" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding SelectedResult.Category, StringFormat='Category: {0}'}" FontSize="11" Foreground="{StaticResource AccentBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                                <Border CornerRadius="4" Padding="8,4" Background="{Binding SelectedResult.Status, Converter={StaticResource StatusToBrushConverter}}" HorizontalAlignment="Right" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding SelectedResult.Status, Converter={StaticResource StatusToTextConverter}}" FontSize="11" FontWeight="Bold" Foreground="White" />
                                </Border>
                            </Grid>

                            <!-- Summary Block -->
                            <Border Background="#1C273C" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="OBSERVED FINDING" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" />
                                    <TextBlock Text="{Binding SelectedResult.Summary}" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Technical Details & Evidence -->
                            <Border Background="#1C273C" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="TECHNICAL DETAILS &amp; EVIDENCE" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8" Margin="0,0,0,4" />
                                    <TextBlock Text="{Binding SelectedResult.TechnicalDetails}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,4" />
                                    <TextBlock Text="{Binding SelectedResult.Evidence, StringFormat='Evidence: {0}'}" FontSize="11" FontFamily="Consolas" Foreground="#94A3B8" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Possible Cause (if any) -->
                            <Border Background="#1C273C" CornerRadius="6" Padding="12" Margin="0,0,0,12" Visibility="{Binding SelectedResult.PossibleCause, Converter={StaticResource NullToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="POSSIBLE CAUSE" FontSize="11" FontWeight="SemiBold" Foreground="#FACC15" Margin="0,0,0,4" />
                                    <TextBlock Text="{Binding SelectedResult.PossibleCause}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Recommended Action & Safe Repair Link -->
                            <Border Background="#1C273C" CornerRadius="6" Padding="12" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="RECOMMENDED ACTION" FontSize="11" FontWeight="SemiBold" Foreground="#4ADE80" Margin="0,0,0,4" />
                                    <TextBlock Text="{Binding SelectedResult.RecommendedAction}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                    <Button Content="Launch Safe Repair Center →" Command="{Binding NavigateToRepairCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,12,0,0" Padding="16,6" Visibility="{Binding SelectedResult.RequiresAdmin, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>
                            </Border>

                            <!-- Evaluation Confidence -->
                            <Grid>
                                <TextBlock Text="Certainty:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding SelectedResult.Confidence}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="60,0,0,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding SelectedResult.ExecutedAt, StringFormat='Evaluated at: {0:HH:mm:ss UTC}'}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
