<UserControl x:Class="BlueDoc.UI.Views.DiagnosticCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:common="clr-namespace:BlueDoc.UI.Common"
             mc:Ignorable="d" 
             d:DesignHeight="780" d:DesignWidth="1050">

    <UserControl.Resources>
        <ResourceDictionary>
            <common:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24,28,32">
            <!-- Header Row -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Bluetooth Diagnostic Center" Style="{DynamicResource PageTitleText}" />
                    <TextBlock Text="Automated 12-point hardware, driver, service, and security evaluation rules." Style="{DynamicResource PageSubtitleText}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <!-- Cancel Button -->
                    <Button Content="Cancel" 
                            Command="{Binding CancelDiagnosticsCommand}" 
                            Style="{DynamicResource DangerButton}" 
                            Margin="0,0,10,0" 
                            Padding="14,6" 
                            Visibility="{Binding CanCancelDiagnostics, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <!-- Run Diagnosis Action -->
                    <Button Content="Run Full Diagnosis" 
                            Command="{Binding RunFullDiagnosticsCommand}" 
                            Style="{DynamicResource PrimaryButton}" 
                            Padding="16,6"
                            IsEnabled="{Binding CanRunDiagnostics}" />
                </StackPanel>
            </Grid>

            <!-- Test Score Metric Cards -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{DynamicResource CardPanel}" Padding="14">
                    <StackPanel>
                        <TextBlock Text="PASSED TESTS" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}" />
                        <TextBlock Text="{Binding PassedCount}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{DynamicResource CardPanel}" Padding="14">
                    <StackPanel>
                        <TextBlock Text="WARNINGS" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}" />
                        <TextBlock Text="{Binding WarningCount}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Style="{DynamicResource CardPanel}" Padding="14">
                    <StackPanel>
                        <TextBlock Text="FAILURES" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}" />
                        <TextBlock Text="{Binding FailedCount}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="6" Style="{DynamicResource CardPanel}" Padding="14">
                    <StackPanel>
                        <TextBlock Text="OVERALL STATUS" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBlock Text="{Binding CurrentSession.OverallStatus, FallbackValue='Ready'}" FontSize="18" FontWeight="Bold" Foreground="{Binding CurrentSession.OverallStatus, Converter={StaticResource StatusToBrushConverter}}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Diagnostic Progress & Live Telemetry Card -->
            <Border Background="{DynamicResource SurfaceCardBrush}" 
                    BorderBrush="{DynamicResource BorderBrush}" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Padding="16,14" 
                    Margin="0,0,0,18">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <!-- Left: Live Action Status & Rule Title -->
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding StatusMessage}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding CurrentTestName}" FontSize="11" Foreground="{DynamicResource AccentHoverBrush}" Margin="0,2,0,0" />
                        </StackPanel>

                        <!-- Right: Progress %, Ratio & Estimated Time -->
                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding TestsProgressDisplay}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,10,0" />
                                <TextBlock Text="{Binding ProgressPercentage, StringFormat='{}{0}%'}" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                            </StackPanel>
                            <TextBlock Text="{Binding EstimatedRemainingDisplay}" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>

                    <ProgressBar Height="6" Value="{Binding ProgressPercentage}" Minimum="0" Maximum="100" />
                </StackPanel>
            </Border>

            <!-- Two-Column Diagnostic Results Layout -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="440" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Column: Test Results List with Individual Execution -->
                <Border Grid.Column="0" Style="{DynamicResource CardPanel}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="DIAGNOSTIC TEST CATALOG (12 TESTS)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,12" />

                        <!-- SKELETON PLACEHOLDER WHILE INITIALIZING CATALOG -->
                        <Control Template="{StaticResource DiagnosticResultListSkeletonTemplate}"
                                 Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <!-- REAL RESULTS LISTBOX -->
                        <ListBox ItemsSource="{Binding Results}" 
                                 SelectedItem="{Binding SelectedResult}" 
                                 Background="Transparent" 
                                 BorderThickness="0" 
                                 MaxHeight="520" 
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter='Inverse'}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource SurfaceElevatedBrush}" 
                                            BorderBrush="{DynamicResource BorderBrush}" 
                                            BorderThickness="1" 
                                            CornerRadius="6" 
                                            Padding="12,10" 
                                            Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TestName}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <TextBlock Text="{Binding Category}" FontSize="10" Foreground="{DynamicResource AccentBrush}" Margin="0,2,0,0" />
                                                <TextBlock Text="{Binding Summary}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <!-- Status Pill -->
                                            <Border Grid.Column="1" CornerRadius="4" Padding="6,3" Background="{Binding Status, Converter={StaticResource StatusToBrushConverter}}" VerticalAlignment="Center" Margin="8,0,8,0">
                                                <TextBlock Text="{Binding Status, Converter={StaticResource StatusToTextConverter}}" FontSize="10" FontWeight="Bold" Foreground="White" />
                                            </Border>

                                            <!-- Run Individual Test Button -->
                                            <Button Grid.Column="2" 
                                                    Content="▶" 
                                                    Command="{Binding DataContext.RunSingleTestCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                    CommandParameter="{Binding}" 
                                                    Style="{DynamicResource SecondaryButton}" 
                                                    Padding="8,4" 
                                                    VerticalAlignment="Center" 
                                                    ToolTip="Run this test individually" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Text="Click any test above to review detailed evidence or run individual tests with the ▶ button." FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Right Column: Selected Test Evidence & Recommended Repair -->
                <Border Grid.Column="2" Style="{DynamicResource CardPanel}" Padding="20">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="TEST EVIDENCE &amp; REMEDIATION" Style="{DynamicResource CardHeaderTitle}" Margin="0,0,0,4" />
                            <TextBlock Text="Detailed findings, problem indicators, and automated remediation steps." Style="{DynamicResource CardSubtitle}" Margin="0,0,0,16" />

                            <!-- Selected Test Header -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding SelectedResult.TestName, FallbackValue='Select a test'}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding SelectedResult.Category, StringFormat='Category: {0}', FallbackValue='Diagnostic Rule'}" FontSize="11" Foreground="{DynamicResource AccentBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                                <Border Grid.Column="1" CornerRadius="4" Padding="10,4" Background="{Binding SelectedResult.Status, Converter={StaticResource StatusToBrushConverter}}" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedResult.Status, Converter={StaticResource StatusToTextConverter}, FallbackValue='Not Tested'}" FontSize="11" FontWeight="Bold" Foreground="White" />
                                </Border>
                            </Grid>

                            <Separator Background="{DynamicResource BorderBrush}" Margin="0,0,0,14" />

                            <!-- Summary -->
                            <TextBlock Text="SUMMARY" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding SelectedResult.Summary, FallbackValue='No summary available.'}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,14" />

                            <!-- Detailed Findings -->
                            <TextBlock Text="DETAILED FINDINGS &amp; EVIDENCE" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4" />
                            <Border Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,14">
                                <TextBlock Text="{Binding SelectedResult.Details, FallbackValue='No findings recorded.'}" FontFamily="Consolas, Courier New" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                            </Border>

                            <!-- Remediation Recommendation -->
                            <TextBlock Text="RECOMMENDED REMEDIATION" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4" />
                            <Border Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="{Binding SelectedResult.Recommendation, FallbackValue='No action required.'}" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                    <Button Content="Launch Safe Repair Center →" Command="{Binding NavigateToRepairCommand}" Style="{DynamicResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,12,0,0" Padding="16,6" Visibility="{Binding SelectedResult.RequiresAdmin, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>
                            </Border>

                            <!-- Rule ID & Severity Metadata -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Rule Identifier" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding SelectedResult.RuleId, FallbackValue='None'}" FontFamily="Consolas, Courier New" FontSize="11" Foreground="{DynamicResource AccentHoverBrush}" />
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Requires Admin" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding SelectedResult.RequiresAdmin, StringFormat='Admin: {0}', FallbackValue='No'}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Execution Timestamp" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding SelectedResult.ExecutionTimestamp, FallbackValue='Not executed'}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
