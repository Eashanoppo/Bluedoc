<UserControl x:Class="BlueDoc.UI.Views.AudioDiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1000">

    <Grid Background="{StaticResource DarkBgBrush}" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Audio Diagnostics, Driver Matrix &amp; Packet Tracer" Style="{StaticResource HeaderTextStyle}" />
                    <TextBlock Text="Deep audio stream inspection, A2DP/HFP profile contention detection, driver regression analysis, and raw HCI packet tracing." 
                               Style="{StaticResource SubHeaderTextStyle}" Margin="0,4,0,0" />
                </StackPanel>

                <!-- Status Badge -->
                <Border Grid.Column="1" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="12,6" VerticalAlignment="Center">
                    <TextBlock Text="🎧 AUDIO &amp; ETW ENGINE" Foreground="#A855F7" FontWeight="SemiBold" FontSize="12" />
                </Border>
            </Grid>
        </Border>

        <!-- Tabbed Interface -->
        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}" Background="Transparent" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                    <Setter Property="FontSize" Value="14" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Padding" Value="16,10" />
                    <Setter Property="BorderThickness" Value="0,0,0,2" />
                    <Setter Property="BorderBrush" Value="Transparent" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="TabBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                        BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" Margin="0,0,8,12">
                                    <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Foreground" Value="#38BDF8" />
                                        <Setter TargetName="TabBorder" Property="BorderBrush" Value="#38BDF8" />
                                        <Setter TargetName="TabBorder" Property="Background" Value="#1E293B" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- TAB 1: Audio Stream & Profile Coexistence -->
            <TabItem Header="🎧 Audio Stream &amp; Profiles">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Coexistence & Contention Alert Card -->
                    <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Bluetooth Audio Profile Health &amp; Telephony Contention" FontWeight="Bold" FontSize="16" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding AudioAnalysis.CoexistenceNotice}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0" LineHeight="19" />
                                </StackPanel>

                                <Button Grid.Column="1" Content="Refresh Audio" Command="{Binding RefreshAudioCommand}" 
                                        Style="{StaticResource PrimaryButtonStyle}" Padding="16,8" VerticalAlignment="Center" />
                            </Grid>

                            <!-- Remediation Callout -->
                            <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="Recommended Audio Setup:" FontWeight="Bold" FontSize="12" Foreground="#38BDF8" />
                                    <TextBlock Text="{Binding AudioAnalysis.Recommendation}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Endpoints List -->
                    <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Connected Bluetooth Audio Endpoints" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12" />

                            <DataGrid Grid.Row="1" ItemsSource="{Binding AudioEndpoints}" AutoGenerateColumns="False" IsReadOnly="True"
                                      Background="Transparent" BorderThickness="0" RowBackground="#0F172A" AlternatingRowBackground="#1E293B"
                                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#334155" Foreground="{StaticResource TextPrimaryBrush}"
                                      CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column">
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#1E293B" />
                                        <Setter Property="Foreground" Value="#94A3B8" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="Padding" Value="12,8" />
                                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                                        <Setter Property="BorderBrush" Value="#334155" />
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Device / Endpoint Name" Binding="{Binding Name}" Width="240" />
                                    <DataGridTextColumn Header="Active Profile" Binding="{Binding ActiveProfile}" Width="200" />
                                    <DataGridTextColumn Header="Stream Direction" Binding="{Binding Direction}" Width="130" />
                                    <DataGridTextColumn Header="Audio Quality" Binding="{Binding QualityRating}" Width="220" />
                                    <DataGridTextColumn Header="Contention / Status" Binding="{Binding ContentionNotice}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 2: Driver Version Matrix & Regressions -->
            <TabItem Header="🔄 Driver Version Matrix">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Driver Comparison Summary Card -->
                    <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Hardware Lifecycle &amp; Known Regressions Catalog" FontWeight="Bold" FontSize="16" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="Compares your installed Bluetooth driver version against confirmed stable OEM revisions and known crash regressions." 
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,4,0,16" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Vendor & Device -->
                                <Border Grid.Column="0" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,12,0">
                                    <StackPanel>
                                        <TextBlock Text="CHIPSET VENDOR" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" />
                                        <TextBlock Text="{Binding DriverComparison.VendorName}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0" />
                                        <TextBlock Text="{Binding DriverComparison.VendorId, StringFormat='VID: {0}'}" FontSize="12" Foreground="#64748B" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>

                                <!-- Installed Version -->
                                <Border Grid.Column="1" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,12,0">
                                    <StackPanel>
                                        <TextBlock Text="INSTALLED VERSION" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" />
                                        <TextBlock Text="{Binding DriverComparison.InstalledVersion}" FontSize="15" FontWeight="Bold" Foreground="#38BDF8" Margin="0,4,0,0" />
                                        <TextBlock Text="{Binding DriverComparison.Status}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{Binding DriverComparison.Status, Converter={StaticResource StatusToBrushConverter}}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>

                                <!-- Recommended Version -->
                                <Border Grid.Column="2" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="RECOMMENDED STABLE" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" />
                                        <TextBlock Text="{Binding DriverComparison.RecommendedVersion}" FontSize="15" FontWeight="Bold" Foreground="#10B981" Margin="0,4,0,0" />
                                        <TextBlock Text="Verified Baseline" FontSize="12" Foreground="#64748B" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Actions -->
                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button Content="Re-Check Driver Status" Command="{Binding CheckDriverVersionCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,12,0" Padding="16,8" />
                                <Button Content="Visit Official Download Portal" Command="{Binding OpenManufacturerPortalCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="16,8" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Analysis & Action Advice -->
                    <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Driver Stability Assessment" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding DriverComparison.ActionRecommendation}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="20" />

                            <!-- Known Regression Warning Callout (if any) -->
                            <Border Background="#450A0A" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,16,0,0"
                                    Visibility="{Binding DriverComparison.HasKnownRegression, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="⚠️ CONFIRMED DRIVER REGRESSION IDENTIFIED" FontWeight="Bold" FontSize="13" Foreground="#FCA5A5" />
                                    <TextBlock Text="{Binding DriverComparison.KnownRegressionDetails}" Foreground="#FEE2E2" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 3: HCI Packet Trace (ETW Wireshark) -->
            <TabItem Header="📡 HCI Packet Tracer">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Control Card -->
                    <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="20" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Windows Bluetooth ETW / HCI Packet Capture" FontWeight="Bold" FontSize="16" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Capture raw Host Controller Interface (HCI) commands, ACL data, and connection events into a Microsoft Event Trace Log (.etl)." 
                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,4,0,8" />
                                <TextBlock Text="{Binding TraceSession.Status}" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="13" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Start HCI Trace" Command="{Binding StartTraceCommand}" Style="{StaticResource PrimaryButtonStyle}" 
                                        IsEnabled="{Binding IsTracingActive, Converter={StaticResource BoolToSuccessConverter}}" Margin="0,0,10,0" Padding="16,8" />
                                <Button Content="Stop &amp; Save Trace" Command="{Binding StopTraceCommand}" Style="{StaticResource DangerButtonStyle}" 
                                        IsEnabled="{Binding IsTracingActive}" Padding="16,8" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Wireshark Analysis Instructions -->
                    <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Wireshark &amp; Packet Analysis Guide" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10" />

                            <TextBox Grid.Row="1" Text="{Binding WiresharkGuide}" IsReadOnly="True" TextWrapping="Wrap"
                                     Background="#0F172A" Foreground="#38BDF8" BorderBrush="#334155" FontFamily="Consolas" FontSize="12" 
                                     Padding="14" VerticalScrollBarVisibility="Auto" AcceptsReturn="True" />
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>

