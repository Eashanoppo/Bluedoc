<UserControl x:Class="BlueDoc.UI.Views.BluetoothMainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="1100">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="36,28,36,36" MaxWidth="880" HorizontalAlignment="Left">

            <!-- ==========================================
                 1. PAGE HEADER (macOS System Settings Style)
                 ========================================== -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Bluetooth" 
                               Style="{DynamicResource PageTitleText}" 
                               FontSize="26" 
                               FontWeight="SemiBold" 
                               Margin="0,0,0,4" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="7" Height="7" CornerRadius="3.5" Background="#2EA043" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}">
                            <Run Text="Now discoverable as &quot;" /><Run Text="{Binding MachineName, Mode=OneWay}" FontWeight="Medium" /><Run Text="&quot;" />
                        </TextBlock>
                    </StackPanel>
                </StackPanel>

                <!-- Header Actions (Refresh) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Refresh" 
                            Command="{Binding RefreshCommand}" 
                            Style="{DynamicResource CompactSecondaryButton}" 
                            Margin="0,0,8,0" />
                    <Button Content="Fix Connection" 
                            Command="{Binding NavigateToDoctorCommand}" 
                            Style="{DynamicResource CompactSecondaryButton}" />
                </StackPanel>
            </Grid>

            <!-- ==========================================
                 2. SECTION A: COMPACT BLUETOOTH STATUS
                 ========================================== -->
            <Border Background="{DynamicResource SurfaceElevatedBrush}" 
                    BorderBrush="{DynamicResource BorderBrush}" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Padding="14,10" 
                    Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconHardwarePath}" Width="13" Height="13" Fill="{DynamicResource TextSecondaryBrush}" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="Controller:" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding AdapterName}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Status:" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Operational • Ready" FontSize="12.5" FontWeight="SemiBold" Foreground="#2EA043" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ==========================================
                 3. SECTION B: AUDIO DEVICES (My Devices)
                 ========================================== -->
            <TextBlock Text="Audio Devices" Style="{DynamicResource GroupedSectionHeader}" />
            <Border Style="{DynamicResource GroupedCardContainer}">
                <StackPanel>
                    <!-- Devices List -->
                    <ItemsControl ItemsSource="{Binding AudioDevices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{DynamicResource GroupedDeviceRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Device Category Icon -->
                                        <Border Grid.Column="0" 
                                                Width="34" Height="34" 
                                                CornerRadius="8" 
                                                Background="{DynamicResource SurfaceElevatedBrush}" 
                                                Margin="0,0,14,0" 
                                                VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconAudioPath}" 
                                                  Width="16" Height="16" 
                                                  Fill="{DynamicResource AccentBrush}" 
                                                  Stretch="Uniform" 
                                                  HorizontalAlignment="Center" 
                                                  VerticalAlignment="Center" />
                                        </Border>

                                        <!-- Device Name & Connection State -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" 
                                                       FontSize="13.5" 
                                                       FontWeight="SemiBold" 
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Text="{Binding StatusDisplay}" 
                                                           FontSize="12" 
                                                           Foreground="{Binding StatusColor}" />
                                                <TextBlock Text=" • " FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                                                <TextBlock Text="{Binding BluetoothAddress}" 
                                                           FontSize="11.5" 
                                                           FontFamily="Consolas" 
                                                           Foreground="{DynamicResource TextMutedBrush}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Row Action Buttons -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Connect Button (when Disconnected) -->
                                            <Button Content="Connect" 
                                                    Command="{Binding DataContext.ConnectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding IsConnected, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter='Inverse'}"
                                                    Style="{DynamicResource CompactSecondaryButton}" 
                                                    Margin="0,0,8,0" />

                                            <!-- Disconnect Button (when Connected) -->
                                            <Button Content="Disconnect" 
                                                    Command="{Binding DataContext.DisconnectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding IsConnected, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    Style="{DynamicResource CompactSecondaryButton}" 
                                                    Margin="0,0,8,0" />

                                            <!-- Manage / Details Button -->
                                            <Button Content="Manage" 
                                                    Command="{Binding DataContext.ManageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{DynamicResource CompactGhostButton}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Empty Audio Devices Placeholder -->
                    <Border Visibility="{Binding HasAudioDevices, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter='Inverse'}" 
                            Padding="20,24" HorizontalAlignment="Center">
                        <TextBlock Text="No paired audio devices found." FontSize="13" Foreground="{DynamicResource TextMutedBrush}" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- ==========================================
                 4. SECTION C: PERIPHERALS (Mice, Keyboards, HID)
                 ========================================== -->
            <TextBlock Text="Peripherals &amp; Input Devices" Style="{DynamicResource GroupedSectionHeader}" />
            <Border Style="{DynamicResource GroupedCardContainer}">
                <StackPanel>
                    <!-- Peripherals List -->
                    <ItemsControl ItemsSource="{Binding Peripherals}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{DynamicResource GroupedDeviceRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Peripheral Category Icon -->
                                        <Border Grid.Column="0" 
                                                Width="34" Height="34" 
                                                CornerRadius="8" 
                                                Background="{DynamicResource SurfaceElevatedBrush}" 
                                                Margin="0,0,14,0" 
                                                VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconHardwarePath}" 
                                                  Width="16" Height="16" 
                                                  Fill="{DynamicResource AccentBrush}" 
                                                  Stretch="Uniform" 
                                                  HorizontalAlignment="Center" 
                                                  VerticalAlignment="Center" />
                                        </Border>

                                        <!-- Peripheral Name & State -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" 
                                                       FontSize="13.5" 
                                                       FontWeight="SemiBold" 
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Text="{Binding StatusDisplay}" 
                                                           FontSize="12" 
                                                           Foreground="{Binding StatusColor}" />
                                                <TextBlock Text=" • " FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                                                <TextBlock Text="{Binding BluetoothAddress}" 
                                                           FontSize="11.5" 
                                                           FontFamily="Consolas" 
                                                           Foreground="{DynamicResource TextMutedBrush}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Actions -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="Connect" 
                                                    Command="{Binding DataContext.ConnectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding IsConnected, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter='Inverse'}"
                                                    Style="{DynamicResource CompactSecondaryButton}" 
                                                    Margin="0,0,8,0" />

                                            <Button Content="Disconnect" 
                                                    Command="{Binding DataContext.DisconnectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding IsConnected, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    Style="{DynamicResource CompactSecondaryButton}" 
                                                    Margin="0,0,8,0" />

                                            <Button Content="Manage" 
                                                    Command="{Binding DataContext.ManageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{DynamicResource CompactGhostButton}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Empty Peripherals Placeholder -->
                    <Border Visibility="{Binding HasPeripherals, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter='Inverse'}" 
                            Padding="20,24" HorizontalAlignment="Center">
                        <TextBlock Text="No paired mice, keyboards, or input devices." FontSize="13" Foreground="{DynamicResource TextMutedBrush}" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- ==========================================
                 5. SECTION D: NEARBY DEVICES (Live Discovery)
                 ========================================== -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Nearby Devices" Style="{DynamicResource GroupedSectionHeader}" Margin="4,0,10,0" />
                    <!-- Scanning Spinner / Status Tag -->
                    <Border Visibility="{Binding IsScanning, Converter={StaticResource BooleanToVisibilityConverter}}" 
                            Background="{DynamicResource AccentSubtleBrush}" 
                            CornerRadius="8" 
                            Padding="6,2" 
                            VerticalAlignment="Center">
                        <TextBlock Text="Scanning..." FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                    </Border>
                </StackPanel>

                <!-- Scan Trigger Button -->
                <Button Grid.Column="1" 
                        Content="{Binding ScanButtonText}" 
                        Command="{Binding ToggleScanCommand}" 
                        Style="{DynamicResource CompactPrimaryButton}" 
                        VerticalAlignment="Center" />
            </Grid>

            <Border Style="{DynamicResource GroupedCardContainer}">
                <StackPanel>
                    <!-- Discovery Status Text -->
                    <Border Padding="16,10" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Background="{DynamicResource SurfaceElevatedBrush}">
                        <TextBlock Text="{Binding ScanStatusText}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Border>

                    <!-- Nearby Devices List -->
                    <ItemsControl ItemsSource="{Binding NearbyDevices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{DynamicResource GroupedDeviceRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Discovered Icon -->
                                        <Border Grid.Column="0" 
                                                Width="34" Height="34" 
                                                CornerRadius="8" 
                                                Background="{DynamicResource SurfaceElevatedBrush}" 
                                                Margin="0,0,14,0" 
                                                VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconScannerPath}" 
                                                  Width="15" Height="15" 
                                                  Fill="{DynamicResource AccentBrush}" 
                                                  Stretch="Uniform" 
                                                  HorizontalAlignment="Center" 
                                                  VerticalAlignment="Center" />
                                        </Border>

                                        <!-- Device Name & RSSI -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" 
                                                       FontSize="13.5" 
                                                       FontWeight="SemiBold" 
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Text="{Binding CategoryName, FallbackValue='Bluetooth Peripheral'}" 
                                                           FontSize="12" 
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <TextBlock Text=" • " FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                                                <TextBlock Text="{Binding SignalStrengthDisplay}" 
                                                           FontSize="12" 
                                                           Foreground="{DynamicResource TextMutedBrush}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Pair Action -->
                                        <Button Grid.Column="2" 
                                                Content="Pair" 
                                                Command="{Binding DataContext.PairCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{DynamicResource CompactPrimaryButton}" 
                                                VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Empty Nearby Placeholder -->
                    <Border Visibility="{Binding HasNearbyDevices, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter='Inverse'}" 
                            Padding="20,24" HorizontalAlignment="Center">
                        <TextBlock Text="Click 'Scan for Devices' to discover nearby headphones, speakers, or accessories." 
                                   FontSize="13" 
                                   Foreground="{DynamicResource TextMutedBrush}" />
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
