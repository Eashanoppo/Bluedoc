<UserControl x:Class="BlueDoc.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:BlueDoc.UI.Views"
             mc:Ignorable="d" 
             d:DesignHeight="880" d:DesignWidth="1100">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="36,28,36,36" MaxWidth="960" HorizontalAlignment="Left">

            <!-- ==========================================
                 1. PAGE HEADER (Minimalist & Single Primary Action)
                 ========================================== -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="System Overview" 
                               Style="{DynamicResource PageTitleText}" 
                               FontSize="26" 
                               FontWeight="SemiBold" 
                               Margin="0,0,0,4" />
                    <TextBlock Text="Live health and status of Bluetooth controller hardware, active peripherals, and diagnostics." 
                               Style="{DynamicResource PageSubtitleText}" 
                               FontSize="13" 
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>

                <!-- Header Actions: Refresh & Single Primary Action -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Refresh" 
                            Command="{Binding RefreshCommand}" 
                            Style="{DynamicResource CompactSecondaryButton}" 
                            Margin="0,0,10,0" />
                    <Button Content="Run Full Diagnosis" 
                            Command="{Binding RunDiagnosisCommand}" 
                            Style="{DynamicResource CompactPrimaryButton}" />
                </StackPanel>
            </Grid>

            <!-- SKELETON LOADING STATE -->
            <Control Template="{StaticResource DashboardStatsSkeletonTemplate}" 
                     Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" 
                     Margin="0,0,0,24" />

            <!-- LIVE DASHBOARD CONTENT -->
            <StackPanel Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter='Inverse'}">

                <!-- ==========================================
                     2. SECTION 1: IS BLUETOOTH WORKING? (Hardware & Stack Status)
                     ========================================== -->
                <TextBlock Text="Bluetooth Controller &amp; Services" Style="{DynamicResource GroupedSectionHeader}" />
                
                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Card 1: Adapter Hardware -->
                    <Border Grid.Column="0" Style="{DynamicResource CardPanel}" Padding="16,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="ADAPTER HARDWARE" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" />
                                <Border Width="8" Height="8" CornerRadius="4" 
                                        Background="{Binding PrimaryAdapter.Status, Converter={StaticResource StatusToBrushConverter}}" 
                                        HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Text="{Binding PrimaryAdapter.FriendlyName, FallbackValue='Detecting adapter...'}" 
                                       FontWeight="SemiBold" FontSize="13.5" 
                                       Foreground="{DynamicResource TextPrimaryBrush}" 
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding PrimaryAdapter.Manufacturer, FallbackValue='Standard Controller'}" 
                                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,10" />
                            <Separator Background="{DynamicResource BorderBrush}" Margin="0,0,0,8" />
                            <Grid>
                                <TextBlock Text="Status" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Text="{Binding PrimaryAdapter.Status}" HorizontalAlignment="Right" FontSize="11.5" FontWeight="SemiBold" 
                                           Foreground="{Binding PrimaryAdapter.Status, Converter={StaticResource StatusToBrushConverter}}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Card 2: Driver Info -->
                    <Border Grid.Column="2" Style="{DynamicResource CardPanel}" Padding="16,14">
                        <StackPanel>
                            <TextBlock Text="DRIVER STACK" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6" />
                            <TextBlock Text="{Binding PrimaryAdapter.Driver.DriverProvider, FallbackValue='Microsoft'}" 
                                       FontWeight="SemiBold" FontSize="13.5" 
                                       Foreground="{DynamicResource TextPrimaryBrush}" 
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding PrimaryAdapter.Driver.DriverVersion, StringFormat='v{0}', FallbackValue='v10.0'}" 
                                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,10" />
                            <Separator Background="{DynamicResource BorderBrush}" Margin="0,0,0,8" />
                            <Grid>
                                <TextBlock Text="Driver Date" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Text="{Binding PrimaryAdapter.Driver.DriverDateString, FallbackValue='Up to date'}" 
                                           HorizontalAlignment="Right" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Card 3: Windows Background Service -->
                    <Border Grid.Column="4" Style="{DynamicResource CardPanel}" Padding="16,14">
                        <StackPanel>
                            <TextBlock Text="WINDOWS SERVICE" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6" />
                            <TextBlock Text="Bluetooth Support (bthserv)" FontWeight="SemiBold" FontSize="13.5" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding ServiceInfo.StartupType, StringFormat='Startup: {0}', FallbackValue='Automatic'}" 
                                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,10" />
                            <Separator Background="{DynamicResource BorderBrush}" Margin="0,0,0,8" />
                            <Grid>
                                <TextBlock Text="Service State" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Text="{Binding ServiceInfo.Status, FallbackValue='Running'}" 
                                           HorizontalAlignment="Right" FontSize="11.5" FontWeight="SemiBold" Foreground="#2EA043" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ==========================================
                     3. SECTION 2: MAC OS SYSTEM SETTINGS DEVICES (AUDIO DEVICES & PERIPHERALS)
                     ========================================== -->
                <!-- Top Section Actions -->
                <Grid Margin="0,4,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="My Devices" 
                                   FontFamily="SF Pro Display, SF Pro Text, Segoe UI Variable, Segoe UI, sans-serif"
                                   FontSize="18" 
                                   FontWeight="SemiBold" 
                                   Foreground="{DynamicResource TextPrimaryBrush}" 
                                   VerticalAlignment="Center" />
                        
                        <Border Background="{DynamicResource AccentSubtleBrush}" 
                                CornerRadius="10" 
                                Padding="8,2" 
                                Margin="10,0,0,0" 
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding ConnectedCount, StringFormat='{}{0} Connected'}" 
                                       FontSize="11" 
                                       FontWeight="SemiBold" 
                                       Foreground="{DynamicResource AccentBrush}" />
                        </Border>
                    </StackPanel>

                    <Button Grid.Column="1" 
                            Content="Device Scanner →" 
                            Command="{Binding NavigateToSectionCommand}" 
                            CommandParameter="Device Scanner" 
                            Style="{DynamicResource CompactGhostButton}" 
                            VerticalAlignment="Center" />
                </Grid>

                <!-- 1. Audio Devices (AirPods, Headphones, Speakers, Earbuds) -->
                <StackPanel Visibility="{Binding HasAudioDevices, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,10">
                    <TextBlock Text="Audio Devices" 
                               FontFamily="SF Pro Display, SF Pro Text, Segoe UI Variable, Segoe UI, sans-serif"
                               FontSize="14" 
                               FontWeight="SemiBold" 
                               Foreground="{DynamicResource TextPrimaryBrush}" 
                               Margin="2,0,0,10" />

                    <ItemsControl ItemsSource="{Binding AudioDevices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <views:DeviceCard />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- 2. Peripherals (Mouse, Keyboard, Trackpad) -->
                <StackPanel Visibility="{Binding HasPeripheralDevices, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,4,0,10">
                    <TextBlock Text="Peripherals" 
                               FontFamily="SF Pro Display, SF Pro Text, Segoe UI Variable, Segoe UI, sans-serif"
                               FontSize="14" 
                               FontWeight="SemiBold" 
                               Foreground="{DynamicResource TextPrimaryBrush}" 
                               Margin="2,4,0,10" />

                    <ItemsControl ItemsSource="{Binding PeripheralDevices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <views:DeviceCard />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- 3. Other Devices (Phones, Sensors, etc. if present) -->
                <StackPanel Visibility="{Binding HasOtherDevices, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,4,0,10">
                    <TextBlock Text="Other Devices" 
                               FontFamily="SF Pro Display, SF Pro Text, Segoe UI Variable, Segoe UI, sans-serif"
                               FontSize="14" 
                               FontWeight="SemiBold" 
                               Foreground="{DynamicResource TextPrimaryBrush}" 
                               Margin="2,4,0,10" />

                    <ItemsControl ItemsSource="{Binding OtherDevices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <views:DeviceCard />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- 4. Empty State when 0 paired devices -->
                <Border Visibility="{Binding TotalPairedCount, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=0}" 
                        Background="{DynamicResource CardBgBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="28,32" 
                        Margin="0,0,0,24"
                        HorizontalAlignment="Stretch">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="No Bluetooth devices currently paired." 
                                   FontFamily="SF Pro Display, SF Pro Text, Segoe UI Variable, Segoe UI, sans-serif"
                                   FontSize="14" 
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" 
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Turn on pairing mode on your headphones, mouse, or keyboard to connect." 
                                   FontSize="12.5" 
                                   Foreground="{DynamicResource TextSecondaryBrush}" 
                                   HorizontalAlignment="Center" 
                                   Margin="0,4,0,16" />
                        <Button Content="Discover Nearby Devices" 
                                Command="{Binding NavigateToSectionCommand}" 
                                CommandParameter="Device Scanner" 
                                Style="{StaticResource MacOsPrimaryButton}" 
                                HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- ==========================================
                     4. SECTION 3: IS ANYTHING WRONG? (Health & Diagnostics)
                     ========================================== -->
                <TextBlock Text="Diagnostics &amp; Connection Reliability" Style="{DynamicResource GroupedSectionHeader}" />
                
                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Diagnostics Session Summary -->
                    <Border Grid.Column="0" Style="{DynamicResource CardPanel}" Padding="18,16">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="SYSTEM DIAGNOSTICS" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                <Button Content="Diagnostic Center →" 
                                        Command="{Binding NavigateToSectionCommand}" 
                                        CommandParameter="Diagnostic Center" 
                                        Style="{DynamicResource CompactGhostButton}" 
                                        HorizontalAlignment="Right" />
                            </Grid>

                            <Border Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Latest Rule Engine Result" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                        <TextBlock Text="{Binding RecentSession.OverallStatus, FallbackValue='Diagnostics Ready'}" 
                                                   FontSize="15" FontWeight="Bold" 
                                                   Foreground="{Binding RecentSession.OverallStatus, Converter={StaticResource StatusToBrushConverter}}" 
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="1" CornerRadius="4" Padding="6,2" Background="{DynamicResource AccentSubtleBrush}" VerticalAlignment="Center">
                                        <TextBlock Text="12 Rules" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                                    </Border>
                                </Grid>
                            </Border>

                            <TextBlock Text="Runs automated verification across driver nodes, RF power, radio registry keys, and background services." 
                                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12" />

                            <Button Content="Run Quick Check" 
                                    Command="{Binding RunDiagnosisCommand}" 
                                    Style="{DynamicResource CompactSecondaryButton}" 
                                    HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>

                    <!-- Right: Connection Failures & Reliability -->
                    <Border Grid.Column="2" Style="{DynamicResource CardPanel}" Padding="18,16">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="CONNECTION RELIABILITY" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                <Button Content="View History →" 
                                        Command="{Binding NavigateToSectionCommand}" 
                                        CommandParameter="Connection History" 
                                        Style="{DynamicResource CompactGhostButton}" 
                                        HorizontalAlignment="Right" />
                            </Grid>

                            <!-- Zero Failures State -->
                            <Border Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14,12" 
                                    Visibility="{Binding RecentFailuresCount, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=0}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="Zero Dropped Links" FontSize="13" FontWeight="SemiBold" Foreground="#2EA043" HorizontalAlignment="Center" />
                                    <TextBlock Text="Windows Bluetooth telemetry shows no recent connection dropouts or handshake failures." 
                                               FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Failures List if any -->
                            <ItemsControl ItemsSource="{Binding RecentFailures}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource DangerSubtleBrush}" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding DeviceName}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Details}" FontSize="11" Foreground="{DynamicResource DangerBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding LocalTimestampDisplay}" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Top" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>

            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
