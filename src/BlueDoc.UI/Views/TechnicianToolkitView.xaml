<UserControl x:Class="BlueDoc.UI.Views.TechnicianToolkitView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1100">

    <Grid Margin="28,24,28,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Technician Toolkit" Style="{StaticResource PageTitleText}" />
                    <TextBlock Text="Performance benchmarking, offline troubleshooting knowledge base, and enterprise SaaS cloud fleet telemetry." 
                               Style="{StaticResource PageSubtitleText}" Margin="0,4,0,0" />
                </StackPanel>

                <!-- Status Tag -->
                <Border Grid.Column="1" Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,6" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🛠️ TECHNICIAN TOOLKIT" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" FontSize="12" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Tabbed Interface -->
        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}" Background="Transparent" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                    <Setter Property="FontSize" Value="13" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Padding" Value="16,10" />
                    <Setter Property="BorderThickness" Value="0,0,0,2" />
                    <Setter Property="BorderBrush" Value="Transparent" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="TabBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                        BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" Margin="0,0,8,12">
                                    <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                        <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                        <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource SurfaceElevatedBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- TAB 1: Performance Benchmark -->
            <TabItem Header="⚡ Performance Benchmark">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Control Card -->
                    <Border Grid.Row="0" Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Bluetooth Latency &amp; Controller Performance Probe" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding BenchmarkStatus}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0" />
                            </StackPanel>

                            <Button Grid.Column="1" Content="Run Benchmark" Command="{Binding RunBenchmarkCommand}" 
                                    Style="{StaticResource PrimaryButton}" Padding="20,8" IsEnabled="{Binding IsBenchmarking, Converter={StaticResource BoolToSuccessConverter}}" />
                        </Grid>
                    </Border>

                    <!-- Overall Score & Rating Banner -->
                    <Grid Grid.Row="1" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Score Card -->
                        <Border Grid.Column="0" Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,16,0">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="BENCHMARK SCORE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding Benchmark.OverallScore, StringFormat={}{0:F1}}" FontSize="44" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                                <TextBlock Text="/ 100" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" />
                                <Border Background="{DynamicResource AccentSubtleBrush}" CornerRadius="4" Padding="8,4" Margin="0,8,0,0" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding Benchmark.Rating}" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" FontSize="12" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Interpretation Card -->
                        <Border Grid.Column="1" Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel>
                                <TextBlock Text="Controller Evaluation &amp; Grading" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding Benchmark.HardwareSpecGrade}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource SuccessBrush}" Margin="0,6,0,0" />
                                <TextBlock Text="{Binding Benchmark.SummaryInterpretation}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="18" />
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <TextBlock Text="Primary Device: " Foreground="{DynamicResource TextMutedBrush}" FontSize="11" />
                                    <TextBlock Text="{Binding Benchmark.PrimaryAdapterName}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="11" Margin="0,0,16,0" />
                                    <TextBlock Text="Vendor: " Foreground="{DynamicResource TextMutedBrush}" FontSize="11" />
                                    <TextBlock Text="{Binding Benchmark.Manufacturer}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="11" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Metrics DataGrid -->
                    <Border Grid.Row="2" Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                        <DataGrid ItemsSource="{Binding Benchmark.Metrics}" AutoGenerateColumns="False" IsReadOnly="True"
                                  Background="Transparent" BorderThickness="0"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource BorderSubtleBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                  CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Benchmark Metric" Binding="{Binding Name}" Width="260" />
                                <DataGridTextColumn Header="Observed Value" Binding="{Binding ValueDisplay}" Width="150" />
                                <DataGridTextColumn Header="Optimal Target" Binding="{Binding TargetThreshold}" Width="150" />
                                <DataGridTextColumn Header="Diagnostic Interpretation" Binding="{Binding Interpretation}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 2: Offline Knowledge Base -->
            <TabItem Header="📚 Offline Knowledge Base">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Search & Category Filters -->
                    <Border Grid.Row="0" Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="320" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Search Input -->
                            <TextBox Grid.Column="0" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource FilterTextBox}" Height="36" VerticalContentAlignment="Center" />

                            <!-- Categories Chips -->
                            <ItemsControl Grid.Column="1" ItemsSource="{Binding Categories}" Margin="16,0,0,0" VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding}" Command="{Binding DataContext.FilterCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" Margin="0,0,8,0" Padding="12,4" Style="{StaticResource SecondaryButton}" FontSize="11" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>

                    <!-- Split Master-Detail View -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="380" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Articles List -->
                        <Border Grid.Column="0" Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,16,0">
                            <ListBox ItemsSource="{Binding FilteredArticles}" SelectedItem="{Binding SelectedArticle}" 
                                     Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                            <StackPanel>
                                                <Grid>
                                                    <TextBlock Text="{Binding Id}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AccentBrush}" />
                                                    <TextBlock Text="{Binding Severity}" HorizontalAlignment="Right" FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{Binding Severity, Converter={StaticResource StatusToBrushConverter}}" />
                                                </Grid>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" 
                                                           TextWrapping="Wrap" Margin="0,4,0,0" />
                                                <TextBlock Text="{Binding Category}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <!-- Right: Article Detail View -->
                        <Border Grid.Column="1" Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="24">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="{Binding SelectedArticle.Id}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                    <TextBlock Text="{Binding SelectedArticle.Title}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,0" />
                                    
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Border Background="{DynamicResource SurfaceElevatedBrush}" CornerRadius="4" Padding="8,4" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding SelectedArticle.Category}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
                                        </Border>
                                        <Border Background="{DynamicResource SurfaceElevatedBrush}" CornerRadius="4" Padding="8,4">
                                            <TextBlock Text="{Binding SelectedArticle.Severity}" Foreground="{Binding SelectedArticle.Severity, Converter={StaticResource StatusToBrushConverter}}" FontWeight="Bold" FontSize="11" />
                                        </Border>
                                    </StackPanel>

                                    <!-- Symptoms -->
                                    <TextBlock Text="Reported Symptoms" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,20,0,8" />
                                    <ItemsControl ItemsSource="{Binding SelectedArticle.Symptoms}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding StringFormat='•  {0}'}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,2,0,2" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Technical Explanation -->
                                    <TextBlock Text="Technical Root Cause" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,18,0,8" />
                                    <TextBlock Text="{Binding SelectedArticle.TechnicalExplanation}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" LineHeight="18" />

                                    <!-- Step-by-Step Remediation -->
                                    <TextBlock Text="Step-by-Step Troubleshooting Guide" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,18,0,8" />
                                    <ItemsControl ItemsSource="{Binding SelectedArticle.StepByStepRemediation}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource SurfaceSunkenBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,6">
                                                    <TextBlock Text="{Binding}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" TextWrapping="Wrap" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Quick Action Button -->
                                    <Button Content="Go to Safe Repair Center" Command="{Binding ExecuteRepairShortcutCommand}"
                                            Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,16,0,0" Padding="16,8" />
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- TAB 3: SaaS Fleet Cloud Sync -->
            <TabItem Header="☁️ SaaS Fleet Operations">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- SaaS Configuration Card -->
                    <Border Grid.Row="0" Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Enterprise SaaS Telemetry Ingestion Settings" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Synchronize endpoint health, driver versions, and diagnostic failure signatures to your central fleet dashboard." 
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,16" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Endpoint URL -->
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="SaaS API Endpoint" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding EndpointUrl, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterTextBox}" Height="36" />
                                </StackPanel>

                                <!-- Tenant ID -->
                                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                    <TextBlock Text="Tenant / Organization ID" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding TenantId, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterTextBox}" Height="36" />
                                </StackPanel>

                                <!-- API Key -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="API Bearer Token" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterTextBox}" Height="36" />
                                </StackPanel>
                            </Grid>

                            <!-- Actions -->
                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button Content="Preview Fleet Payload" Command="{Binding GeneratePayloadPreviewCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,12,0" Padding="16,8" />
                                <Button Content="Sync Telemetry to Fleet" Command="{Binding SyncFleetTelemetryCommand}" Style="{StaticResource PrimaryButton}" Padding="20,8" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Preview & Status Card -->
                    <Border Grid.Row="1" Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Telemetry Payload Preview (JSON Schema v1.0)" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10" />

                            <TextBox Grid.Row="1" Text="{Binding PreviewPayloadJson}" IsReadOnly="True" TextWrapping="Wrap"
                                     Background="{DynamicResource SurfaceSunkenBrush}" Foreground="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" FontFamily="Consolas" FontSize="11" 
                                     Padding="12" VerticalScrollBarVisibility="Auto" AcceptsReturn="True" />

                            <!-- Status / Safety Footer -->
                            <Border Grid.Row="2" Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,12,0,0">
                                <TextBlock Text="{Binding SyncStatus}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" />
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
