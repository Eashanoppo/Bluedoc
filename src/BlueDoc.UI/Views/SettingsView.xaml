<UserControl x:Class="BlueDoc.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="1200" d:DesignWidth="1100">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24,28,32">
            <!-- Header -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Settings &amp; Preferences" Style="{StaticResource PageTitleText}" />
                    <TextBlock Text="Configure appearance, scanning parameters, hardware behavior, performance, and privacy controls." Style="{StaticResource PageSubtitleText}" />
                </StackPanel>
                <Button Grid.Column="1" Content="Save Preferences" Command="{Binding SaveSettingsCommand}" Style="{StaticResource PrimaryButton}" VerticalAlignment="Top" />
            </Grid>

            <!-- 1. APPEARANCE -->
            <Border Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="1. APPEARANCE &amp; VISUAL SYSTEM" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,16" />

                    <!-- Theme Selector -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="200" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Color Theme" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Select between Dark Mode (default deep navy) and Light Mode." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" SelectedValue="{Binding Theme}" SelectedValuePath="Content" Height="36" VerticalContentAlignment="Center">
                            <ComboBoxItem Content="Dark (Default)" />
                            <ComboBoxItem Content="Light" />
                        </ComboBox>
                    </Grid>

                    <!-- Motion / Animations -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Enable Smooth Animations &amp; Transitions" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Controls sidebar transitions, shimmer effects, and UI card reveals. Automatically disabled in safe mode." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" IsChecked="{Binding EnableAnimations}" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 2. GENERAL -->
            <Border Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="2. GENERAL APPLICATION PREFERENCES" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,16" />

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Launch BlueDoc on Windows Startup" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Starts the BlueDoc background transceiver monitor when Windows boots." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" IsChecked="{Binding StartWithWindows}" VerticalAlignment="Center" />
                    </Grid>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Minimize to System Notification Tray" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Closing the main window keeps BlueDoc active in the taskbar notification tray." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" IsChecked="{Binding MinimizeToTray}" VerticalAlignment="Center" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Show Connection &amp; Diagnostic Toast Notifications" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Displays Windows desktop toast alerts when peripherals connect or encounter communication drops." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" IsChecked="{Binding EnableNotificationToasts}" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 3. SCANNING -->
            <Border Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="3. DEVICE DISCOVERY &amp; SCANNING ENGINE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,16" />

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="160" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Default Inquiry Timeout (Seconds)" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Recommended: 10 to 15 seconds for optimal peripheral capture without bus saturation." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <TextBox Grid.Column="1" Text="{Binding ScanTimeout, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterTextBox}" Height="34" VerticalContentAlignment="Center" Padding="8,0" />
                    </Grid>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Enable Continuous Scanning Loop by Default" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Continuously queries the transceiver for newly powered-on devices until manually stopped." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" IsChecked="{Binding ContinuousScanningDefault}" VerticalAlignment="Center" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Automatic Device Deduplication" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Merges Classic inquiry records with BLE advertisement packets sharing the same MAC address." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" IsChecked="{Binding AutoDeduplicateDevices}" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 4. BLUETOOTH BEHAVIOR -->
            <Border Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="4. BLUETOOTH BEHAVIOR &amp; AUDIO PROFILES" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,16" />

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Auto-Reconnect Paired Peripherals" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Attempts verified connection reconnection when a paired audio device or mouse advertises availability." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" IsChecked="{Binding AutoReconnectTrustedDevices}" VerticalAlignment="Center" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Audio Profile Prioritization" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Enforces priority to avoid Hands-Free (HFP) 8kHz voice degradation during media playback." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" SelectedValue="{Binding AudioProfilePrioritization}" SelectedValuePath="Content" Height="36" VerticalContentAlignment="Center">
                            <ComboBoxItem Content="Balanced Automatic" />
                            <ComboBoxItem Content="Prefer A2DP Stereo Music" />
                            <ComboBoxItem Content="Prefer HFP Hands-Free Voice" />
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 5. DIAGNOSTICS -->
            <Border Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="5. DIAGNOSTIC SUITE &amp; AUDIT SETTINGS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,16" />

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="160" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Diagnostic History Retention (Days)" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Number of days to preserve test session results and event traces in local SQLite." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <TextBox Grid.Column="1" Text="{Binding HistoryRetentionDays, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterTextBox}" Height="34" VerticalContentAlignment="Center" Padding="8,0" />
                    </Grid>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Automated Diagnostic Rule Validation" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Executes all 12 non-destructive hardware tests concurrently when opening the Diagnostic Center." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" IsChecked="{Binding AutomatedDiagnosticValidation}" VerticalAlignment="Center" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="200" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Windows Event Telemetry Filtering Level" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Granularity of BTHUSB, bthserv, and driver timeout records retrieved from System Event Log." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" SelectedValue="{Binding EtwLoggingLevel}" SelectedValuePath="Content" Height="36" VerticalContentAlignment="Center">
                            <ComboBoxItem Content="Informational" />
                            <ComboBoxItem Content="Errors &amp; Warnings Only" />
                            <ComboBoxItem Content="Critical Outages Only" />
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 6. PERFORMANCE -->
            <Border Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="6. PERFORMANCE &amp; BACKGROUND PROFILES" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,16" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Low-Resource Diagnostic Mode" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Throttles background poll timers and optimizes memory allocation for dual-core legacy processors." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" IsChecked="{Binding LowResourceMode}" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 7. PRIVACY -->
            <Border Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="7. PRIVACY &amp; LOCAL SQLITE STORAGE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,16" />

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Anonymize Bluetooth MAC Addresses in Exported Reports" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Replaces physical MAC addresses with masked strings (e.g. 28:52:XX:XX:XX:84) in PDF/HTML exports." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" IsChecked="{Binding AnonymizeMacs}" VerticalAlignment="Center" />
                    </Grid>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Database Path:" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding DatabasePath}" FontSize="12" FontFamily="Consolas" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" />
                    </Grid>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Database File Size:" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding DatabaseSize}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </Grid>

                    <Border Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,16">
                        <TextBlock Text="Zero-Cloud Privacy Policy: BlueDoc operates 100% locally on your computer. Your device names, paired encryption keys, and diagnostic traces are stored in your personal SQLite database and never uploaded without explicit consent." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                    </Border>

                    <Button Content="Clear All Local SQLite Records" Command="{Binding ClearDatabaseCommand}" Style="{StaticResource DangerButton}" Height="36" HorizontalAlignment="Left" Padding="16,0" />
                </StackPanel>
            </Border>

            <!-- 8. LEGACY HARDWARE COMPATIBILITY -->
            <Border Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="8. LEGACY HARDWARE COMPATIBILITY (GEN 1 CORE i3 / i5 &amp; WDDM 1.1)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,16" />

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Force Software Rendering Mode (WPF Safe Mode)" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Bypasses DirectX hardware acceleration. Critical for older Intel HD Graphics (Gen 1 Clarkdale / Arrandale) and legacy WDDM 1.1 GPU drivers to prevent crashes." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" IsChecked="{Binding SoftwareRenderingMode}" VerticalAlignment="Center" />
                    </Grid>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Windows 7 Native Stack Fallback (32feet / bthprops)" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Enables graceful fallback to Win32 bthprops.cpl entry points when modern Windows.Devices.Bluetooth APIs are absent." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" IsChecked="{Binding LegacyWin7StackFallback}" VerticalAlignment="Center" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Disable Heavy GPU DropShadows" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Replaces complex pixel shader drop shadows with lightweight border outlines for Tier-0 software rendering performance." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" IsChecked="{Binding DisableGpuDropShadows}" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 9. ABOUT BLUEDOC -->
            <Border Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel>
                    <TextBlock Text="9. ABOUT BLUEDOC" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,14" />
                    <TextBlock Text="{Binding AppName}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding AppVersion}" FontSize="13" Foreground="{DynamicResource AccentBrush}" Margin="0,2,0,8" />
                    
                    <TextBlock Text="Company: UNLEFT LLC" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                    <TextBlock Text="Lead Engineer: Golam Morshed Eashan" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                    <TextBlock Text="Compatible Platforms: Windows 7 SP1, Windows 10, Windows 11 (x86 &amp; x64)" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12" />

                    <Border Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="14">
                        <TextBlock Text="Section 15 Non-Destructive Warranty: BlueDoc is engineered strictly as a non-destructive diagnostic, repair, and peripheral connection manager. It never flashes unauthorized firmware, deletes critical system keys, or reports fabricated telemetry." FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
