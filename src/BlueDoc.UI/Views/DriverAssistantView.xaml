<UserControl x:Class="BlueDoc.UI.Views.DriverAssistantView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="1000" d:DesignWidth="1100">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,24,32,40">
            <!-- Header -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Driver Assistant" Style="{StaticResource PageTitleText}" />
                    <TextBlock Text="Hardware model identification, OEM driver lookup, live package download, and installation assistant." Style="{StaticResource PageSubtitleText}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Content="Check for Updates" Command="{Binding CheckUpdatesCommand}" Style="{DynamicResource MacOsPrimaryButton}" Margin="0,0,8,0" />
                    <Button Content="Backup Driver" Command="{Binding BackupDriverCommand}" Style="{DynamicResource MacOsSecondaryButton}" />
                </StackPanel>
            </Grid>

            <!-- Status Banner -->
            <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,20">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource CardBgHoverBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsOperationInProgress}" Value="True">
                                <Setter Property="Background" Value="#E8F1FD" />
                                <Setter Property="BorderBrush" Value="#0071E3" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="8" Height="8" CornerRadius="4" Margin="0,0,10,0" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOperationInProgress}" Value="True">
                                        <Setter Property="Background" Value="#0071E3" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                    <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" FontSize="12.5" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" Text="{Binding SystemInfo.OperatingSystemName}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- CARD 1: LAPTOP & SYSTEM HARDWARE PROFILE -->
            <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="22,18" Margin="0,0,0,20">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="HOST MACHINE &amp; MOTHERBOARD PROFILE" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding SystemInfo.DisplayName, FallbackValue='Detecting Machine Model...'}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding SystemInfo.FormFactorDescription}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Open OEM Support Portal ↗" Command="{Binding OpenOemSupportCommand}" Style="{DynamicResource MacOsSecondaryButton}" VerticalAlignment="Center" />
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="MANUFACTURER" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding SystemInfo.Manufacturer, FallbackValue='Unknown'}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,3,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="PRODUCT MODEL" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding SystemInfo.Model, FallbackValue='Standard PC'}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,3,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="BASEBOARD / FAMILY" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding SystemInfo.BaseBoardProduct, FallbackValue='MEGABOOK'}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,3,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="3">
                            <TextBlock Text="BIOS VERSION &amp; DATE" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding SystemInfo.BiosVersion, StringFormat='{}{0}'}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,3,0,0" />
                            <TextBlock Text="{Binding SystemInfo.BiosReleaseDate}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- CARD 2: BLUETOOTH CONTROLLER HARDWARE & ACTIVE DRIVER -->
            <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="22,18" Margin="0,0,0,20">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="ACTIVE BLUETOOTH CONTROLLER TRANSCEIVER" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding Adapter.FriendlyName, FallbackValue='Scanning Adapter...'}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Device Manager" Command="{Binding OpenDeviceManagerCommand}" Style="{DynamicResource MacOsSecondaryButton}" Margin="0,0,8,0" />
                            <Button Content="Windows Settings" Command="{Binding OpenSettingsCommand}" Style="{DynamicResource MacOsSecondaryButton}" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1.2*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="INSTALLED VERSION" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding Adapter.Driver.DriverVersion, FallbackValue='Not detected'}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,3,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="DRIVER PROVIDER" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding Adapter.Driver.DriverProvider, FallbackValue='Not detected'}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,3,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="DRIVER DATE" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding Adapter.Driver.DriverDate, FallbackValue='Not detected'}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,3,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="3">
                            <TextBlock Text="HARDWARE IDENTIFIER (PnP)" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding Adapter.HardwareId, FallbackValue='Not detected'}" FontSize="12" FontFamily="SF Pro Text, Consolas, Segoe UI" Foreground="{DynamicResource AccentBrush}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                        </StackPanel>
                    </Grid>

                    <!-- Windows Problem Code Banner -->
                    <Border Background="{DynamicResource CardBgHoverBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14,10">
                        <StackPanel>
                            <TextBlock Text="PNP STACK EVALUATION" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding DriverStatusExplanation}" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- CARD 3: CERTIFIED DRIVER MATCHMAKER & LIVE UPDATE SUITE -->
            <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="22,18" Margin="0,0,0,20">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="CERTIFIED DRIVER PACKAGE MATCHMAKER" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding DriverPackage.PackageName, FallbackValue='Matching package...'}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding DriverPackage.ChipsetFamily}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>

                        <!-- Update Badge -->
                        <Border Grid.Column="1" CornerRadius="12" Padding="12,5" VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource SuccessSubtleBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsUpdateAvailable}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock FontWeight="SemiBold" FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Up to Date" />
                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsUpdateAvailable}" Value="True">
                                                <Setter Property="Text" Value="Update Recommended" />
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </Grid>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="RECOMMENDED VERSION" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding RecommendedVersionDisplay}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,3,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="PACKAGE RELEASE DATE" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding DriverPackage.ReleaseDate, FallbackValue='2024-07-12'}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,3,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="PACKAGE SIZE" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding DriverPackage.FileSizeFormatted, FallbackValue='48.2 MB'}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,3,0,0" />
                        </StackPanel>
                    </Grid>

                    <!-- Release Notes -->
                    <Border Background="{DynamicResource CardBgHoverBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="RELEASE NOTES &amp; OPTIMIZATIONS" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding DriverPackage.ReleaseNotes, FallbackValue='Latest certified Bluetooth driver package.'}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Prominent Download Progress Card (When downloading) -->
                    <Border Margin="0,0,0,16" Padding="16,14" Background="#E8F1FD" BorderBrush="#0071E3" BorderThickness="1.5" CornerRadius="10">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDownloading}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="📥" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Downloading Certified Driver Package..." FontSize="13" FontWeight="Bold" Foreground="#0071E3" VerticalAlignment="Center" />
                                </StackPanel>
                                <Button HorizontalAlignment="Right" Content="Cancel Download" Command="{Binding CancelDownloadCommand}" Style="{DynamicResource MacOsSecondaryButton}" Padding="10,4" FontSize="11" />
                            </Grid>
                            <Grid Grid.Row="1" Margin="0,0,0,6">
                                <TextBlock Text="{Binding DownloadReport.StatusMessage}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock HorizontalAlignment="Right" FontSize="12" FontWeight="Bold" Foreground="#0071E3">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0}% ({1:F1} KB/s)">
                                            <Binding Path="DownloadReport.Percentage" />
                                            <Binding Path="DownloadReport.SpeedKbs" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </Grid>
                            <ProgressBar Grid.Row="2" Height="7" Value="{Binding DownloadReport.Percentage}" Maximum="100" />
                        </Grid>
                    </Border>

                    <!-- Prominent Installation Progress Card (When installing) -->
                    <Border Margin="0,0,0,16" Padding="16,14" Background="#E8F9ED" BorderBrush="#34C759" BorderThickness="1.5" CornerRadius="10">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsInstalling}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="⚙️" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Installing Driver Package into Windows Driver Store..." FontSize="13" FontWeight="Bold" Foreground="#1B8C3D" VerticalAlignment="Center" />
                                </StackPanel>
                                <Border HorizontalAlignment="Right" Background="#34C759" CornerRadius="4" Padding="8,3">
                                    <TextBlock Text="PnPUtil Active" FontSize="10.5" FontWeight="Bold" Foreground="#FFFFFF" />
                                </Border>
                            </Grid>
                            <TextBlock Text="{Binding InstallStatusDetail}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" LineHeight="17" Margin="0,0,0,10" />
                            <ProgressBar Height="7" IsIndeterminate="True" />
                            <TextBlock Text="💡 Note: If a Windows User Account Control (UAC) dialog prompts for Administrator permission, please click 'Yes' to proceed." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0" FontStyle="Italic" />
                        </StackPanel>
                    </Border>

                    <!-- Action Controls -->
                    <WrapPanel>
                        <!-- Download Button -->
                        <Button Content="{Binding DownloadButtonText}" 
                                Command="{Binding DownloadPackageCommand}" 
                                Style="{DynamicResource MacOsPrimaryButton}" 
                                Margin="0,0,10,8" />

                        <!-- Install Button -->
                        <Button Content="{Binding InstallButtonText}" 
                                Command="{Binding InstallPackageCommand}" 
                                IsEnabled="{Binding CanInstallPackage}"
                                Style="{DynamicResource MacOsPrimaryButton}" 
                                Margin="0,0,10,8" />

                        <!-- Search Catalog by Hardware ID -->
                        <Button Content="Search Microsoft Update Catalog (Hardware ID) ↗" 
                                Command="{Binding OpenCatalogSearchCommand}" 
                                Style="{DynamicResource MacOsSecondaryButton}" 
                                Margin="0,0,10,8" />

                        <!-- Cancel Download Button -->
                        <Button Content="Cancel Download" 
                                Command="{Binding CancelDownloadCommand}" 
                                Style="{DynamicResource MacOsSecondaryButton}" 
                                Margin="0,0,10,8"
                                Visibility="{Binding IsDownloading, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- CARD 4: REPAIR, REINSTALLATION & ROLLBACK GUIDES -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Driver Rollback Guide -->
                <Border Grid.Column="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18">
                    <StackPanel>
                        <TextBlock Text="DRIVER ROLLBACK PROCEDURE" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" />
                        <TextBlock Text="{Binding RollbackGuide}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" LineHeight="19" />
                        <Button Content="Open Device Manager to Roll Back" Command="{Binding OpenDeviceManagerCommand}" Style="{DynamicResource MacOsSecondaryButton}" HorizontalAlignment="Left" Margin="0,14,0,0" />
                    </StackPanel>
                </Border>

                <!-- Clean Reinstallation Guide -->
                <Border Grid.Column="2" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18">
                    <StackPanel>
                        <TextBlock Text="CLEAN REINSTALLATION PROCEDURE" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" />
                        <TextBlock Text="{Binding ReinstallGuide}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" LineHeight="19" />
                        <Button Content="Open Manufacturer Support Portal" Command="{Binding OpenSupportPageCommand}" Style="{DynamicResource MacOsSecondaryButton}" HorizontalAlignment="Left" Margin="0,14,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
