<UserControl x:Class="BlueDoc.UI.Views.DriverAssistantView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="900">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24,28,32">
            <!-- Header -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Driver Assistant" Style="{StaticResource PageTitleText}" />
                    <TextBlock Text="Inspect driver status, decode Windows device problem codes, and access verified rollback/reinstallation steps." Style="{StaticResource PageSubtitleText}" />
                </StackPanel>
                <Button Grid.Column="1" Content="Refresh Driver Info" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}" VerticalAlignment="Top" />
            </Grid>

            <!-- Active Driver Status Card -->
            <Border Style="{StaticResource CardPanel}" Margin="0,0,0,20">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="INSTALLED BLUETOOTH ADAPTER DRIVER" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Text="{Binding Adapter.FriendlyName, FallbackValue='Scanning...'}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Open Device Manager" Command="{Binding OpenDeviceManagerCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" />
                            <Button Content="Manufacturer Support" Command="{Binding OpenSupportPageCommand}" Style="{StaticResource SecondaryButton}" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="DRIVER VERSION" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Text="{Binding Adapter.Driver.DriverVersion, FallbackValue='Not detected'}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="PROVIDER" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Text="{Binding Adapter.Driver.DriverProvider, FallbackValue='Not detected'}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="DRIVER DATE" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Text="{Binding Adapter.Driver.DriverDate, FallbackValue='Not detected'}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="3">
                            <TextBlock Text="HARDWARE ID" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Text="{Binding Adapter.HardwareId, FallbackValue='Not detected'}" FontSize="12" FontFamily="Consolas" Foreground="{StaticResource AccentBrush}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>

                    <!-- Windows Problem Code Explanation -->
                    <Border Background="#1C273C" CornerRadius="6" Padding="14">
                        <StackPanel>
                            <TextBlock Text="WINDOWS STATUS CODE EVALUATION" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8" Margin="0,0,0,6" />
                            <TextBlock Text="{Binding DriverStatusExplanation}" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Rollback & Clean Reinstallation Guides -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Driver Rollback Guide -->
                <Border Grid.Column="0" Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="DRIVER ROLLBACK PROCEDURE" FontSize="12" FontWeight="SemiBold" Foreground="#FACC15" Margin="0,0,0,10" />
                        <TextBox Text="{Binding RollbackGuide, Mode=OneWay}" Background="#0F172A" Foreground="#CBD5E1" FontFamily="Segoe UI" FontSize="12" Padding="12" IsReadOnly="True" TextWrapping="Wrap" Height="220" VerticalScrollBarVisibility="Auto" />
                    </StackPanel>
                </Border>

                <!-- Clean Reinstallation Guide -->
                <Border Grid.Column="2" Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="CLEAN REINSTALLATION PROCEDURE" FontSize="12" FontWeight="SemiBold" Foreground="#4ADE80" Margin="0,0,0,10" />
                        <TextBox Text="{Binding ReinstallGuide, Mode=OneWay}" Background="#0F172A" Foreground="#CBD5E1" FontFamily="Segoe UI" FontSize="12" Padding="12" IsReadOnly="True" TextWrapping="Wrap" Height="220" VerticalScrollBarVisibility="Auto" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
