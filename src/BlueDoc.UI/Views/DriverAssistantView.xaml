<UserControl x:Class="BlueDoc.UI.Views.DriverAssistantView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1050">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24,28,32">
            <!-- Header -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Driver Assistant" Style="{StaticResource PageTitleText}" />
                    <TextBlock Text="Inspect driver status, decode Windows device problem codes, and access verified rollback/reinstallation steps." Style="{StaticResource PageSubtitleText}" />
                </StackPanel>
                <Button Grid.Column="1" Content="Refresh Driver Info" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}" VerticalAlignment="Top" />
            </Grid>

            <!-- Active Driver Status Card -->
            <Border Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="INSTALLED BLUETOOTH ADAPTER DRIVER" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock Text="{Binding Adapter.FriendlyName, FallbackValue='Scanning...'}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <Button Content="Open Device Manager" Command="{Binding OpenDeviceManagerCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" />
                            <Button Content="Manufacturer Support" Command="{Binding OpenSupportPageCommand}" Style="{StaticResource SecondaryButton}" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="DRIVER VERSION" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock Text="{Binding Adapter.Driver.DriverVersion, FallbackValue='Not detected'}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="PROVIDER" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock Text="{Binding Adapter.Driver.DriverProvider, FallbackValue='Not detected'}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="DRIVER DATE" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock Text="{Binding Adapter.Driver.DriverDate, FallbackValue='Not detected'}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="3">
                            <TextBlock Text="HARDWARE ID" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock Text="{Binding Adapter.HardwareId, FallbackValue='Not detected'}" FontSize="12" FontFamily="Consolas" Foreground="{DynamicResource AccentBrush}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>

                    <!-- Windows Problem Code Explanation -->
                    <Border Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource AccentSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="14">
                        <StackPanel>
                            <TextBlock Text="WINDOWS STATUS CODE EVALUATION" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,6" />
                            <TextBlock Text="{Binding DriverStatusExplanation}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Official Manufacturer Support Portals Bar -->
            <Border Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18,14" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="OFFICIAL MANUFACTURER DRIVER PORTALS" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,10" />
                    <WrapPanel>
                        <Button Content="Intel Wireless Bluetooth" Command="{Binding OpenIntelPortalCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,10,8" />
                        <Button Content="Realtek Semiconductor" Command="{Binding OpenRealtekPortalCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,10,8" />
                        <Button Content="Broadcom Support" Command="{Binding OpenBroadcomPortalCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,10,8" />
                        <Button Content="Qualcomm Atheros" Command="{Binding OpenQualcommPortalCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,10,8" />
                        <Button Content="Microsoft Bluetooth Support" Command="{Binding OpenMicrosoftPortalCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,10,8" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Rollback & Clean Reinstallation Guides -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Driver Rollback Guide -->
                <Border Grid.Column="0" Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18">
                    <StackPanel>
                        <Border Background="{DynamicResource WarningSubtleBrush}" CornerRadius="4" Padding="8,4" HorizontalAlignment="Left" Margin="0,0,0,12">
                            <TextBlock Text="DRIVER ROLLBACK PROCEDURE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" />
                        </Border>
                        <TextBox Text="{Binding RollbackGuide, Mode=OneWay}" 
                                 Background="{DynamicResource SurfaceSunkenBrush}" 
                                 Foreground="{DynamicResource TextSecondaryBrush}" 
                                 BorderBrush="{DynamicResource BorderSubtleBrush}"
                                 FontFamily="Segoe UI" 
                                 FontSize="12" 
                                 Padding="12" 
                                 IsReadOnly="True" 
                                 TextWrapping="Wrap" 
                                 Height="240" 
                                 VerticalScrollBarVisibility="Auto" />
                    </StackPanel>
                </Border>

                <!-- Clean Reinstallation Guide -->
                <Border Grid.Column="2" Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18">
                    <StackPanel>
                        <Border Background="{DynamicResource SuccessSubtleBrush}" CornerRadius="4" Padding="8,4" HorizontalAlignment="Left" Margin="0,0,0,12">
                            <TextBlock Text="CLEAN REINSTALLATION PROCEDURE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" />
                        </Border>
                        <TextBox Text="{Binding ReinstallGuide, Mode=OneWay}" 
                                 Background="{DynamicResource SurfaceSunkenBrush}" 
                                 Foreground="{DynamicResource TextSecondaryBrush}" 
                                 BorderBrush="{DynamicResource BorderSubtleBrush}"
                                 FontFamily="Segoe UI" 
                                 FontSize="12" 
                                 Padding="12" 
                                 IsReadOnly="True" 
                                 TextWrapping="Wrap" 
                                 Height="240" 
                                 VerticalScrollBarVisibility="Auto" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
