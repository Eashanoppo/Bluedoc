<UserControl x:Class="BlueDoc.UI.Views.PlaceholderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="900">

    <Grid Margin="28,24,28,32">
        <Border Style="{StaticResource CardPanel}" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="600" Padding="32">
            <StackPanel HorizontalAlignment="Center">
                <Border Width="48" Height="48" CornerRadius="24" Background="#1E2A40" HorizontalAlignment="Center" Margin="0,0,0,16">
                    <TextBlock Text="✦" FontSize="20" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,6" />
                <TextBlock Text="{Binding Phase}" FontSize="12" FontWeight="SemiBold" Foreground="#60A5FA" HorizontalAlignment="Center" Margin="0,0,0,14" />
                <TextBlock Text="{Binding Description}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,20" />

                <Border Background="#101726" CornerRadius="6" Padding="14,10">
                    <TextBlock Text="BlueDoc is building modularly according to the phased engineering plan. Proving real hardware detection, driver health, and deterministic diagnostics in Phase 1 &amp; Phase 2." FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" TextAlignment="Center" />
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

