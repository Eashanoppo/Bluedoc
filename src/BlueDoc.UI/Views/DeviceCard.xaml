<UserControl x:Class="BlueDoc.UI.Views.DeviceCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             x:Name="DeviceCardControl"
             mc:Ignorable="d" 
             d:DesignWidth="700" d:DesignHeight="76"
             SnapsToDevicePixels="True">

    <UserControl.RenderTransform>
        <TranslateTransform x:Name="CardOffsetTransform" Y="0" />
    </UserControl.RenderTransform>

    <Border Background="{DynamicResource CardBgBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="16,12"
            Margin="0,0,0,10"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.ColumnDefinitions>
                <!-- Column 0: Icon (42x42, CornerRadius=10, soft accent background) -->
                <ColumnDefinition Width="Auto" />
                <!-- Column 1: Device Info (Name bold, type secondary) -->
                <ColumnDefinition Width="*" />
                <!-- Column 2: Status & Actions -->
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Column 0: macOS Icon Badge -->
            <Border Grid.Column="0"
                    Width="42" Height="42"
                    CornerRadius="10"
                    Background="{DynamicResource AccentSubtleBrush}"
                    Margin="0,0,14,0"
                    VerticalAlignment="Center">
                <Path Data="M 12 2 L 12 22 L 18 16 L 8 8 L 18 8 L 12 2 Z"
                      Width="16" Height="16"
                      Fill="{DynamicResource AccentBrush}"
                      Stretch="Uniform"
                      HorizontalAlignment="Center" 
                      VerticalAlignment="Center" />
            </Border>

            <!-- Column 1: Device Info -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding DeviceName, ElementName=DeviceCardControl, FallbackValue='Bluetooth Device', TargetNullValue='Bluetooth Device'}"
                           FontFamily="SF Pro Display, SF Pro Text, Segoe UI Variable, Segoe UI, sans-serif"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                    <TextBlock Text="{Binding DeviceType, ElementName=DeviceCardControl, FallbackValue='Audio / Peripheral', TargetNullValue='Audio / Peripheral'}"
                               FontFamily="SF Pro Display, SF Pro Text, Segoe UI Variable, Segoe UI, sans-serif"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text=" • " 
                               FontSize="12" 
                               Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBlock Text="{Binding MacAddress, ElementName=DeviceCardControl, FallbackValue='Connected via Adapter'}"
                               FontFamily="SF Pro Display, SF Pro Text, Segoe UI Variable, Segoe UI, sans-serif"
                               FontSize="11.5"
                               Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>

            <!-- Column 2: Status & Action Buttons -->
            <StackPanel Grid.Column="2" 
                        Orientation="Horizontal" 
                        VerticalAlignment="Center">
                
                <!-- Status: 6x6 Ellipse + 12px Text -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Ellipse Width="6" Height="6"
                             VerticalAlignment="Center"
                             Margin="0,0,6,0">
                        <Ellipse.Style>
                            <Style TargetType="{x:Type Ellipse}">
                                <Setter Property="Fill" Value="{DynamicResource TextMutedBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected, ElementName=DeviceCardControl}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    
                    <TextBlock FontSize="12"
                               FontFamily="SF Pro Display, SF Pro Text, Segoe UI Variable, Segoe UI, sans-serif"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Text" Value="Not Connected" />
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected, ElementName=DeviceCardControl}" Value="True">
                                        <Setter Property="Text" Value="Connected" />
                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                        <Setter Property="FontWeight" Value="Medium" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <!-- Action Button 1: Connect / Disconnect -->
                <Button Click="ConnectButton_Click"
                        Margin="0,0,8,0">
                    <Button.Style>
                        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource MacOsPrimaryButton}">
                            <Setter Property="Content" Value="Connect" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConnected, ElementName=DeviceCardControl}" Value="True">
                                    <Setter Property="Content" Value="Disconnect" />
                                    <Setter Property="Background" Value="{DynamicResource CardBorderBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Action Button 2: Manage -->
                <Button Content="Manage"
                        Click="ManageButton_Click"
                        Style="{StaticResource MacOsSecondaryButton}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
