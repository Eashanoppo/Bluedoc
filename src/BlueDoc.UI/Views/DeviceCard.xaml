<UserControl x:Class="BlueDoc.UI.Views.DeviceCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             x:Name="DeviceCardControl"
             mc:Ignorable="d" 
             d:DesignWidth="700" d:DesignHeight="78"
             SnapsToDevicePixels="True">

    <UserControl.RenderTransform>
        <TranslateTransform x:Name="CardOffsetTransform" Y="0" />
    </UserControl.RenderTransform>

    <Border Background="{DynamicResource CardBgBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="16,12"
            Margin="0,0,0,10"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.ColumnDefinitions>
                <!-- Column 0: 44x44 macOS Squircle Icon Badge -->
                <ColumnDefinition Width="Auto" />
                <!-- Column 1: Device Name & Subtitle -->
                <ColumnDefinition Width="*" />
                <!-- Column 2: Stack of 2 Buttons (Connect/Disconnect + Manage) -->
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Column 0: macOS Rounded Square Icon Badge -->
            <Border Grid.Column="0"
                    Width="44" Height="44"
                    CornerRadius="10"
                    Background="{DynamicResource SurfaceSunkenBrush}"
                    Margin="0,0,16,0"
                    VerticalAlignment="Center">
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Headphone / Earbuds Vector Icon -->
                    <Path Width="22" Height="22"
                          Data="M 6 12 C 6 6.5 10.5 2 16 2 C 21.5 2 26 6.5 26 12 L 26 18 C 26 20.2 24.2 22 22 22 L 20 22 C 19 22 18 21 18 20 L 18 14 C 18 13 19 12 20 12 L 24 12 L 24 12 C 24 7.6 20.4 4 16 4 C 11.6 4 8 7.6 8 12 L 8 12 L 12 12 C 13 12 14 13 14 14 L 14 20 C 14 21 13 22 12 22 L 10 22 C 7.8 22 6 20.2 6 18 Z"
                          Fill="{DynamicResource TextSecondaryBrush}"
                          Stretch="Uniform">
                        <Path.Style>
                            <Style TargetType="{x:Type Path}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHeadphone, ElementName=DeviceCardControl}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>

                    <!-- Speaker Vector Icon -->
                    <Path Width="20" Height="20"
                          Data="M 4 9 L 8 9 L 14 4 L 14 20 L 8 15 L 4 15 Z M 17 8 C 18.5 9.5 19.5 11.5 19.5 13 C 19.5 14.5 18.5 16.5 17 18 M 20 5 C 22.5 7.5 24 10.5 24 13 C 24 15.5 22.5 18.5 20 21"
                          Stroke="{DynamicResource TextSecondaryBrush}"
                          StrokeThickness="1.6"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Stretch="Uniform">
                        <Path.Style>
                            <Style TargetType="{x:Type Path}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSpeaker, ElementName=DeviceCardControl}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>

                    <!-- Mouse Vector Icon -->
                    <Path Width="20" Height="22"
                          Data="M 8 7 C 8 3.7 10.7 1 14 1 C 17.3 1 20 3.7 20 7 L 20 17 C 20 20.3 17.3 23 14 23 C 10.7 23 8 20.3 8 17 Z M 14 3.5 L 14 8 M 8 9 L 20 9"
                          Stroke="{DynamicResource TextSecondaryBrush}"
                          StrokeThickness="1.6"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Stretch="Uniform">
                        <Path.Style>
                            <Style TargetType="{x:Type Path}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMouse, ElementName=DeviceCardControl}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>

                    <!-- Keyboard Vector Icon -->
                    <Path Width="22" Height="18"
                          Data="M 3 6 C 3 4.5 4.5 3 6 3 L 22 3 C 23.5 3 25 4.5 25 6 L 25 18 C 25 19.5 23.5 21 22 21 L 6 21 C 4.5 21 3 19.5 3 18 Z M 6 6 L 8 6 M 10 6 L 12 6 M 14 6 L 16 6 M 18 6 L 20 6 M 6 9 L 8 9 M 10 9 L 12 9 M 14 9 L 16 9 M 18 9 L 20 9 M 6 12 L 9 12 M 11 12 L 13 12 M 15 12 L 17 12 M 19 12 L 22 12 M 8 15 L 20 15"
                          Stroke="{DynamicResource TextSecondaryBrush}"
                          StrokeThickness="1.5"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Stretch="Uniform">
                        <Path.Style>
                            <Style TargetType="{x:Type Path}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsKeyboard, ElementName=DeviceCardControl}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>

                    <!-- Generic Bluetooth Vector Icon (Fallback) -->
                    <Path Width="16" Height="18"
                          Data="M 9 2 L 9 22 L 16 16 L 4 7 L 16 7 L 9 2 Z"
                          Stroke="{DynamicResource TextSecondaryBrush}"
                          StrokeThickness="1.6"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Stretch="Uniform">
                        <Path.Style>
                            <Style TargetType="{x:Type Path}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHeadphone, ElementName=DeviceCardControl}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSpeaker, ElementName=DeviceCardControl}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsMouse, ElementName=DeviceCardControl}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsKeyboard, ElementName=DeviceCardControl}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                </Grid>
            </Border>

            <!-- Column 1: Device Name & Subtitle Status -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding DeviceName, ElementName=DeviceCardControl, FallbackValue='Bluetooth Device', TargetNullValue='Bluetooth Device'}"
                           FontFamily="SF Pro Display, SF Pro Text, Segoe UI Variable, Segoe UI, sans-serif"
                           FontSize="13.5"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           TextTrimming="CharacterEllipsis" />
                
                <TextBlock Text="{Binding StatusSubtitle, ElementName=DeviceCardControl, FallbackValue='Not Connected'}"
                           FontFamily="SF Pro Display, SF Pro Text, Segoe UI Variable, Segoe UI, sans-serif"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,3,0,0" />
            </StackPanel>

            <!-- Column 2: Stack of 2 Buttons (Top: Connect/Disconnect, Bottom: Manage) -->
            <StackPanel Grid.Column="2" 
                        Orientation="Vertical" 
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right"
                        Width="104">
                
                <!-- Top Button: Connect (Blue) or Disconnect (Outline) -->
                <Button Click="ConnectButton_Click"
                        Width="104" Height="28">
                    <Button.Style>
                        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource MacOsPrimaryButton}">
                            <Setter Property="Content" Value="Connect" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConnected, ElementName=DeviceCardControl}" Value="True">
                                    <Setter Property="Content" Value="Disconnect" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type Button}">
                                                <Border x:Name="border"
                                                        Background="Transparent"
                                                        BorderBrush="{DynamicResource BorderStrongBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="8"
                                                        Padding="12,4"
                                                        SnapsToDevicePixels="True">
                                                    <ContentPresenter HorizontalAlignment="Center" 
                                                                      VerticalAlignment="Center" 
                                                                      TextElement.Foreground="{DynamicResource TextPrimaryBrush}" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="#F2F2F7" />
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="#E5E5EA" />
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter TargetName="border" Property="Opacity" Value="0.45" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Bottom Button: Manage (Outline) -->
                <Button Content="Manage"
                        Click="ManageButton_Click"
                        Style="{StaticResource MacOsSecondaryButton}"
                        Width="104" Height="28"
                        Margin="0,6,0,0" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
