<UserControl x:Class="BlueDoc.UI.Views.SafeRepairCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="950" d:DesignWidth="1100">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24,28,32">
            <!-- Header -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Safe Repair Center" Style="{StaticResource PageTitleText}" />
                    <TextBlock Text="Guided, non-destructive troubleshooting actions with safety verification and mandatory user consent." Style="{StaticResource PageSubtitleText}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Border Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,6" Margin="0,0,10,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Elevation: " FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock Text="{Binding IsRunningAsAdmin, Converter={StaticResource BoolToSuccessConverter}}" FontSize="12" FontWeight="Bold" Foreground="{Binding IsRunningAsAdmin, Converter={StaticResource StatusToBrushConverter}}" />
                        </StackPanel>
                    </Border>
                    <Button Content="Run As Administrator" Command="{Binding RestartAsAdminCommand}" Style="{StaticResource SecondaryButton}" Visibility="{Binding IsRunningAsAdmin, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter='Inverse'}" />
                </StackPanel>
            </Grid>

            <!-- Repair Actions & Execution Panel -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="380" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Column: Repair Operations -->
                <Border Grid.Column="0" Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel>
                        <TextBlock Text="SELECT REPAIR OPERATION (8 AVAILABLE)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,12" />

                        <ListBox ItemsSource="{Binding AvailableRepairs}" SelectedItem="{Binding SelectedRepair}" Background="Transparent" BorderThickness="0" MaxHeight="540" ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,6" TextWrapping="Wrap" />
                                            <Grid>
                                                <TextBlock Text="{Binding TargetComponent, StringFormat='Target: {0}'}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                                <Border Background="{DynamicResource WarningSubtleBrush}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right" Visibility="{Binding RequiresAdmin, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="Admin Required" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" />
                                                </Border>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

                <!-- Right Column: Safety Briefing & Execution -->
                <Border Grid.Column="2" Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                    <StackPanel>
                        <TextBlock Text="SAFETY ASSESSMENT &amp; PROCEDURE" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,16" />

                        <StackPanel Visibility="{Binding SelectedRepair, Converter={StaticResource NullToVisibilityConverter}}">
                            <TextBlock Text="{Binding SelectedRepair.Title}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,14" />

                            <!-- 5 Structured Assessment Sections -->
                            <!-- Section 1: What is wrong -->
                            <Border Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1,0,0,0" CornerRadius="0,6,6,0" Padding="12,10" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="1. WHAT IS WRONG" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" Margin="0,0,0,2" />
                                    <TextBlock Text="{Binding SelectedRepair.IssueDescription}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Section 2: What the repair will do -->
                            <Border Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1,0,0,0" CornerRadius="0,6,6,0" Padding="12,10" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="2. WHAT THE REPAIR WILL DO" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,2" />
                                    <TextBlock Text="{Binding SelectedRepair.ActionDescription}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Section 3: Required permissions -->
                            <Border Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1,0,0,0" CornerRadius="0,6,6,0" Padding="12,10" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="3. REQUIRED PERMISSIONS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" Margin="0,0,0,2" />
                                    <TextBlock Text="{Binding SelectedRepair.PermissionsRequired}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Section 4: Possible consequences -->
                            <Border Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1,0,0,0" CornerRadius="0,6,6,0" Padding="12,10" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="4. POSSIBLE CONSEQUENCES" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2" />
                                    <TextBlock Text="{Binding SelectedRepair.ConsequencesDescription}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Section 5: How to verify the result -->
                            <Border Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource SuccessBrush}" BorderThickness="1,0,0,0" CornerRadius="0,6,6,0" Padding="12,10" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="5. HOW TO VERIFY THE RESULT" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,0,2" />
                                    <TextBlock Text="{Binding SelectedRepair.VerificationProcedure}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Action Bar -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="Execute Repair Operation" Command="{Binding ExecuteRepairCommand}" Style="{StaticResource PrimaryButton}" Height="38" Padding="24,0" Margin="0,0,12,0" />
                                <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Repair History Audit Trail -->
            <Border Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <TextBlock Text="REPAIR AUDIT TRAIL" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Export CSV" Command="{Binding ExportHistoryCsvCommand}" Style="{StaticResource SecondaryButton}" Padding="10,4" Margin="0,0,8,0" />
                            <Button Content="Clear History" Command="{Binding ClearHistoryCommand}" Style="{StaticResource SecondaryButton}" Padding="10,4" Margin="0,0,8,0" />
                            <Button Content="Refresh History" Command="{Binding RefreshHistoryCommand}" Style="{StaticResource SecondaryButton}" Padding="10,4" />
                        </StackPanel>
                    </Grid>

                    <DataGrid ItemsSource="{Binding RepairHistory}" 
                              AutoGenerateColumns="False" 
                              CanUserAddRows="False" 
                              IsReadOnly="True" 
                              Background="Transparent" 
                              BorderThickness="0" 
                              GridLinesVisibility="Horizontal" 
                              HorizontalGridLinesBrush="{DynamicResource BorderSubtleBrush}" 
                              HeadersVisibility="Column" 
                              MaxHeight="300" 
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Timestamp" Binding="{Binding LocalTimestampDisplay}" Width="150" />
                            <DataGridTextColumn Header="Action" Binding="{Binding ActionTitle}" Width="220" />
                            <DataGridTextColumn Header="Target" Binding="{Binding TargetComponent}" Width="150" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" />
                            <DataGridTextColumn Header="Verification Details" Binding="{Binding VerificationResult}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
