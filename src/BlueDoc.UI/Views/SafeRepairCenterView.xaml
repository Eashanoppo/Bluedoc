<UserControl x:Class="BlueDoc.UI.Views.SafeRepairCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="950">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24,28,32">
            <!-- Header -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Safe Repair Center" Style="{StaticResource PageTitleText}" />
                    <TextBlock Text="Guided, non-destructive troubleshooting actions with safety verification and mandatory user consent." Style="{StaticResource PageSubtitleText}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Border Background="#1C273C" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,6" Margin="0,0,10,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Mode: " FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Text="{Binding IsRunningAsAdmin, Converter={StaticResource BoolToSuccessConverter}}" FontSize="12" FontWeight="Bold" Foreground="{Binding IsRunningAsAdmin, Converter={StaticResource StatusToBrushConverter}}" />
                        </StackPanel>
                    </Border>
                    <Button Content="Run As Administrator" Command="{Binding RestartAsAdminCommand}" Style="{StaticResource SecondaryButton}" Visibility="{Binding IsRunningAsAdmin, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter='Inverse'}" />
                </StackPanel>
            </Grid>

            <!-- Repair Actions & Execution Panel -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="400" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Column: Repair Operations -->
                <Border Grid.Column="0" Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="SELECT REPAIR OPERATION (8 AVAILABLE)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,12" />

                        <ListBox ItemsSource="{Binding AvailableRepairs}" SelectedItem="{Binding SelectedRepair}" Background="Transparent" BorderThickness="0" MaxHeight="520" ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1C273C" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,4" TextWrapping="Wrap" />
                                            <Grid>
                                                <TextBlock Text="{Binding TargetComponent, StringFormat='Target: {0}'}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                                <TextBlock Text="Requires Admin" FontSize="11" FontWeight="SemiBold" Foreground="#F59E0B" HorizontalAlignment="Right" Visibility="{Binding RequiresAdmin, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

                <!-- Right Column: Safety Briefing & Execution -->
                <Border Grid.Column="2" Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="SAFETY ASSESSMENT &amp; PROCEDURE" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,16" />

                        <StackPanel Visibility="{Binding SelectedRepair, Converter={StaticResource NullToVisibilityConverter}}">
                            <TextBlock Text="{Binding SelectedRepair.Title}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10" />

                            <Border Background="#1C273C" CornerRadius="6" Padding="14" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="OPERATION DETAILS" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8" Margin="0,0,0,4" />
                                    <TextBlock Text="{Binding SelectedRepair.Description}" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border Background="#1C273C" CornerRadius="6" Padding="14" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="POSSIBLE CONSEQUENCES" FontSize="11" FontWeight="SemiBold" Foreground="#FACC15" Margin="0,0,0,4" />
                                    <TextBlock Text="{Binding SelectedRepair.Consequences}" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border Background="#0F172A" CornerRadius="6" Padding="14" Margin="0,0,0,20">
                                <StackPanel>
                                    <TextBlock Text="MANDATORY CONFIRMATION RULE" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" />
                                    <TextBlock Text="BlueDoc strictly prohibits silent system modifications. Clicking 'Execute Repair' will request explicit confirmation before modifying any system process, service, or driver state." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Button Content="Execute Repair Operation" Command="{Binding ExecuteRepairCommand}" Style="{StaticResource PrimaryButton}" Height="40" HorizontalAlignment="Left" Padding="24,0" />
                            <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{StaticResource AccentBrush}" Margin="0,10,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Repair History Audit Trail -->
            <Border Style="{StaticResource CardPanel}">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="REPAIR AUDIT TRAIL" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Export CSV" Command="{Binding ExportHistoryCsvCommand}" Style="{StaticResource SecondaryButton}" Padding="10,4" Margin="0,0,8,0" />
                            <Button Content="Clear History" Command="{Binding ClearHistoryCommand}" Style="{StaticResource SecondaryButton}" Padding="10,4" Margin="0,0,8,0" />
                            <Button Content="Refresh History" Command="{Binding RefreshHistoryCommand}" Style="{StaticResource SecondaryButton}" Padding="10,4" />
                        </StackPanel>
                    </Grid>

                    <DataGrid ItemsSource="{Binding RepairHistory}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" Background="Transparent" BorderThickness="0" RowBackground="#162238" AlternatingRowBackground="#1A2842" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource BorderBrush}" HeadersVisibility="Column" MaxHeight="350" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Timestamp" Binding="{Binding LocalTimestampDisplay}" Width="150" />
                            <DataGridTextColumn Header="Action" Binding="{Binding ActionTitle}" Width="220" />
                            <DataGridTextColumn Header="Target" Binding="{Binding TargetComponent}" Width="150" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" />
                            <DataGridTextColumn Header="Verification Details" Binding="{Binding VerificationResult}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
